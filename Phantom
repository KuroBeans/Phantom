// ── Escalate ─────────────────────────────────────────────────────
Escalate = function(comp)
    folder = comp.File("/lib")
    if not folder then
        print(c.yellow + "<b>escalate: /lib not found" + c.ennd)
        return
    end if
    libs = folder.get_files
    if not libs then
        print(c.yellow + "<b>escalate: no libs" + c.ennd)
        return
    end if
    for lib in libs
        ml = metaxploit.load("/lib/" + lib.name)
        if not ml then continue
        mems = metaxploit.scan(ml)
        print(c.cyan + "<b>" + ml.lib_name + c.ennd)
        if not mems then continue
        for mem in mems
            items = metaxploit.scan_address(ml, mem).split("Unsafe check: ")
            if not items then continue
            for item in items
                if item == items[0] then continue
                val = item[item.indexOf("<b>") + 3 : item.indexOf("</b>")]
                result = ml.overflow(mem, val)
                if typeof(result) == "shell" or typeof(result) == "computer" then
                    GETPERMS(result)
                    ans = ""
                    while ans != "y" and ans != "n" and ans != "q"
                        ans = user_input(c.orange + "<b>use this object? (y/n/q): " + c.ennd)
                    end while
                    if ans == "q" then return
                    if ans == "y" then
                        globals.lObject = result
                        print(c.orange + "<b>privileges escalated" + c.ennd)
                        return
                    end if
                end if
            end for
        end for
    end for
    print(c.yellow + "<b>escalate: nothing found" + c.ennd)
end function

