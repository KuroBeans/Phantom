                prev = object
                globals.object = objectStack[idx]
                objectStack[idx] = prev
                globals.remotePath = "/"
                print(c.green + "swapped to stack [" + (idx+1) + "]" + c.ennd)
                GETPERMS(globals.object)
            end if
        else
            // swap with top of stack
            if not object then
                globals.object = objectStack.pop
            else
                prev = object
                globals.object = objectStack.pop
                objectStack.push(prev)
            end if
            globals.remotePath = "/"
            print(c.green + "swapped with top of stack" + c.ennd)
            GETPERMS(globals.object)
        end if
    // ── autoharvest ──────────────────────────────────────────────
    else if cmd == "autoharvest" then
        if inp.len == 3 then
            AutoHarvest(inp[1].to_int, inp[2].to_int)
        else if inp.len == 2 then
            AutoHarvest(inp[1].to_int, 5)
        else
            AutoHarvest(1, 5)
        end if

    // ── proxy ────────────────────────────────────────────────────
    else if cmd == "proxy" then
        if inp.len == 2 then
            Proxy(inp[1].to_int)
        else
            Proxy(1)
        end if
        // autoroot the final hop automatically
        if gco.hasIndex("proxyReady") and gco.proxyReady then
            gco.proxyReady = false
            print(char(10) + c.orange + "Autorooting final hop..." + c.ennd)
            AutoRoot(null, null, null)
        end if

    // ── proxystatus ──────────────────────────────────────────────
    else if cmd == "proxystatus" then
        ProxyStatus

    // ── proxyclear ───────────────────────────────────────────────
    else if cmd == "proxyclear" then
        ProxyClear

    // ── harvest ──────────────────────────────────────────────────
    else if cmd == "harvest" then
        Harvest

    // ── netmap ───────────────────────────────────────────────────
    else if cmd == "netmap" then
        NetMap

    // ── hacklan ──────────────────────────────────────────────────
    else if cmd == "hacklan" then
        if inp.len == 2 then
            HackLan(inp[1])
        else
            print("<b>Usage: hacklan [lan-ip]")
        end if

    // ── wifi ─────────────────────────────────────────────────────
    else if cmd == "wifi" then
        WiFiCrack

    // ── wstack ───────────────────────────────────────────────────
    else if cmd == "wstack" then
        if inp.len == 2 and inp[1] == "-l" then
            WStack(true)
        else
            WStack(false)
        end if

    // ── siphon ───────────────────────────────────────────────────
    else if cmd == "siphon" then
        if inp.len == 2 then
            Siphon(inp[1])
        else
            Siphon(null)
        end if

    // ── weaklib ──────────────────────────────────────────────────
    else if cmd == "upgrade" then
        if inp.len >= 2 and inp[1] == "-u" then
            Upgrade(false)
        else
            Upgrade(true)
        end if

    else if cmd == "updatelib" then
        UpdateLib()

    else if cmd == "weaklib" then
        if inp.len == 2 and inp[1] == "-l" then
            WeakLib(true)
        else
            WeakLib(false)
        end if

    // ── pwnlan ───────────────────────────────────────────────────
    else if cmd == "pwnlan" then
        PwnLan

    // ── lscan ────────────────────────────────────────────────────
    else if cmd == "lscan" then
        LocalScan

    // ── jump ─────────────────────────────────────────────────────
    else if cmd == "jump" then
        if inp.len == 2 and inp[1] == "--rshell" then
            Propagate(true)
        else
            Propagate(false)
        end if

    // ── autoroot ─────────────────────────────────────────────────
    else if cmd == "autoroot" then
        if inp.len == 4 then
            AutoRoot(inp[1], inp[2], inp[3])
        else if inp.len == 1 then
            AutoRoot(null, null, null)
        else
            print("<b>Usage: autoroot  |  autoroot [ip] [user] [pass]")
        end if

    // ── rtgen ─────────────────────────────────────────────────────
    else if cmd == "rtgen" then
        RTGen

    // ── buildrt ──────────────────────────────────────────────────
    else if cmd == "buildrt" then
        gco.rt = null
        buildRainbowTable

    // ── crack ────────────────────────────────────────────────────
    else if cmd == "crack" then
        if inp.len == 2 then
            if not gco.hasIndex("rt") or gco.rt == null then buildRainbowTable
            result = CrackHash(inp[1])
            if result then
                print(c.gold + "<b>cracked: " + result + c.ennd)
            else
                print(c.yellow + "<b>crack: hash not found in table" + c.ennd)
            end if
        else
            print("<b>Usage: crack [hash]")
        end if

    // ── exit / quit ──────────────────────────────────────────────
    else if cmd == "exit" or cmd == "quit" then
        exit

    // ── unknown ──────────────────────────────────────────────────
    else
        print(c.yellow + "<b>phantom: " + cmd + ": command not found" + c.ennd)
    end if

    if storeVar != null and pipeResult != "" then
        pipeVars[storeVar] = pipeResult
        pipeResult = ""
    end if

end while
