        for e in dbMatches
            if inject then
                res = metalib.overflow(e.mem, e.val, inject)
            else
                res = metalib.overflow(e.mem, e.val)
            end if
            if typeof(res) == "shell" or typeof(res) == "computer" or typeof(res) == "file" then
                globals.object = res
                mem = e.mem
                val = e.val
                break
            else
                print(c.grey + "    " + e.mem + " " + e.val + " → " + typeof(res) + c.ennd)
            end if
        end for

        if mem and mem != "" then
            print(c.green + "  db: using " + metalib.lib_name + "  " + mem + "  " + val + c.ennd)
            globals.remotePath = "/"
            if typeof(globals.object) == "shell" or typeof(globals.object) == "computer" then
