// ── PwnLan ───────────────────────────────────────────────────────
PwnLan = function()
    if typeof(object) != "shell" then
        print(c.yellow + "<b>pwnlan: not holding remote shell" + c.ennd)
        return
    end if
    rcomp = object.host_computer

    // get the target's router
    router = get_router(rcomp.public_ip)
    if not router then
        print(c.yellow + "<b>pwnlan: could not reach target router" + c.ennd)
        return
    end if

    devices = router.devices_lan_ip
    if not devices or devices.len == 0 then
        print(c.yellow + "<b>pwnlan: no LAN devices found" + c.ennd)
        return
    end if

    print(c.cyan + "LAN devices found: " + devices.len + c.ennd)
    div

    results = []
    for lanIp in devices
        if lanIp == rcomp.local_ip then
            print(c.grey + "  " + lanIp + "  (current target — skipping)" + c.ennd)
            continue
        end if
        print(c.orange + "  scanning " + lanIp + " ..." + c.ennd)

        // get open ports on this device
        ports = router.device_ports(lanIp)
        if not ports or ports.len == 0 then
            print(c.grey + "    no open ports" + c.ennd)
            continue
        end if

        grabbed = false
        for p in ports
            if grabbed then break
            portNum = p.port_number
            print(c.grey + "    trying port " + portNum + " ..." + c.ennd)

            ns = metaxploit.net_use(lanIp, portNum)
            if not ns then continue

            ml = ns.dump_lib
            if not ml then continue
            if ml.is_patched then continue

            mems = metaxploit.scan(ml)
            if not mems then continue

            for mem in mems
                if grabbed then break
                addrs = metaxploit.scan_address(ml, mem).split("Unsafe check: ")
                for addr in addrs
                    if grabbed then break
                    if addr == addrs[0] then continue
                    val = addr[addr.indexOf("<b>") + 3 : addr.indexOf("</b>")]
                    obj = ml.overflow(mem, val)
                    if typeof(obj) == "shell" then
                        print(c.green + "    [+] shell: " + lanIp + "  " + mem + " " + val + c.ennd)
                        GETPERMS(obj)
                        results.push(lanIp + " " + portNum + " " + mem + " " + val)
                        grabbed = true
                    else if typeof(obj) == "computer" then
                        print(c.green + "    [+] computer: " + lanIp + "  " + mem + " " + val + c.ennd)
                        GETPERMS(obj)
                        results.push(lanIp + " " + portNum + " " + mem + " " + val)
                        grabbed = true
                    end if
                end for
            end for
        end for

        if not grabbed then
            print(c.grey + "    no exploits found on " + lanIp + c.ennd)
        end if
    end for

    div
    print(c.cyan + "pwnlan complete — " + results.len + "/" + devices.len + " devices exploited" + c.ennd)
    if results.len > 0 then
        print(c.gold + "results:" + c.ennd)
        for r in results
            print(c.green + "  " + r + c.ennd)
        end for
    end if
end function

