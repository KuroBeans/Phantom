// ── SCP ──────────────────────────────────────────────────────────
Scp = function(flag, orig, dest)
    if typeof(object) != "shell" then
        print(c.yellow + "<b>scp: need remote shell" + c.ennd)
        return
    end if
    if not orig or orig == "" then
        print(c.yellow + "<b>scp: missing source path" + c.ennd)
        return
    end if
    if not dest or dest == "" then
        print(c.yellow + "<b>scp: missing destination path" + c.ennd)
        return
    end if
    if flag == "-u" then
        result = myShell.scp(orig, dest, object)
        if result then print(c.yellow + "<b>scp: " + result + c.ennd)
    else if flag == "-d" then
        fname = orig.split("/")[-1]
        if dest[-1:] == "/" then dest = dest[:-1]
        result = object.scp(orig, dest, myShell)
        if result then
            print(c.yellow + "<b>scp: " + result + c.ennd)
        else
            print(c.green + "  " + fname + " → " + dest + "/" + fname + c.ennd)
        end if
    else
        print(c.yellow + "<b>scp: unknown flag " + flag + "  (use -u or -d)" + c.ennd)
    end if
end function

