// ── EvalCondition ────────────────────────────────────────────────
// Evaluates a simple condition for macro/pipe if-statements
// Tokens: ["root"], ["not","root"], ["shell"], ["@a"], ["stack"] etc.
EvalCondition = function(tokens)
    if tokens.len == 0 then return false

    // helper: resolve a token to its value (@var lookup or literal)
    resolve = function(t)
        if t == "null" then return ""
        if t.len > 1 and t[0:1] == "@" then
            vn = t[1:]
            if pipeVars.hasIndex(vn) then return pipeVars[vn]
            gcoC = get_custom_object
            if gcoC.hasIndex("clips") and gcoC.clips.hasIndex(vn) then return gcoC.clips[vn]
            return ""
        end if
        return t
    end function

    // check for comparison operators (==, !=, <, >, <=, >=)
    // strip leading 'not'/'no' before comparison
    negCmp = false
    cmpTokens = tokens
    if tokens.len > 0 and (tokens[0] == "not" or tokens[0] == "no") then
        negCmp = true
        cmpTokens = tokens[1:]
    end if
    // detect operator — check multi-char first to avoid partial matches
    opIdx = null
    opStr = null
    ops = ["<=", ">=", "!=", "==", "<", ">"]
    for op in ops
        idx = cmpTokens.indexOf(op)
        if idx != null then
            opIdx = idx
            opStr = op
        end if
        if opIdx != null then break
    end for
    if opIdx != null then
        leftTok  = cmpTokens[:opIdx].join(" ")
        rightTok = cmpTokens[opIdx+1:].join(" ")
        // ── type/state comparisons ────────────────────────────────
        typeResult = null
        if leftTok == "stack" then
            lv = objectStack.len
            rv = rightTok.to_int
            if opStr == "==" then
                typeResult = lv == rv
            else if opStr == "!=" then
                typeResult = lv != rv
            else if opStr == "<" then
                typeResult = lv < rv
            else if opStr == ">" then
                typeResult = lv > rv
            else if opStr == "<=" then
                typeResult = lv <= rv
            else if opStr == ">=" then
                typeResult = lv >= rv
            end if
        else if leftTok == "shell" or leftTok == "object" or leftTok == "computer" then
            objType = typeof(globals.object)
            if rightTok == "root" then
                typeResult = (objType == "shell" or objType == "computer") and IsRoot(globals.object)
            else if rightTok == "guest" then
                typeResult = (objType == "shell" or objType == "computer") and not IsRoot(globals.object)
            else if rightTok == "shell" then
                typeResult = objType == "shell"
            else if rightTok == "computer" then
                typeResult = objType == "computer"
            else if rightTok == "file" then
                typeResult = objType == "file"
            else if rightTok == "null" then
                typeResult = globals.object == null
            end if
            if typeResult != null and opStr == "!=" then
                typeResult = not typeResult
            end if
        end if
        if typeResult != null then
            if negCmp then typeResult = not typeResult
            return typeResult
        end if
        // ── generic value comparison ──────────────────────────────
        leftVal  = resolve(leftTok)
        rightVal = resolve(rightTok)
        result = false
        if opStr == "==" then
            result = leftVal == rightVal
        else if opStr == "!=" then
            result = leftVal != rightVal
        else if opStr == "<" then
            result = leftVal.to_int < rightVal.to_int
        else if opStr == ">" then
            result = leftVal.to_int > rightVal.to_int
        else if opStr == "<=" then
            result = leftVal.to_int <= rightVal.to_int
        else if opStr == ">=" then
            result = leftVal.to_int >= rightVal.to_int
        end if
        if negCmp then result = not result
        return result
    end if

    // plain condition check (with optional leading not/no)
    neg = false
    i = 0
    if tokens[0] == "not" or tokens[0] == "no" then
        neg = true
        i = 1
    end if
    if i >= tokens.len then return neg

    cond = tokens[i]
    result = false

    if cond == "root" then
        result = globals.object != null and typeof(globals.object) == "shell" and IsRoot(globals.object)
    else if cond == "shell" then
        result = typeof(globals.object) == "shell"
    else if cond == "computer" then
        result = typeof(globals.object) == "computer"
    else if cond == "object" then
        result = globals.object != null
    else if cond == "stack" then
        result = objectStack.len > 0
    else if cond == "failed" or cond == "pipefailed" then
        result = pipeFailed
    else if cond == "true" or cond == "__true__" then
        result = true
    else if cond == "false" then
        result = false
    else if cond == "target" or cond == "pt" then
        result = publicTarget != ""
    else if cond == "clip" then
        // 'clip' alone or followed by @var: handled in preprocessing
        // if we get here, just check if it's set as a bare word
        result = false
    else if cond.len > 1 and cond[0:1] == "@" then
        vn = cond[1:]
        gcoC = get_custom_object
        if pipeVars.hasIndex(vn) and pipeVars[vn] != "" then
            result = true
        else if gcoC.hasIndex("clips") and gcoC.clips.hasIndex(vn) and gcoC.clips[vn] != "" then
            result = true
        end if
    else
        print(c.yellow + "<b>if: unknown condition '" + cond + "'" + c.ennd)
        print(c.grey + "  flags: root shell object stack target @var failed" + c.ennd)
        print(c.grey + "  compare: @a == value  |  @a != value  |  @a == @b" + c.ennd)
        return false
    end if

    if neg then return not result
    return result
end function

while true

    // sync gco.clips -> pipeVars so lanenum/ipenum results are always available
    gcoSync = get_custom_object
    if gcoSync.hasIndex("clips") then
        for ck in gcoSync.clips.indexes
            pipeVars[ck] = gcoSync.clips[ck]
        end for
    end if

    // -- foreach iterator -----------------------------------------
    if foreachItems.len > 0 and pipeQueue.len == 0 then
        pipeFailed = false
        item = foreachItems[0]
        foreachItems = foreachItems[1:]
        pipeVars["each"] = item
        globals.pipeVars["each"] = item
        pipeQueue.push(foreachBody)
        print(c.orange + "foreach -> @each = " + item + " (" + (foreachItems.len) + " remaining)" + c.ennd)
    else if foreachItems.len == 0 and foreachBody != "" and pipeQueue.len == 0 then
        print(c.cyan + "<b>foreach complete" + c.ennd)
        foreachBody = ""
    end if

    // -- stackfor iterator -------------------------------------------
    if stackforItems.len > 0 and pipeQueue.len == 0 then
        globals.object = stackforItems[0]
        stackforItems = stackforItems[1:]
        pipeQueue.push(stackforBody)
        if typeof(globals.object) == "shell" then
            print(c.orange + "stackfor -> " + globals.object.host_computer.public_ip + " (" + stackforItems.len + " remaining)" + c.ennd)
        else if typeof(globals.object) == "computer" then
            print(c.orange + "stackfor -> " + globals.object.public_ip + " (" + stackforItems.len + " remaining)" + c.ennd)
        end if
    else if stackforItems.len == 0 and stackforBody != "" and pipeQueue.len == 0 then
        globals.object = stackforSaved
        stackforSaved = null
        stackforBody = ""
        print(c.cyan + "<b>stackfor complete" + c.ennd)
    end if

    // macro completion: fire only when queue fully drained
    if macroName != "" and macroQueue.len == 0 and pipeQueue.len == 0 and foreachBody == "" then
        print(c.cyan + "<b>macro '" + macroName + "' done" + c.ennd)
        macroName = ""
        gcoD = get_custom_object
        macroArgList = []
    end if

    if pipeQueue.len > 0 then
        if pipeFailed then
            print(c.yellow + "  pipeline aborted (" + pipeQueue.len + " cmd(s) skipped)" + c.ennd)
            pipeQueue = []
            // inside a macro: keep pipeFailed so the loop handler can skip to next iteration
            // at the prompt: reset it
            if macroName == "" then pipeFailed = false
            continue
        end if
        tokens = pipeQueue[0].split(" ")
        i = 0
        while i < tokens.len
            if tokens[i].len > 1 and tokens[i][0:1] == "@" then
                tok = tokens[i][1:]
                dotLen = tok.indexOf(".len")
                if dotLen != null and dotLen == tok.len - 4 then
                    vn = tok[0:dotLen]
                    val = ""
                    if pipeVars.hasIndex(vn) then val = pipeVars[vn]
                    if val.indexOf(",") != null then
                        tokens[i] = "" + val.split(",").len
                    else if val == "" then
                        tokens[i] = "0"
                    else
                        tokens[i] = "" + val.len
                    end if
                else if pipeVars.hasIndex(tok) and not (tokens[0] == "clip") then
                    tokens[i] = pipeVars[tok]
                end if
            end if
            i = i + 1
        end while
        inp = tokens
        pipeQueue = pipeQueue[1:]
    else if macroQueue.len > 0 and foreachBody == "" then
        if pipeFailed then
            // check if we're inside a loop — skip to next iteration instead of aborting
            loopIdx = null
            k = 0
            while k < macroQueue.len
                if macroQueue[k].len >= 9 and macroQueue[k][:9] == "__while__" then
                    loopIdx = k
                    k = macroQueue.len
                end if
                k = k + 1
            end while
            if loopIdx != null then
                skipped = loopIdx
                macroQueue = macroQueue[loopIdx:]
                pipeFailed = false
                if skipped > 0 then print(c.grey + "  [" + macroName + "] fail — skipping to next loop iteration (" + skipped + " line(s))" + c.ennd)
            else if macroName == "exec" then
                pipeFailed = false
                print(c.grey + "  [exec] fail — skipping to next (" + macroQueue.len + " remaining)" + c.ennd)
            else
                print(c.yellow + "  [" + macroName + "] pipeline fail — macro aborted (" + macroQueue.len + " line(s) skipped)" + c.ennd)
                macroQueue = []
                macroName = ""
                pipeFailed = false
                macroArgList = []
            end if
            continue
        end if
        line = macroQueue[0]
        macroQueue = macroQueue[1:]

        line = line.split(char(9)).join(" ")
        parts = []
        for p in line.split(" ")
            if p != "" then parts.push(p)
        end for
        if parts.len == 0 or parts[0][0:2] == "//" then continue
        // ── menu handler ─────────────────────────────────────────
        if line.len >= 8 and line[:8] == "__menu__" then
            segs = line.split(char(1))
            menuTitle = segs[1]
            menuItems = []
            if segs.len > 2 and segs[2] != "" then menuItems = segs[2].split(char(2))
            print(char(10))
            if menuTitle != "" then print(c.cyan + "<b>" + menuTitle + c.ennd)
            print(c.grey + "─────────────────────────" + c.ennd)
            for mitem in menuItems
                iparts = mitem.split(char(3))
                if iparts.len >= 1 then print(c.white + "  " + iparts[0] + c.ennd)
            end for
            print(c.grey + "─────────────────────────" + c.ennd)
            mchoice = user_input(c.gold + "Choose: " + c.ennd, false, false)
            mfound = false
            for mitem in menuItems
                iparts = mitem.split(char(3))
                if iparts.len < 2 then continue
                dispToks = iparts[0].split(" ")
                firstTok = ""
                if dispToks.len > 0 then firstTok = dispToks[0]
                if firstTok == mchoice or iparts[0] == mchoice then
                    macroQueue = [iparts[1]] + macroQueue
                    mfound = true
                end if
                if mfound then break
            end for
            if not mfound then
                print(c.yellow + "  invalid choice — try again" + c.ennd)
                macroQueue = [line] + macroQueue
            end if
            continue
        end if

        // ── while/until loop handler ─────────────────────────────
        if line.len >= 9 and line[:9] == "__while__" then
            segs = line.split(char(1))
            condStr = segs[1]
            remaining = segs[2].to_int
            body = []
            if segs.len > 3 and segs[3] != "" then body = segs[3].split(char(2))
            if remaining <= 0 then
                print(c.yellow + "  [" + macroName + "] loop: reached max " + segs[2] + " iterations" + c.ennd)
            else if EvalCondition(condStr.split(" ")) then
                newEntry = "__while__" + char(1) + condStr + char(1) + (remaining - 1) + char(1) + body.join(char(2))
                macroQueue = body + [newEntry] + macroQueue
            else
                print(c.grey + "  [" + macroName + "] loop: condition false — exiting" + c.ennd)
            end if
            continue
        end if
        inp = parts
    else if stageQueue.len > 0 and pipeQueue.len == 0 and foreachItems.len == 0 and foreachBody == "" and macroQueue.len == 0 then
        // stage queue: run next stage regardless of pipeFailed
        pipeFailed = false
        line = stageQueue[0]
        stageQueue = stageQueue[1:]
        parts = []
        for p in line.split(" ")
            if p != "" then parts.push(p)
        end for
        if parts.len == 0 then continue
        print(c.teal + "|> " + line + c.ennd)
        inp = parts
        // handle nested |> within this stage
        si = inp.indexOf("|>")
        if si != null then
            stageQueue = [inp[si+1:].join(" ")] + stageQueue
            inp = inp[:si]
        end if
    else
        print(char(10))
        if publicTarget != "" then print(c.gold  + "public  target: " + publicTarget + c.ennd)
        if localTarget  != "" then print(c.gold  + "local   target: " + localTarget  + c.ennd)
        if bounceTarget != "" then print(c.gold  + "bounce  target: " + bounceTarget + c.ennd)
        if lObject and typeof(lObject) == "shell" then
            myShell = lObject
            myComp  = lObject.host_computer
            print(c.white + "<b>local shell: " + lObject.host_computer.get_name + c.ennd)
        end if
        if lObject and typeof(lObject) == "computer" then
            myComp = lObject
            print(c.white + "<b>local computer: " + lObject.get_name + c.ennd)
        end if
        if object and typeof(object) == "shell" then
            print(c.orange + "<b>remote shell: " + c.yellow + object.host_computer.get_name + "  pub:" + object.host_computer.public_ip + "  lan:" + object.host_computer.local_ip + c.ennd)
            print(c.orange + "remote path: " + c.yellow + remotePath + c.ennd)
        end if
        if object and typeof(object) == "computer" then
            print(c.orange + "<b>remote computer: " + c.yellow + object.get_name + "  pub:" + object.public_ip + "  lan:" + object.local_ip + c.ennd)
        end if
        if object and typeof(object) == "file" then
            print(c.orange + "<b>remote file: " + c.yellow + object.name + c.ennd)
        end if

        inp = user_input(c.cyan + "<b>" + active_user + c.ennd + c.grey + "@" + c.ennd + c.gold + myPath + c.ennd + c.white + " $ </b>" + c.ennd, false, false, true).split(" ")
        pipeFailed = false
    end if

    // ── if conditional preprocessing ──────────────────────────────
    if inp.len >= 3 and inp[0] == "if" then
        // find separator: prefer 'then', fall back to first '|'
        thenIdx = inp.indexOf("then")
        if thenIdx == null then
            thenIdx = inp.indexOf("|")
        end if
        if thenIdx == null or thenIdx < 2 then
            print(c.yellow + "<b>if: syntax: if <cond> then <cmd>  or  if <cond> | <cmd>" + c.ennd)
            print(c.grey + "  e.g.  if @a | scan @a 0" + c.ennd)
            continue
        end if
        condTokens = inp[1:thenIdx]
        cmdTokens  = inp[thenIdx+1:]
        if cmdTokens.len == 0 then
            print(c.yellow + "<b>if: missing command after separator" + c.ennd)
            continue
        end if
        // allow 'clip @a' as condition shorthand for '@a'
        if condTokens.len == 2 and condTokens[0] == "clip" then
            condTokens = [condTokens[1]]
        else if condTokens.len == 3 and condTokens[0] == "not" and condTokens[1] == "clip" then
            condTokens = ["not", condTokens[2]]
        end if
        if EvalCondition(condTokens) then
            inp = cmdTokens
            // fall through to stage/pipe detection and dispatch
        else
            continue  // condition false — skip
        end if
    end if

    // stage detection (|>) must run before pipe detection (|)
    stageIdx = inp.indexOf("|>")
    if stageIdx != null then
        stageQueue.push(inp[stageIdx+1:].join(" "))
        inp = inp[:stageIdx]
    end if

    // pipe detection runs for BOTH user input and queue items
    pipeIdx = inp.indexOf("|")
    if pipeIdx != null then
        pipeQueue.push(inp[pipeIdx+1:].join(" "))
        inp = inp[:pipeIdx]
    end if

    if inp.len == 0 or inp[0] == "" then continue

    // substitute @varname tokens; detect trailing @varname as store target
    storeVar = null
    i = 0
    while i < inp.len
        if inp[i].len > 1 and inp[i][0:1] == "@" then
            tok = inp[i][1:]
            dotLen = tok.indexOf(".len")
            if dotLen != null and dotLen == tok.len - 4 then
                vn = tok[0:dotLen]
                val = ""
                if pipeVars.hasIndex(vn) then val = pipeVars[vn]
                if val.indexOf(",") != null then
                    inp[i] = "" + val.split(",").len
                else if val == "" then
                    inp[i] = "0"
                else
                    inp[i] = "" + val.len
                end if
            else
                vn = tok
                if pipeVars.hasIndex(vn) and not (inp[0] == "clip") then
                    inp[i] = pipeVars[vn]
                else if i == inp.len - 1 and inp[0] != "clip" and inp[0] != "foreach" then
                    storeVar = vn
                    inp = inp[:-1]
                end if
            end if
        end if
        i = i + 1
    end while
    if inp.len == 0 then continue

    cmd = inp[0]

    // ── alias expansion ───────────────────────────────────────────
    if aliases.hasIndex(cmd) then
        expanded = aliases[cmd].split(" ")
        // append any extra args the user typed after the alias
        if inp.len > 1 then expanded = expanded + inp[1:]
        inp = expanded
        cmd = inp[0]
    end if

    // ── help ─────────────────────────────────────────────────────
    if cmd == "help" then
        if inp.len == 1 then ShowHelp(null) else ShowHelp(inp[1])

    // ── tree ─────────────────────────────────────────────────────
    else if cmd == "tree" then
        path = myPath
        if inp.len == 2 then path = inp[1]
        Tree(path, myComp, true, null)

    // ── rtree ────────────────────────────────────────────────────
    else if cmd == "rtree" then
        if not object then
            print(c.yellow + "<b>rtree: not holding remote object" + c.ennd)
        else
            path = remotePath
            if inp.len == 2 then path = inp[1]
            Tree(path, object, false, null)
        end if

    // ── ls ───────────────────────────────────────────────────────
    else if cmd == "ls" then
        Ls(inp, myPath, myComp, true)

    // ── cd ───────────────────────────────────────────────────────
    else if cmd == "cd" then
        if inp.len == 1 then
            globals.myPath = currentPath
        else if inp[1] == ".." then
            f = myComp.File(myPath).parent
            if f then globals.myPath = f.path
        else
            f = GetFile(inp[1], myComp, true)
            if f and f.is_folder then
                globals.myPath = f.path
            else
                print(c.yellow + "<b>cd: not found" + c.ennd)
            end if
        end if

    // ── cat ──────────────────────────────────────────────────────
    else if cmd == "cat" then
        if inp.len == 2 then Cat(inp[1], myComp, true) else print("<b>Usage: cat [file]")

    // ── cp ───────────────────────────────────────────────────────
    else if cmd == "cp" then
        if inp.len == 3 then Cp(inp[1], inp[2], myComp, true) else print("<b>Usage: cp [src] [dst]")

    // ── mv ───────────────────────────────────────────────────────
    else if cmd == "mv" then
