    end if
    showAll  = inp.len > 1 and inp[1].indexOf("a") != null
    showLong = inp.len > 1 and inp[1].indexOf("l") != null
    items = folder.get_folders + folder.get_files
    out = ""
    for item in items
        if showAll or item.name.indexOf(".") != 0 then
