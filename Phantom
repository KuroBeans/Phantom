    while ans != "y" and ans != "n"
        ans = user_input(c.yellow + "Corrupt system.log? (y/n): " + c.ennd)
    end while
    if ans == "n" then return
    test = obj.touch("/home/guest", "system.log")
    if test == false then
        print(c.yellow + "<b>corlog: cannot create temp file" + c.ennd)
