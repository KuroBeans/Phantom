GetFile = function(input, obj, local)
    if typeof(obj) == "shell" then obj = obj.host_computer
    if input == "" then return null
    if input[0] == "/" then return obj.File(input)
    if local then
        if myPath == "/" then return obj.File("/" + input)
        return obj.File(myPath + "/" + input)
    end if
    if remotePath == "/" then return obj.File("/" + input)
    return obj.File(remotePath + "/" + input)
end function

MemDump = function(fileObj)
    if typeof(fileObj) != "file" then return null
    result = []
    queue = fileObj.get_folders + fileObj.get_files
    while queue.len > 0
        f = queue.pull
        if f.is_folder then queue = queue + f.get_folders + f.get_files
        result.push(f)
    end while
    return result
end function

GETPERMS = function(obj)
    if typeof(obj) != "shell" and typeof(obj) != "computer" then
        print(c.yellow + "<b>getperms: not a shell or computer object" + c.ennd)
        return
    end if
    if typeof(obj) == "shell" then rhost = obj.host_computer
    if typeof(obj) == "computer" then rhost = obj
    targets = ["/var/system.log", "/etc/passwd", "/home/guest", "/var", "/etc"]
    writes = ""
    reads = ""
    ok   = c.green + "<b>yes</b>" + c.ennd
    deny = c.red   + "<b>no</b>"  + c.ennd
    for path in targets
        f = rhost.File(path)
        if not f then continue
        w = deny
        r = deny
        if f.has_permission("w") then w = ok
        if f.has_permission("r") then r = ok
        writes = writes + c.white + "<b>" + path + "</b>" + c.ennd + "  w:" + w + char(10)
        reads  = reads  + c.white + "<b>" + path + "</b>" + c.ennd + "  r:" + r + char(10)
    end for
    print(c.yellow + "<b>write permissions" + char(10) + format_columns(writes))
    print(c.yellow + "<b>read permissions"  + char(10) + format_columns(reads))
end function

