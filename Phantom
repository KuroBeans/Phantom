Ssh = function(creds, ip, port, comp)
    parts = creds.split("@")
    if parts.len < 2 then
        print(c.yellow + "<b>ssh: usage: ssh [user@pass] [ip] [opt:port]" + c.ennd)
        return
    end if
    user = parts[0]
    pass = parts[1]
    portInt = 22
    if port then portInt = port.to_int
    if typeof(portInt) != "number" then
        print(c.yellow + "<b>ssh: invalid port" + c.ennd)
        return
    end if
    print("Connecting to " + ip + ":" + portInt + " ...")
    shell = comp.connect_service(ip, portInt, user, pass, "ssh")
    if typeof(shell) == "string" then
        print(c.yellow + shell + c.ennd)
        return
    end if
    if shell then
        globals.object = shell
        globals.remotePath = "/"
        print(c.cyan + "<b>shell obtained: " + ip + c.ennd)
    else
        print(c.yellow + "<b>ssh: connection failed" + c.ennd)
    end if
end function

// ── Decipher ─────────────────────────────────────────────────────
Decipher = function(flag, arg, obj)
    getCracked = function(hash)
        if gco.crypto then return gco.crypto.decipher(hash)
        return crypto.decipher(hash)
    end function
    if flag == "-h" then
        parts = arg.split(":")
        if parts.len < 2 then
            print(c.yellow + "<b>decipher -h: need [user:hash]" + c.ennd)
            return
        end if
        pw = getCracked(parts[1])
        if pw then
            print("<b>password found: " + c.gold + pw + c.ennd)
        else
            print(c.yellow + "<b>decipher: not found" + c.ennd)
        end if
        return
    end if
    if flag == "-f" then
        if typeof(obj) == "shell" then obj = obj.host_computer
        f = GetFile(arg, obj, true)
        if not f then
            print(c.yellow + "<b>decipher: file not found: " + arg + c.ennd)
            return
        end if
        if f.is_binary then
            print(c.yellow + "<b>decipher: binary file" + c.ennd)
            return
        end if
        if not f.has_permission("r") then
            print(c.yellow + "<b>decipher: permission denied" + c.ennd)
            return
        end if
        lines = f.get_content.split(char(10))
        clean = []
        for l in lines
            if l.len > 0 then clean.push(l)
        end for
        if clean.len == 0 then
            print(c.yellow + "<b>decipher: file empty" + c.ennd)
            return
        end if
        if clean.len == 1 then
            parts = clean[0].split(":")
            if parts.len < 2 then return
            pw = getCracked(parts[1])
            if pw then
                print("user: " + c.white + parts[0] + c.ennd + "  pass: " + c.gold + pw + c.ennd)
            else
                print(c.yellow + "<b>not found: " + parts[0] + c.ennd)
            end if
            return
        end if
        print("Multiple users:")
        i = 1
        for line in clean
            print("  [" + i + "] " + line)
            i = i + 1
        end for
        sel = ""
        ok = false
        while not ok
            sel = user_input("Select user: ").to_int
            if typeof(sel) == "number" and sel >= 1 and sel <= clean.len then ok = true
        end while
        parts = clean[sel - 1].split(":")
        print("Deciphering " + parts[0] + " ...")
        pw = getCracked(parts[1])
        if pw then
            print("user: " + c.white + parts[0] + c.ennd + "  pass: " + c.gold + pw + c.ennd)
        else
            print(c.yellow + "<b>not found" + c.ennd)
        end if
        return
    end if
    print(c.yellow + "<b>Usage: decipher [-h user:hash] [-f /path/file]" + c.ennd)
end function

