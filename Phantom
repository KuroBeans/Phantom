                GETPERMS(globals.object)
            else if typeof(globals.object) == "file" then
                print(c.cyan + "<b>file obtained: " + globals.object.name + c.ennd)
            end if
            return
        end if

        if not mem or mem == "" then
            print(c.yellow + "<b>grab: no working db entry for " + metalib.lib_name + " " + metalib.version + c.ennd)
            print(c.grey + "  run scan first to populate exploits, or pass mem/val: grab " + ip + " " + port + " [mem] [val]" + c.ennd)
