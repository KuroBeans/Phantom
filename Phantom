                if line == "" then continue
                line = line.replace(char(13), "")
                p1 = line.indexOf("|")
                if p1 == null then continue
                p2 = line.indexOf("|", p1 + 1)
                if p2 == null then continue
                p3 = line.indexOf("|", p2 + 1)
                if p3 == null then continue
                if line[:p1] == metalib.lib_name and line[p1+1:p2] == metalib.version then
                    print(char(10) + c.green + "  edb tip: " + c.ennd + c.grey + "grab " + ip + " " + port + " " + line[p2+1:p3] + " " + line[p3+1:] + c.ennd)
