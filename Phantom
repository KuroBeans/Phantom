// ── Tree ─────────────────────────────────────────────────────────
Tree = function(path, obj, local, prefix)
    if typeof(obj) == "shell" then obj = obj.host_computer
    if prefix == null then
        f = GetFile(path, obj, local)
        if not f then
            print(c.yellow + "<b>tree: not found: " + path + c.ennd)
            return
        end if
        print(c.cyan + "<b>" + f.path + c.ennd)
        prefix = ""
    end if
    f = GetFile(path, obj, local)
    if not f then return
    items = f.get_folders + f.get_files
    i = 0
    for item in items
        isLast = (i == items.len - 1)
        connector = "├── "
        nextPrefix = prefix + "│   "
        if isLast then
            connector = "└── "
            nextPrefix = prefix + "    "
        end if
        if item.is_folder then
            print(c.grey + prefix + connector + c.ennd + c.gold + "<b>" + item.name + "/" + c.ennd)
            Tree(item.path, obj, local, nextPrefix)
        else
            col = c.white
            if item.is_binary then col = c.cyan
            print(c.grey + prefix + connector + c.ennd + col + item.name + c.ennd)
        end if
        i = i + 1
    end for
end function
Ls = function(inp, path, obj, local)
    if typeof(obj) == "shell" then obj = obj.host_computer
    folderPath = path
    if inp.len > 1 and inp[inp.len - 1].indexOf("-") == null then
        folderPath = inp[inp.len - 1]
    end if
    folder = GetFile(folderPath, obj, local)
    if not folder then
        print(c.yellow + "<b>ls: not found" + c.ennd)
