            gcoH = get_custom_object
            if not gcoH.hasIndex("harvestResults") or gcoH.harvestResults.len == 0 then
                print(c.yellow + "<b>harvestgrep: no harvest results — run stackrun harvest first" + c.ennd)
                globals.pipeFailed = true
            else
                pattern2 = inp[1]
                matches2 = []
                for r in gcoH.harvestResults
                    if r.indexOf(pattern2) != null then
                        print(c.lime + "  " + r + c.ennd)
                        matches2.push(r)
                    end if
                end for
                if matches2.len == 0 then
                    print(c.yellow + "<b>harvestgrep: no matches for '" + pattern2 + "'" + c.ennd)
                    globals.pipeFailed = true
                else
                    print(c.cyan + "harvestgrep: " + matches2.len + " match(es)" + c.ennd)
                    joined2 = matches2.join(",")
                    pipeResult = joined2
                    globals.pipeResult = joined2
                    if inp.len >= 3 then
                        k2 = inp[2]
                        if k2[0:1] == "@" then k2 = k2[1:]
                        gco = get_custom_object
                        if not gco.hasIndex("clips") then gco.clips = {}
                        gco.clips[k2] = joined2
                        pipeVars[k2] = joined2
                        print(c.lime + "  @" + k2 + " = " + joined2 + c.ennd)
                    end if
                end if
            end if
        end if

    // ── stacklog ──────────────────────────────────────────────────
    else if cmd == "stacklog" then
        if inp.len < 2 then
            print("<b>Usage: stacklog <filepath>")
            print(c.grey + "  e.g.  stacklog /root/ai/harvest_log.txt" + c.ennd)
        else if objectStack.len == 0 then
            print(c.yellow + "<b>stacklog: stack is empty" + c.ennd)
        else
            logPath = inp[1]
            parts2 = logPath.split("/")
            fileName = parts2[-1]
            folder = logPath[:logPath.len - fileName.len - 1]
            if folder == "" then folder = "/"
            logFile = myComp.File(logPath)
            if not logFile then
                myComp.touch(folder, fileName)
                logFile = myComp.File(logPath)
            end if
            if not logFile then
                print(c.yellow + "<b>stacklog: could not create " + logPath + c.ennd)
            else
                existing = logFile.get_content
                if not existing or existing == null then existing = ""
                logLines = ""
                totalCreds = 0
                i = 1
                for obj in objectStack
                    comp2 = null
                    if typeof(obj) == "shell" then
                        comp2 = obj.host_computer
                        rootStr = "guest"
                        if IsRoot(obj) then rootStr = "root"
                        logLines = logLines + "[" + i + "] " + rootStr + " shell  pub:" + comp2.public_ip + "  lan:" + comp2.local_ip + char(10)
                    else if typeof(obj) == "computer" then
                        comp2 = obj
                        rootStr = "guest"
                        if IsRoot(obj) then rootStr = "root"
                        logLines = logLines + "[" + i + "] " + rootStr + " computer  pub:" + obj.public_ip + "  lan:" + obj.local_ip + char(10)
                    end if
                    // harvest credentials from this object
                    if comp2 != null then
                        homeDir2 = comp2.File("/home")
                        if homeDir2 then
                            for user2 in homeDir2.get_folders
                                for target2 in ["Mail.txt", "Bank.txt"]
                                    hf2 = comp2.File("/home/" + user2.name + "/Config/" + target2)
                                    if not hf2 then continue
                                    if not hf2.has_permission("r") then continue
                                    content2 = hf2.get_content
                                    if not content2 or content2 == "" then continue
                                    logLines = logLines + "  " + user2.name + "/" + target2 + char(10)
                                    for hline2 in content2.split(char(10))
                                        if hline2 == "" then continue
                                        hparts2 = hline2.split(":")
                                        if hparts2.len < 2 then continue
                                        pw2 = CrackHash(hparts2[1])
                                        if pw2 then
                                            logLines = logLines + "    " + hparts2[0] + " : " + pw2 + char(10)
                                            totalCreds = totalCreds + 1
                                            print(c.lime + "  " + hparts2[0] + c.ennd + c.grey + " : " + c.gold + "<b>" + pw2 + c.ennd)
                                        end if
                                    end for
                                end for
                            end for
                        end if
                    end if
                    logLines = logLines + char(10)
                    i = i + 1
                end for
                logFile.set_content(existing + logLines)
                print(c.lime + "  logged " + objectStack.len + " object(s) + " + totalCreds + " credential(s) to " + logPath + c.ennd)
            end if
        end if

    // ── log ──────────────────────────────────────────────────────
    else if cmd == "log" then
        if inp.len < 3 then
            print("<b>Usage: log <filepath> <message...>")
            print(c.grey + "  e.g.  log /root/ai/creds.txt @a:@port" + c.ennd)
        else
            logPath = inp[1]
            msg = inp[2:].join(" ")
            // split path into folder and filename
            parts2 = logPath.split("/")
            fileName = parts2[-1]
            folder = logPath[:logPath.len - fileName.len - 1]
            if folder == "" then folder = "/"
            // get or create file
            logFile = myComp.File(logPath)
            if not logFile then
                myComp.touch(folder, fileName)
                logFile = myComp.File(logPath)
            end if
            if not logFile then
                print(c.yellow + "<b>log: could not create " + logPath + c.ennd)
                globals.pipeFailed = true
            else
                existing = logFile.get_content
                if not existing or existing == null then existing = ""
                logFile.set_content(existing + msg + char(10))
                print(c.grey + "  logged: " + msg + c.ennd)
            end if
        end if

    // ── echo ─────────────────────────────────────────────────────
    else if cmd == "echo" then
        if inp.len == 1 then
            print("")
        else
            print(c.white + inp[1:].join(" ") + c.ennd)
        end if

    // ── ask ──────────────────────────────────────────────────────
    else if cmd == "ask" then
        if inp.len < 2 then
            print(c.yellow + "<b>usage: ask @var [prompt]" + c.ennd)
        else
            k = inp[1]
            if k[0:1] == "@" then k = k[1:]
            prompt = ""
            if inp.len >= 3 then prompt = inp[2:].join(" ")
            val = user_input(c.gold + prompt + c.ennd, false, false)
            if val != "" then
                gco = get_custom_object
                if not gco.hasIndex("clips") then gco.clips = {}
                gco.clips[k] = val
                pipeVars[k] = val
                pipeResult = val
                print(c.lime + "  @" + k + " = " + val + c.ennd)
            else
                print(c.grey + "  @" + k + " unchanged (empty input)" + c.ennd)
            end if
        end if

    else if cmd == "break" then
        // exit current loop entirely
        loopIdx = null
        k = 0
        while k < macroQueue.len
            if macroQueue[k].len >= 9 and macroQueue[k][:9] == "__while__" then
                loopIdx = k
                k = macroQueue.len
            end if
            k = k + 1
        end while
        if loopIdx != null then
            macroQueue = macroQueue[loopIdx + 1:]
            pipeFailed = false
            print(c.grey + "  break: loop exited" + c.ennd)
        else
            print(c.grey + "  break: not inside a loop" + c.ennd)
        end if

    // ── continue ─────────────────────────────────────────────────
    else if cmd == "continue" then
        // skip remaining loop body lines, jump to next iteration
        loopIdx = null
        k = 0
        while k < macroQueue.len
            if macroQueue[k].len >= 9 and macroQueue[k][:9] == "__while__" then
                loopIdx = k
                k = macroQueue.len
            end if
            k = k + 1
        end while
        if loopIdx != null then
            skipped = loopIdx
            macroQueue = macroQueue[loopIdx:]
            pipeFailed = false
            if skipped > 0 then print(c.grey + "  continue: skipped " + skipped + " line(s)" + c.ennd)
        else if pipeQueue.len > 0 then
            pipeQueue = []
            pipeFailed = false
        else
            print(c.grey + "  continue: not inside a loop" + c.ennd)
        end if

    // ── null (no-op placeholder) ──────────────────────────────────
    else if cmd == "null" or cmd == "noop" or cmd == "pass" then
        // intentional no-op

    // ── unknown ──────────────────────────────────────────────────
    else
        print(c.yellow + "<b>phantom: " + cmd + ": command not found" + c.ennd)
    end if

    if storeVar != null and pipeResult != "" then
        pipeVars[storeVar] = pipeResult
        pipeResult = ""
    end if

end while
