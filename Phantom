Scan = function(ip, port, comp, inject, libName)
    if ip == "pt" then ip = publicTarget
    if ip == "lt" then ip = localTarget
    if ip == "-l" then
        metalib = metaxploit.load(port)
        if not metalib then
            print(c.yellow + "<b>scan: lib not found: " + port + c.ennd)
            return
        end if
    else
        if not is_valid_ip(ip) then
            print(c.yellow + "<b>scan: invalid ip" + c.ennd)
            return
        end if
        portInt = port.to_int
        if typeof(portInt) != "number" then
            print(c.yellow + "<b>scan: invalid port" + c.ennd)
            return
        end if
        ns = metaxploit.net_use(ip, portInt)
        if not ns then
            print(c.yellow + "<b>scan: no net session on " + ip + ":" + port + c.ennd)
            return
        end if
        metalib = ns.dump_lib
        // if specific lib requested, try to find it
        if libName then
            metalib = null
            // first try loading locally if it's a full path or in /lib
            localPath = libName
            if libName.indexOf("/") == null then localPath = "/lib/" + libName
            ml = metaxploit.load(localPath)
            if ml then
                metalib = ml
                print(c.grey + "  using local: " + ml.lib_name + " " + ml.version + c.ennd)
            end if
            // fallback — scan all ports for the lib
            if not metalib then
                router = get_router(ip)
                if router then
                    ports = router.used_ports
                    if ports then
                        for p in ports
                            pns = metaxploit.net_use(ip, p.port_number)
                            if not pns then continue
                            pl = pns.dump_lib
                            if not pl then continue
                            lname = libName.replace(".so","")
                            if pl.lib_name == libName or pl.lib_name == lname then
                                metalib = pl
                                print(c.grey + "  using remote: " + pl.lib_name + " " + pl.version + " on port " + p.port_number + c.ennd)
                                break
                            end if
                        end for
                    end if
                end if
            end if
            if not metalib then
                print(c.yellow + "<b>scan: lib not found: " + libName + c.ennd)
                return
            end if
        end if
        if not metalib then
            print(c.yellow + "<b>scan: metalib not obtained" + c.ennd)
            return
        end if
    end if
    // check db.txt for known exploits for this lib — skip scanning if found
    dbFile = myComp.File(currentPath + "/db.txt")
    if dbFile and typeof(dbFile) == "file" then
        content = dbFile.get_content
        if content and content != "" then
            matches = []
            for line in content.split(char(10))
                if line == "" then continue
                line = line.replace(char(13), "")
                p1 = line.indexOf("|")
                if p1 == null then continue
                p2 = line.indexOf("|", p1 + 1)
                if p2 == null then continue
                p3 = line.indexOf("|", p2 + 1)
                if p3 != null then
                    libName = line[:p1]
                    libVer  = line[p1+1:p2]
                    memAddr = line[p2+1:p3]
                    valStr  = line[p3+1:]
                else
                    libName = line[:p1]
                    libVer  = ""
                    memAddr = line[p1+1:p2]
                    valStr  = line[p2+1:]
                end if
                // only match if lib name AND version match
                if libName == metalib.lib_name and libVer == metalib.version and memAddr.len > 5 and valStr.len > 2 then
                    matches.push({"mem": memAddr, "val": valStr})
                end if
            end for
        if matches.len > 0 then
            print(c.green + "  edb hit: " + matches.len + " known exploit(s) for " + metalib.lib_name + " " + metalib.version + " — trying stored exploits" + c.ennd)
            shells = 0
            files  = 0
            comps  = 0
            gotResult = false
            for e in matches
                mem = e["mem"]
                val = e["val"]
                if inject then
                    obj = metalib.overflow(mem, val, inject)
                else
                    obj = metalib.overflow(mem, val)
                end if
                if typeof(obj) == "shell" then
                    print(char(10) + c.orange + "<b>" + mem + "  " + val + c.ennd)
                    print("<b>shell   : " + c.yellow + obj + c.ennd)
                    shells = shells + 1
                    gotResult = true
                    GETPERMS(obj)
                end if
                if typeof(obj) == "computer" then
                    print(char(10) + c.orange + "<b>" + mem + "  " + val + c.ennd)
                    print("<b>computer: " + c.yellow + obj + c.ennd)
                    comps = comps + 1
                    gotResult = true
                    GETPERMS(obj)
                end if
                if typeof(obj) == "file" then
                    print(char(10) + c.orange + "<b>" + mem + "  " + val + c.ennd)
                    print("<b>file    : " + c.yellow + obj.name + c.ennd)
                    files = files + 1
                    gotResult = true
                end if
            end for
            if gotResult then
                print(char(10) + c.gold + "lib: " + metalib.lib_name + " " + metalib.version + c.ennd)
                print(c.orange + "shells: " + shells + "  files: " + files + "  computers: " + comps + c.ennd)
                return
            end if
            // no results from edb — fall through to full scan
            print(c.grey + "  edb exploits failed — running full scan..." + c.ennd)
        end if
    end if

    memList = metaxploit.scan(metalib)
    if not memList then
        print(c.yellow + "<b>scan: no vulnerabilities found" + c.ennd)
