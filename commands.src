// ================================================================
//  commands.src  |  phantom module  |  command dispatch table
// ================================================================
// Maps a command name (string) to its Cmd* handler function.
// Built incrementally as each topic file gets its Cmd* wrappers —
// see the BATCH markers below. Once complete, phantom.src's main
// loop calls: CommandTable[cmd](inp)  instead of the old
// if/else if chain.

CommandTable = {}

// ---- BATCH 1: stack.src --------------------------------------
CommandTable["push"]        = @CmdPush
CommandTable["pop"]         = @CmdPop
CommandTable["stack"]       = @CmdStack
CommandTable["swap"]        = @CmdSwap
CommandTable["stackrun"]    = @CmdStackrun
CommandTable["stackpick"]   = @CmdStackpick
CommandTable["stackfor"]    = @CmdStackfor
CommandTable["stacktree"]   = @CmdStacktree
CommandTable["stacklog"]    = @CmdStacklog
CommandTable["autoharvest"] = @CmdAutoharvest
CommandTable["harvestgrep"] = @CmdHarvestgrep
CommandTable["psgrep"]      = @CmdPsgrep
CommandTable["treegrep"]    = @CmdTreegrep

