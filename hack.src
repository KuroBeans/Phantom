///////////////////////////////////////////////////////////
//////////////////////// Hack.src /////////////////////////
///////////////////////////////////////////////////////////

// ── Cmd wrappers — each self-registers into CommandTable right after ─────
// ── its own definition (see the CommandTable[...] line below it) ─────
// NOTE: the old inline dispatcher called WStack(true) / WStack(false)
// — a single boolean — even though WStack's signature is
// WStack(inp, localMode) and local mode indexes inp[0] for a lib
// name. That mismatch looks like a pre-existing bug (local mode
// would have received `true`/`false` as `inp` and crashed on
// inp[0]). This wrapper passes inp[1:] through so WStack gets a
// real argument list either way — flagging in case the old
// behavior was somehow relied upon.
CmdInfo = function(inp)
    if inp.len == 2 then
        TargetInfo(inp[1])
    else
        print("<b>Usage: info [ip]")
        print(c.grey + "  router kernel, firewall rules, open ports for ip — recon only, no attacking" + c.ennd)
        print(c.grey + "  accepts pt/lt, or a piped ip: randip | info @p" + c.ennd)
    end if
end function
CommandTable["imap"] = @CmdInfo
CmdWstack = function(inp)
    if inp.len >= 2 and inp[1] == "-l" then
        WStack(inp[2:], true)
    else
        WStack(inp[1:], false)
    end if
end function
CommandTable["wstack"] = @CmdWstack

CmdCascade = function(inp)
    Cascade()
end function
CommandTable["cascade"] = @CmdCascade

CmdScanlan = function(inp)
    acceptComputer = inp.indexOf("-c") != null
    skipPivot = inp.indexOf("-l") != null
    args = []
    for a in inp[1:]
        if a != "-c" and a != "-l" then args.push(a)
    end for
    if args.len == 2 then
        ScanLan(args[0], args[1], acceptComputer, skipPivot)
    else
        print("<b>Usage: scanlan [ip] [port] [opt:-c] [opt:-l]")
        print(c.grey + "  direct ip: recon only — decodes candidates, caches for grab, doesn't touch the target" + c.ennd)
        print(c.grey + "  LAN ip: bounces + attempts overflow in the same run (like scan), auto-pivoting as needed" + c.ennd)
        print(c.grey + "  -c   accept computer objects (not just shells) — LAN targets only" + c.ennd)
        print(c.grey + "  -l   scan locally instead of via a held remote shell — no auto-pivot, no" + c.ennd)
        print(c.grey + "       held object required, bounces straight from wherever phantom itself" + c.ennd)
        print(c.grey + "       is physically running (e.g. after jump)" + c.ennd)
    end if
end function
CommandTable["scanlan"] = @CmdScanlan

CmdScanlib = function(inp)
    acceptComputer = inp.indexOf("-c") != null
    args = []
    for a in inp[1:]
        if a != "-c" then args.push(a)
    end for
    if args.len == 1 then
        LibScan(args[0], null, acceptComputer)
    else if args.len == 2 then
        LibScan(args[0], args[1], acceptComputer)
    else
        print("<b>Usage: scanlib [libname] [opt:lan-ip] [opt:-c]")
        print(c.grey + "  scans a NAMED lib on the machine you're holding a shell on — you pick the" + c.ennd)
        print(c.grey + "  lib, not whatever's auto-bound to a port (that's scanlan/scan's job)" + c.ennd)
        print(c.grey + "  checks db.txt-known exploits first, same shortcut scanlan/grab already get" + c.ennd)
        print(c.grey + "  lan-ip: optional — used as the overflow's 3rd (inject) arg to bounce onto" + c.ennd)
        print(c.grey + "  that LAN device instead of attempting a plain 2-arg overflow here" + c.ennd)
        print(c.grey + "  -c   accept computer objects (not just shells)" + c.ennd)
    end if
end function
CommandTable["scanlib"] = @CmdScanlib

CmdExploit = function(inp)
    acceptComputer = inp.indexOf("-c") != null
    args = []
    for a in inp[1:]
        if a != "-c" then args.push(a)
    end for
    if args.len == 2 then
        Exploit(args[0], args[1], acceptComputer)
    else
        print("<b>Usage: exploit [ip] [port] [opt:-c]")
        print(c.grey + "  lists decoded exploit candidates for ip:port (scans first if none cached)" + c.ennd)
        print(c.grey + "  pick one by number, or 0 to enter a custom mem/val, then an optional inject value" + c.ennd)
        print(c.grey + "  direct ips only — not supported for LAN targets yet" + c.ennd)
        print(c.grey + "  -c   accept computer objects (not just shells)" + c.ennd)
    end if
end function
CommandTable["exploit"] = @CmdExploit

// ── ScanLan (wrapper) ─────────────────────────────────────────
// Scan a target's libraries without grabbing yet
WStack = function(inp, localMode)
    if localMode then
        // ── LOCAL MODE ────────────────────────────────────────────────────────
        targetIp = publicTarget
        if typeof(object) == "shell" then targetIp = object.host_computer.public_ip
        if typeof(object) == "computer" then targetIp = object.public_ip
        print(c.orange + "WStack local mode — discovering all LAN devices..." + c.ennd)
        libArg = "init.so"
        if inp.len > 0 and inp[0] != "" then libArg = inp[0]
        ml = metaxploit.load("/lib/" + libArg)
        if not ml then ml = metaxploit.load("/lib/libhttp.so")
        if not ml then
            print(c.yellow + "<b>wstack -l: libhttp.so not found in /lib" + c.ennd)
            return
        end if

        // recursive device discovery
        deviceList = []
        getDevices = function(router)
            if router == null then return
            ip = router.local_ip
            if deviceList.indexOf(ip) == null then deviceList.push(ip)
            devices = router.devices_lan_ip
            if not devices then return
            for device in devices
                if device == ip then continue
                if deviceList.indexOf(device) != null then continue
                subRouter = get_router(device)
                subSwitch = get_switch(device)
                if subRouter then
                    deviceList.push(device)
                    getDevices(subRouter)
                else if subSwitch then
                    deviceList.push(device)
                    getDevices(subSwitch)
                else
                    deviceList.push(device)
                end if
            end for
        end function

        router = get_router
        if is_valid_ip(targetIp) and not is_lan_ip(targetIp) then router = get_router(targetIp)
        if not router then
            print(c.yellow + "<b>wstack -l: could not get local router" + c.ennd)
            return
        end if
        getDevices(router)

        // fill IP gaps
        gapList = []
        for existingIp in deviceList
            parts = existingIp.split("\\.")
            if parts.len < 4 then continue
            subnet = parts[0] + "." + parts[1] + "." + parts[2] + "."
            lastOctet = parts[3].to_int
            i = 1
            while i < lastOctet
                candidate = subnet + i
                if deviceList.indexOf(candidate) == null and gapList.indexOf(candidate) == null then
                    gapList.push(candidate)
                end if
                i = i + 1
            end while
        end for
        for gapIp in gapList
            deviceList.push(gapIp)
        end for

        // db.txt-known exploits for this exact lib+version first — same
        // shortcut scanlan/scanlib/grab already get — before falling
        // back to the two hardcoded weaklib signatures below
        knownPairs = KnownExploits(ml.lib_name, ml.version)
        if knownPairs.len > 0 then
            print(c.grey + "  " + knownPairs.len + " known db exploit(s) for " + ml.lib_name + " " + ml.version + " — trying those first" + c.ennd)
        end if

        print(c.cyan + "  found " + deviceList.len + " device(s)" + c.ennd)
        pushed = 0
        for lanIp in deviceList
            print(c.orange + "  bouncing to " + lanIp + " ..." + c.ennd)
            obj = null
            for pair in knownPairs
                obj = ml.overflow(pair[0], pair[1], lanIp)
                EdbAdd(ml.lib_name, ml.version, pair[0], pair[1], typeof(obj), "")
                if typeof(obj) == "shell" or typeof(obj) == "computer" then break
                obj = null
            end for
            if not obj then
                // fixed: was "obj == ml.overflow(...)" (comparison,
                // discarded — never reassigned obj) and "lanip" (wrong
                // case, undefined — silently passed null as the inject
                // value) — this fallback never actually worked before
                obj = ml.overflow("0x1F8F7708", "dexer", lanIp)
                EdbAdd(ml.lib_name, ml.version, "0x1F8F7708", "dexer", typeof(obj), "")
                if not obj then
                    obj = ml.overflow("0x1F000FB5", "length", lanIp)
                    EdbAdd(ml.lib_name, ml.version, "0x1F000FB5", "length", typeof(obj), "")
                end if
            end if
            if not obj then
                // was "return print(...)" — aborted the ENTIRE scan on
                // the first device with no working exploit instead of
                // just skipping it and continuing to the rest
                print(c.yellow + "    no working exploit for " + lanIp + c.ennd)
                continue
            end if

            if typeof(obj) != "computer" then continue
            objectStack.push(obj)
            pushed = pushed + 1
            print(c.green + "  [+] pushed " + lanIp + " → stack [" + objectStack.len + "]" + c.ennd)
            homeDir = obj.File("/home")
            if homeDir then
                uNames = []
                for u in homeDir.get_folders
                    if u.name != "guest" then uNames.push(u.name)
                end for
                if uNames.len > 0 then print(c.grey + "        users: " + uNames.join(", ") + c.ennd)
            end if
        end for

        div
        print(c.cyan + "wstack -l complete — " + pushed + " computer(s) pushed to stack" + c.ennd)
        print(c.grey + "  use stack/swap/pop to access" + c.ennd)
        return
    end if

    // ── REMOTE MODE ───────────────────────────────────────────────────────────
    if typeof(object) != "shell" then
        print(c.yellow + "<b>wstack: not holding remote shell  (use wstack -l for local mode)" + c.ennd)
        return
    end if
    rcomp = object.host_computer
    pubIp = rcomp.public_ip
    lanIp = rcomp.local_ip
    libArg = ""
    if inp.len > 0 and inp[0] != "" then libArg = inp[0]

    // enumerate LAN from target's perspective via write-build-run (recursive)
    print(c.orange + "Enumerating LAN from target..." + c.ennd)
    rcomp.touch("/home/guest", "enum_lan.src")
    elSrc = rcomp.File("/home/guest/enum_lan.src")
    if elSrc then
        q = char(34)
        n = char(10)
        src = "gco = get_custom_object" + n
        src = src + "deviceList = []" + n
        src = src + "getDevices = function(router)" + n
        src = src + "  if router == null then return" + n
        src = src + "  ip = router.local_ip" + n
        src = src + "  if deviceList.indexOf(ip) == null then deviceList.push(ip)" + n
        src = src + "  devices = router.devices_lan_ip" + n
        src = src + "  if not devices then return" + n
        src = src + "  for device in devices" + n
        src = src + "    if device == ip then continue" + n
        src = src + "    if deviceList.indexOf(device) != null then continue" + n
        src = src + "    subRouter = get_router(device)" + n
        src = src + "    subSwitch = get_switch(device)" + n
        src = src + "    if subRouter then" + n
        src = src + "      deviceList.push(device)" + n
        src = src + "      getDevices(subRouter)" + n
        src = src + "    else if subSwitch then" + n
        src = src + "      deviceList.push(device)" + n
        src = src + "      getDevices(subSwitch)" + n
        src = src + "    else" + n
        src = src + "      deviceList.push(device)" + n
        src = src + "    end if" + n
        src = src + "  end for" + n
        src = src + "end function" + n
        src = src + "router = get_router" + n
        src = src + "if not router then exit()" + n
        src = src + "getDevices(router)" + n
        src = src + "gapList = []" + n
        src = src + "for existingIp in deviceList" + n
        src = src + "  parts = existingIp.split(" + q + "\\." + q + ")" + n
        src = src + "  if parts.len < 4 then continue" + n
        src = src + "  subnet = parts[0] + " + q + "." + q + " + parts[1] + " + q + "." + q + " + parts[2] + " + q + "." + q + n
        src = src + "  lastOctet = parts[3].to_int" + n
        src = src + "  i = 1" + n
        src = src + "  while i < lastOctet" + n
        src = src + "    candidate = subnet + i" + n
        src = src + "    if deviceList.indexOf(candidate) == null and gapList.indexOf(candidate) == null then" + n
        src = src + "      gapList.push(candidate)" + n
        src = src + "    end if" + n
        src = src + "    i = i + 1" + n
        src = src + "  end while" + n
        src = src + "end for" + n
        src = src + "for gapIp in gapList" + n
        src = src + "  deviceList.push(gapIp)" + n
        src = src + "end for" + n
        src = src + "gco.wbLanIps = deviceList.join(" + q + "," + q + ")" + n
        elSrc.set_content(src)
        object.build("/home/guest/enum_lan.src", "/home/guest", false)
        elBin = rcomp.File("/home/guest/enum_lan")
        if elBin then
            gco.wbLanIps = null
            object.launch("/home/guest/enum_lan")
            elSrc.delete
            elBin.delete
        else
            elSrc.delete
        end if
    end if

    lanTargets = []
    if gco.hasIndex("wbLanIps") and gco.wbLanIps then
        for ip in gco.wbLanIps.split(",")
            if ip != lanIp and ip != "" then lanTargets.push(ip)
        end for
        print(c.cyan + "  target sees " + lanTargets.len + " device(s): " + lanTargets.join(", ") + c.ennd)
    end if

    // fallback
    if lanTargets.len == 0 then
        router = get_router(pubIp)
        if not router then router = get_router(lanIp)
        if router then
            devices = router.devices_lan_ip
            if devices then
                for ip in devices
                    if ip != lanIp then lanTargets.push(ip)
                end for
            end if
        end if
    end if

    if lanTargets.len == 0 then
        print(c.yellow + "<b>wstack: no other LAN devices" + c.ennd)
        return
    end if
    print(c.cyan + "  found " + lanTargets.len + " target(s): " + lanTargets.join(", ") + c.ennd)

    // upload prebuilt binary + metaxploit — writing/building the bounce
    // script ON the target (the old approach) didn't reliably share gco
    // with the caller (same issue enum_lan's wbLanIps silently has,
    // masked by its own fallback path). Precompiled + scp'd, same as
    // slb/netmap, is the pattern actually confirmed to work.
    wsxBin = currentPath + "/wsx"
    if not myComp.File(wsxBin) then
        print(c.yellow + "<b>wstack: wsx binary not found at " + wsxBin + c.ennd)
        print(c.grey + "  build it first: build /root/ai/tp/wsx.src /root/ai/tp" + c.ennd)
        return
    end if

    print(c.orange + "Uploading tools..." + c.ennd)
    me = get_shell
    me.scp(currentPath + "/metaxploit.so", "/home/guest", object)
    uploadResult = me.scp(wsxBin, "/home/guest", object)
    if typeof(uploadResult) == "string" and uploadResult != "" then
        print(c.yellow + "<b>wstack: upload failed: " + uploadResult + c.ennd)
        return
    end if

    binFile2 = rcomp.File("/home/guest/wsx")
    if not binFile2 then
        print(c.yellow + "<b>wstack: wsx not found on target after upload" + c.ennd)
        mxf = rcomp.File("/home/guest/metaxploit.so")
        if mxf then mxf.delete
        return
    end if

    gco.wsIPs = lanTargets.join(",")
    gco.wsLib = libArg
    gco.wsObjects = null
    gco.wsCount = 0
    gco.wsResults = null
    gco.wsLibName = ""
    gco.wsLibVer  = ""
    gco.wsDebug = "script did not run"
    // plain data, not a live object — same launch-boundary pattern
    // ScanLanBounce/LibScan already use. Lets wsx.src try db-known
    // exploits first instead of always falling to the hardcoded
    // signature or a full scan.
    gco.edb = globals.edb
    print(c.orange + "Running on target..." + c.ennd)
    object.launch("/home/guest/wsx")
    wait(4)
    print(c.teal + "  debug: " + gco.wsDebug + c.ennd)

    // wsx.src can't write db.txt itself (it runs on the target, not the
    // origin machine) — record every attempted candidate it reports
    // back, same completeness ScanLanBounce/LibScan already have
    if gco.hasIndex("wsResults") and gco.wsResults and gco.hasIndex("wsLibName") and gco.wsLibName != "" then
        for entry in gco.wsResults.split(char(2))
            parts4 = entry.split(char(3))
            if parts4.len < 4 then continue
            EdbAdd(gco.wsLibName, gco.wsLibVer, parts4[1], parts4[2], parts4[3], "")
        end for
    end if

    // cleanup
    binFile2.delete
    mxf = rcomp.File("/home/guest/metaxploit.so")
    if mxf then mxf.delete

    // push objects to stack
    pushed = 0
    if gco.wsObjects and gco.wsCount > 0 then
        for obj in gco.wsObjects
            objType = typeof(obj)
            if objType != "computer" and objType != "shell" then continue
            objectStack.push(obj)
            pushed = pushed + 1
            comp = obj
            if objType == "shell" then comp = obj.host_computer
            print(c.green + "  [+] pushed " + objType + " " + comp.local_ip + " → stack [" + objectStack.len + "]" + c.ennd)
            homeDir = comp.File("/home")
            if homeDir then
                uNames = []
                for u in homeDir.get_folders
                    if u.name != "guest" then uNames.push(u.name)
                end for
                if uNames.len > 0 then print(c.grey + "        users: " + uNames.join(", ") + c.ennd)
            end if
        end for
    end if

    div
    print(c.cyan + "wstack complete — " + pushed + " object(s) pushed to stack across " + lanTargets.len + " device(s)" + c.ennd)
    print(c.grey + "  use stack/swap/pop to access" + c.ennd)
end function

ScanLan = function(ip, port, acceptComputer=false, skipPivot=false)
    if ip == "pt" then ip = publicTarget
    if ip == "lt" then ip = localTarget
    if not is_valid_ip(ip) then
        print(c.yellow + "<b>scanlan: invalid ip" + c.ennd)
        return
    end if
    portInt = port.to_int
    if typeof(portInt) != "number" then
        print(c.yellow + "<b>scanlan: invalid port" + c.ennd)
        return
    end if

    // LAN targets need to net_use from inside their own segment, same
    // as scan/grab — direct net_use from the local machine can never
    // reach a private ip that isn't literally your own LAN. This is
    // scan+attempt (ScanLanBounce/slb.src), not recon-only, since a
    // LAN bounce only gets one on-target run either way.
    if is_lan_ip(ip) then
        // -l means fully local — bounce from wherever phantom itself
        // is physically running (e.g. after jump), skipping both the
        // held-remote-shell requirement and auto-pivot entirely, since
        // neither means anything once you're already standing there
        if skipPivot then
            print(c.grey + "  -l: scanning locally from wherever phantom itself is running" + c.ennd)
        else
            if typeof(globals.object) != "shell" then
                print(c.yellow + "<b>scanlan: need a remote shell to reach LAN ips (or use -l to scan locally)" + c.ennd)
                globals.pipeFailed = true
                return
            end if
            if not EnsureLanPath(ip) then
                globals.pipeFailed = true
                return
            end if
        end if
        ScanLanBounce(ip, portInt, null, skipPivot)
        // slb already tried overflow during the scan — if it landed
        // something, push it straight to the stack instead of
        // discarding the result and making the caller run a separate
        // grab to re-fetch what we already have. Verify the type
        // explicitly rather than trusting gco.slbObj on truthiness
        // alone — same check GrabLanBounce already does. Computers only
        // get pushed with -c, same "-c accept computer objects" gate
        // exploit/grab already use elsewhere — a shell always gets kept.
        if gco.slbObj and (typeof(gco.slbObj) == "shell" or (typeof(gco.slbObj) == "computer" and acceptComputer)) then
            objectStack.push(gco.slbObj)
            print(c.green + "  [+] " + gco.slbObjType + " obtained via " + gco.slbMem + " " + gco.slbVal + " -> pushed to stack [" + objectStack.len + "]" + c.ennd)
            // gco.slbUserCtx may be missing if the deployed slb binary
            // predates this field (stale build) — read defensively so
            // an out-of-date target doesn't crash the caller
            slbUserCtx = ""
            if gco.hasIndex("slbUserCtx") then slbUserCtx = gco.slbUserCtx
            EdbAdd(gco.slbLibName, gco.slbLibVer, gco.slbMem, gco.slbVal, gco.slbObjType, slbUserCtx)
            gco.slbReady = false
        else if gco.slbObj and typeof(gco.slbObj) == "computer" and not acceptComputer then
            print(c.yellow + "<b>scanlan: got computer object — use scanlan -c to accept computers" + c.ennd)
        end if
        return
    end if

    ns = metaxploit.net_use(ip, portInt)
    if not ns then
        print(c.yellow + "<b>scanlan: no net session on " + ip + ":" + port + c.ennd)
        globals.pipeFailed = true
        return
    end if
    metalib = ns.dump_lib
    if not metalib then
        print(c.yellow + "<b>scanlan: metalib not obtained" + c.ennd)
        globals.pipeFailed = true
        return
    end if
    print(c.cyan + "Library: " + metalib.lib_name + " " + metalib.version + c.ennd)
    if IsDeadLib(metalib.lib_name, metalib.version) then
        print(c.grey + "  [known dead — no exploitable vulnerabilities, see deadlibs.txt]" + c.ennd)
        return
    end if

    // already have confirmed exploit(s) for this exact lib+version from
    // a prior target — reuse them and skip mx.scan()/scan_address()
    // entirely instead of rediscovering the same candidates every time
    exploits = KnownExploits(metalib.lib_name, metalib.version)
    if exploits.len > 0 then
        print(c.grey + "  known exploits for " + metalib.lib_name + " " + metalib.version + " — skipping scan (see db.txt)" + c.ennd)
    else
        if metalib.is_patched then
            print(c.grey + "  [patched - no vulnerabilities]" + c.ennd)
            DeadLibAdd(metalib.lib_name, metalib.version)
            return
        end if
        memList = metaxploit.scan(metalib)
        if not memList then
            print(c.grey + "  [no vulnerabilities found]" + c.ennd)
            DeadLibAdd(metalib.lib_name, metalib.version)
            return
        end if

        // decode mem -> val for each vuln (same parse as Scan/ProxyWithChainSaw)
        // so the pairs are overflow-ready, not just member names
        for mem in memList
            addrs = metaxploit.scan_address(metalib, mem).split("Unsafe check: ")
            for res in addrs
                if res == addrs[0] then continue
                valStart = res.indexOf("<b>")
                if valStart == null then continue
                valEnd = res.indexOf("</b>", valStart)
                val = res[valStart + 3 : valEnd]
                if val == "" then continue
                exploits.push([mem, val])
                // recon-only decode still gets persisted to db.txt as an
                // unconfirmed candidate (blank type/user) — same
                // convention updatelib already uses — so every lib+version
                // ever scanned builds up a record in db.txt, not just the
                // ones somebody actually fired grab/exploit against
                EdbAdd(metalib.lib_name, metalib.version, mem, val, "", "")
            end for
        end for

        if exploits.len == 0 then
            print(c.grey + "  [scan_address returned no usable values]" + c.ennd)
            DeadLibAdd(metalib.lib_name, metalib.version)
            return
        end if
    end if

    print(c.orange + "  vulnerabilities: " + exploits.len + c.ennd)
    for e in exploits
        print(c.gold + "    " + e[0] + "  " + e[1] + c.ennd)
    end for

    // cache decoded pairs so `grab ip port` can reuse them without
    // re-scanning or touching db.txt
    if not gco.hasIndex("scanLanResults") then gco.scanLanResults = {}
    gco.scanLanResults[ip + ":" + portInt] = {"lib": metalib.lib_name, "ver": metalib.version, "exploits": exploits}
    print(c.grey + "  cached — use " + c.white + "grab " + ip + " " + port + c.grey + " to connect" + c.ennd)
end function

// ── LibScan ────────────────────────────────────────────────────────
// Scan/attack a NAMED lib on the machine you're currently holding a
// shell on — not whatever dump_lib auto-picks for a specific port
// (that's ScanLan/Scan's job). Loads straight from that machine's own
// /lib via an uploaded payload (payloads/libscan.src), checks
// db.txt-known exploits first (same shortcut ScanLan/grab already
// get), and optionally bounces the overflow's inject value at a given
// LAN ip to pivot onward from there instead of attempting a plain
// 2-arg overflow on the held machine itself.
LibScan = function(libName, lanIp, acceptComputer)
    if typeof(object) != "shell" then
        print(c.yellow + "<b>scanlib: not holding remote shell" + c.ennd)
        globals.pipeFailed = true
        return
    end if
    rcomp = object.host_computer

    mxf = rcomp.File("/home/guest/metaxploit.so")
    if not mxf then
        myShell.scp(currentPath + "/metaxploit.so", "/home/guest", object)
        mxf = rcomp.File("/home/guest/metaxploit.so")
    end if

    lsBin = currentPath + "/libscan"
    if not myComp.File(lsBin) then
        print(c.yellow + "<b>scanlib: libscan binary not found at " + lsBin + c.ennd)
        print(c.grey + "  build it first: build /root/ai/tp/libscan.src /root/ai/tp" + c.ennd)
        globals.pipeFailed = true
        return
    end if

    bf = rcomp.File("/home/guest/libscan")
    if not bf then
        print(c.grey + "  uploading scanner..." + c.ennd)
        uploadResult = myShell.scp(lsBin, "/home/guest", object)
        if typeof(uploadResult) == "string" and uploadResult != "" then
            print(c.yellow + "<b>scanlib: upload failed: " + uploadResult + c.ennd)
            globals.pipeFailed = true
            return
        end if
        bf = rcomp.File("/home/guest/libscan")
    end if
    if not bf then
        print(c.yellow + "<b>scanlib: libscan not found on target after upload" + c.ennd)
        globals.pipeFailed = true
        return
    end if

    gco.lsLib     = libName
    gco.lsInject  = ""
    if lanIp then gco.lsInject = lanIp
    gco.lsResults = null
    gco.lsCount   = 0
    gco.lsPatched = 0
    gco.lsLibName = ""
    gco.lsLibVer  = ""
    gco.lsDebug   = "script did not run"
    gco.lsDone    = false
    gco.lsDeadLib = false
    // plain data, not a live object — same launch-boundary pattern
    // ScanLanBounce already uses for gco.deadLibs/gco.edb
    gco.deadLibs  = globals.deadLibs
    gco.edb       = globals.edb
    object.launch("/home/guest/libscan")
    waited = 0
    while not gco.lsDone and waited < 6
        wait(0.25)
        waited = waited + 0.25
    end while

    if gco.lsDeadLib then DeadLibAdd(gco.lsLibName, gco.lsLibVer)

    print(c.teal + "  debug: " + gco.lsDebug + c.ennd)

    if gco.lsPatched == 1 then
        print(c.grey + "  " + gco.lsLibName + " " + gco.lsLibVer + " — patched" + c.ennd)
        globals.pipeFailed = true
        return
    end if

    if not gco.lsResults or gco.lsCount == 0 then
        debugMsg = ""
        if gco.hasIndex("lsDebug") and gco.lsDebug != "" then debugMsg = "  (" + gco.lsDebug + ")"
        print(c.yellow + "<b>scanlib: no vulns on " + libName + debugMsg + c.ennd)
        globals.pipeFailed = true
        return
    end if

    print(c.cyan + "  lib: " + gco.lsLibName + " " + gco.lsLibVer + "  [" + gco.lsCount + " vuln(s)]" + c.ennd)
    lsUserCtx = ""
    if gco.hasIndex("lsUserCtx") then lsUserCtx = gco.lsUserCtx
    for entry in gco.lsResults.split(char(2))
        parts3 = entry.split(char(3))
        if parts3.len < 2 then continue
        mem3 = parts3[0]
        val3 = parts3[1]
        outcome3 = ""
        if parts3.len >= 3 then outcome3 = parts3[2]
        line3 = "    " + mem3 + "  " + val3
        if outcome3 != "" then line3 = line3 + "  -> " + outcome3
        print(c.gold + line3 + c.ennd)
        // record every attempted candidate's actual outcome, not just
        // the one we ended up keeping — same completeness ScanLanBounce
        // has for its own results. "skipped" means libscan never
        // actually tried it (already had a shell) — don't record a
        // dud for something we didn't attempt.
        if outcome3 != "" and outcome3 != "skipped" then
            userForEntry = ""
            if mem3 == gco.lsMem and val3 == gco.lsVal and outcome3 == gco.lsObjType then userForEntry = lsUserCtx
            EdbAdd(gco.lsLibName, gco.lsLibVer, mem3, val3, outcome3, userForEntry)
        end if
    end for

    if gco.lsObj and (typeof(gco.lsObj) == "shell" or (typeof(gco.lsObj) == "computer" and acceptComputer)) then
        objectStack.push(gco.lsObj)
        print(c.green + "  [+] " + gco.lsObjType + " obtained via " + gco.lsMem + " " + gco.lsVal + " -> pushed to stack [" + objectStack.len + "]" + c.ennd)
    else if gco.lsObj and typeof(gco.lsObj) == "computer" and not acceptComputer then
        print(c.yellow + "<b>scanlib: got computer object — use scanlib -c to accept computers" + c.ennd)
    end if

    // a computer found alongside a (better) shell doesn't get silently
    // dropped just because the shell won as the primary result above —
    // push it too when -c is set. The != check skips this when lsObj
    // itself already IS this same computer (no shell ever beat it),
    // since that case was already pushed by the block above.
    if acceptComputer and gco.hasIndex("lsCompObj") and gco.lsCompObj and gco.lsCompObj != gco.lsObj then
        objectStack.push(gco.lsCompObj)
        print(c.green + "  [+] computer also obtained via " + gco.lsCompMem + " " + gco.lsCompVal + " -> pushed to stack [" + objectStack.len + "]" + c.ennd)
    end if
end function

// ── Exploit ────────────────────────────────────────────────────
// Interactive exploit picker — lists every decoded candidate for
// ip:port, lets the operator pick one (or supply a fully custom
// mem/val) plus an optional inject value, then hands off to Grab
// for the actual overflow attempt + shell/computer handling. No
// attack logic duplicated — Grab already does the right thing once
// given an explicit mem/val, this is just an interactive front end
// for choosing it. Direct ips only; LAN bounce (slb.src) doesn't
// have a manual-mem/val mode.
Exploit = function(ip, port, acceptComputer)
    if ip == "pt" then ip = publicTarget
    if ip == "lt" then ip = localTarget
    if not is_valid_ip(ip) then
        print(c.yellow + "<b>exploit: invalid ip" + c.ennd)
        return
    end if
    if is_lan_ip(ip) then
        print(c.yellow + "<b>exploit: LAN targets not supported yet — use scanlan/grab instead" + c.ennd)
        globals.pipeFailed = true
        return
    end if
    portInt = port.to_int
    if typeof(portInt) != "number" then
        print(c.yellow + "<b>exploit: invalid port" + c.ennd)
        return
    end if

    scanKey = ip + ":" + portInt
    cached = null
    if gco.hasIndex("scanLanResults") and gco.scanLanResults.hasIndex(scanKey) then
        cached = gco.scanLanResults[scanKey]
    end if

    if not cached then
        print(c.orange + "  no cached scan — running scanlan first..." + c.ennd)
        ScanLan(ip, port)
        if gco.hasIndex("scanLanResults") and gco.scanLanResults.hasIndex(scanKey) then
            cached = gco.scanLanResults[scanKey]
        end if
    end if

    if not cached or cached.exploits.len == 0 then
        print(c.yellow + "<b>exploit: no candidates for " + ip + ":" + port + c.ennd)
        globals.pipeFailed = true
        return
    end if

    // candidate list = freshly scanned pairs (type/user unknown, never
    // tried) merged with matching exploit-db entries for the same
    // lib+ver (type/user known if this exploit's been fired before) —
    // backfills onto a scanned candidate the db also knows about, or
    // adds a db-only candidate the current scan missed
    candidates = []
    for pair in cached.exploits
        candidates.push({"mem": pair[0], "val": pair[1], "type": "", "user": ""})
    end for

    dbFile = myComp.File(currentPath + "/db.txt")
    if dbFile and typeof(dbFile) == "file" then
        dbContent = dbFile.get_content
        if dbContent and dbContent != "" then
            for line in dbContent.split(char(10))
                if line == "" then continue
                line = line.replace(char(13), "")
                p1 = line.indexOf("|")
                if p1 == null then continue
                p2 = line.indexOf("|", p1 + 1)
                if p2 == null then continue
                p3 = line.indexOf("|", p2 + 1)
                if p3 == null then continue
                if line[:p1] != cached.lib or line[p1+1:p2] != cached.ver then continue
                p4 = line.indexOf("|", p3 + 1)
                dbMem = line[p2+1:p3]
                dbVal = ""
                dbType = ""
                dbUser = ""
                if p4 != null then
                    p5 = line.indexOf("|", p4 + 1)
                    if p5 != null then
                        dbVal = line[p3+1:p4]
                        dbType = line[p4+1:p5]
                        dbUser = line[p5+1:]
                    else
                        dbVal = line[p3+1:p4]
                        dbType = line[p4+1:]
                    end if
                else
                    dbVal = line[p3+1:]
                end if
                if dbMem == "" or dbVal == "" then continue
                found = false
                for cand in candidates
                    if cand.mem == dbMem and cand.val == dbVal then
                        found = true
                        if dbType != "" then cand.type = dbType
                        if dbUser != "" then cand.user = dbUser
                        break
                    end if
                end for
                if not found then
                    candidates.push({"mem": dbMem, "val": dbVal, "type": dbType, "user": dbUser})
                end if
            end for
        end if
    end if

    print(c.cyan + "<b>exploit: " + candidates.len + " candidate(s) for " + ip + ":" + port + c.ennd)
    i = 1
    for cand in candidates
        typeLabel = "?"
        if cand.type != "" then typeLabel = cand.type
        userLabel = "?"
        if cand.user != "" then userLabel = cand.user
        memCol = cand.mem
        while memCol.len < 12
            memCol = memCol + " "
        end while
        valCol = cand.val
        while valCol.len < 24
            valCol = valCol + " "
        end while
        print(c.gold + "  [" + i + "]" + c.ennd + memCol + "  " + valCol + "  " + userLabel + "  " + typeLabel)
        i = i + 1
    end for
    print(c.grey + "  [0] custom mem/val" + c.ennd)

    choice = user_input(c.white + "Select an exploit #: " + c.ennd).to_int
    if typeof(choice) != "number" then
        print(c.yellow + "<b>exploit: invalid selection" + c.ennd)
        return
    end if

    mem = ""
    val = ""
    if choice == 0 then
        mem = user_input(c.white + "Enter memory address: " + c.ennd)
        if mem == "" then
            print(c.yellow + "<b>exploit: aborting" + c.ennd)
            return
        end if
        val = user_input(c.white + "Enter overflow value: " + c.ennd)
        if val == "" then
            print(c.yellow + "<b>exploit: aborting" + c.ennd)
            return
        end if
    else if choice >= 1 and choice <= candidates.len then
        mem = candidates[choice - 1].mem
        val = candidates[choice - 1].val
    else
        print(c.yellow + "<b>exploit: invalid selection" + c.ennd)
        return
    end if

    inject = user_input(c.white + "Enter ip or password for inject value (<enter>=blank): " + c.ennd)
    if inject == "" then inject = null

    print(c.orange + "Injecting: " + mem + " " + val + " " + inject + c.ennd)
    // Grab expects a string port (it does its own .to_int internally,
    // same as every other caller) — passing the already-converted
    // portInt number here is what threw "Key Not Found: 'to_int'"
    Grab(ip, port, mem, val, inject, acceptComputer)
    // Grab always assigns globals.object to whatever overflow()
    // returned, even on its own "failure" paths (unaccepted computer,
    // file, null) — so this reliably shows what actually came back
    print(c.grey + "  result type: " + typeof(object) + c.ennd)
end function

// ── QuickGrab (wrapper) ───────────────────────────────────────
// Scan and grab in one shot with auto-edb lookup
QuickGrab = function(ip, port)
//    if not is_valid_ip(ip) then
//        print(c.yellow + "<b>quickgrab: invalid ip" + c.ennd)
//        globals.pipeFailed = true
  //      return
    //end if
    portInt = port.to_int
    //if typeof(portInt) != "number" then
      //  print(c.yellow + "<b>quickgrab: invalid port" + c.ennd)
        //globals.pipeFailed = true
       // return
    //end if
    print(c.orange + "Quick grab " + ip + ":" + port + "..." + c.ennd)
    ns = metaxploit.net_use(ip, port.to_int)
    if not ns then
        print(c.yellow + "<b>quickgrab: no net session" + c.ennd)
        globals.pipeFailed = true
        return
    end if
    metalib = ns.dump_lib
    if not metalib then
        print(c.yellow + "<b>quickgrab: metalib not obtained" + c.ennd)
        globals.pipeFailed = true
        return
    end if
    // try edb first
    for e in globals.edb
        if e.hasIndex("lib") and e.hasIndex("mem") and e.hasIndex("val") then
            if e["lib"] == metalib.lib_name then
                obj = metalib.overflow(e["mem"], e["val"])
                if typeof(obj) == "shell" or typeof(obj) == "computer" then
                    globals.object = obj
                    if typeof(obj) == "shell" then
                        globals.remotePath = "/"
                        print(c.green + "<b>[+] shell grabbed via edb" + c.ennd)
                        GETPERMS(obj)
                    end if
                    return
                end if
            end if
        end if
    end for
    // fallback to scan
    print(c.grey + "  no edb match, running full scan..." + c.ennd)
    Scan(ip, port, myComp, null, null)
end function

// ── TargetInfo ──────────────────────────────────────────────────
// Get detailed info on a target without attacking
TargetInfo = function(ip)
    if ip == "pt" then ip = publicTarget
    if ip == "lt" then ip = localTarget
    if not is_valid_ip(ip) then
        print(c.yellow + "<b>targetinfo: invalid ip" + c.ennd)
        globals.pipeFailed = true
        return
    end if
	 
    lan = is_lan_ip(ip)
    router = null
    if lan then
        router = get_router
    else
        router = get_router(ip)
    end if
    if not router then
        print(c.yellow + "<b>targetinfo: host not found" + c.ennd)
        globals.pipeFailed = true
        return
    end if

    ports = null
    if lan then
        ports = router.device_ports(ip)
    else
        ports = router.used_ports
    end if
		lanipenum = devices_lan_ip(router)

		if lanipenum and lanipenum.len > 0 then
			print(char(10) + c.green + "<b>[i] LAN devices (" + lanipenum.len + "):" + c.ennd)
			for lip in lanipenum
				tag = ""
				if lip == ip then tag = c.gold + "  ← target" + c.ennd
				print(c.white + "  " + lip + c.ennd + tag)
			end for
		else
			print(char(10) + c.grey + "[i] no LAN devices found" + c.ennd)
		end if

    print(char(10) + c.cyan + "<b>" + ip + c.ennd)
    print(c.gold + "Router kernel: " + router.kernel_version + c.ennd)
    print(c.gold + "Firewall rules: " + router.firewall_rules + c.ennd)
    print(char(10) + c.orange + "Open ports:" + c.ennd)
    // device_ports() returns a STRING (not null) when the LAN device
    // is firewalled — iterating that as a port list crashes, since
    // port_info()/is_closed only work on real port objects
    if typeof(ports) == "string" then
        print(c.red + "  firewalled — no port data available" + c.ennd)
    else if not ports or ports.len == 0 then
        print(c.grey + "  no open ports" + c.ennd)
    else
        for p in ports
            svc = router.port_info(p)
            state = "open"
            if p.is_closed then state = "closed"
            print(c.white + "  " + p.port_number + "  " + state + "  " + svc + c.ennd)
        end for
    end if
    globals.pipeResult = ip
    globals.pipeVars["p"] = ip
end function

// ── LibAudit ────────────────────────────────────────────────────
// Quick audit of a specific lib — list all known exploits in edb
LibAudit = function(libName)
    if not libName or libName == "" then
        print(c.yellow + "<b>libaudit: missing lib name" + c.ennd)
        return
    end if
    matches = []
    for e in globals.edb
        if e.hasIndex("lib") and e["lib"] == libName then
            matches.push(e)
        end if
    end for
    if matches.len == 0 then
        print(c.grey + libName + ": no entries in edb" + c.ennd)
        return
    end if
    print(c.cyan + "<b>" + libName + " (" + matches.len + " exploit(s))" + c.ennd)
    for e in matches
        ver = ""
        if e.hasIndex("ver") and e["ver"] != "" then ver = " v" + e["ver"]
        print(c.gold + "  " + e["mem"] + "  " + e["val"] + ver + c.ennd)
    end for
end function

// ── ProxyWithChainSaw ───────────────────────────────────────────
// ── ProxyWithChainSaw ───────────────────────────────────────────
// Clean output + clear_screen after failed hops
ProxyWithChainSaw = function(hops)
    if typeof(hops) != "number" or hops < 1 then hops = 2

    print(char(10) + c.cyan + "<b>=== BUILDING " + hops + "-HOP PROXY CHAIN ===" + c.ennd)

    chain = []
    attempts = 0
    maxAttempts = hops * 30

    while chain.len < hops and attempts < maxAttempts
        attempts = attempts + 1
        ip = floor(rnd*256) + "." + floor(rnd*256) + "." + floor(rnd*256) + "." + floor(rnd*256)
        if is_lan_ip(ip) then continue

        print(c.grey + " [" + chain.len + "/" + hops + "] Probing " + ip + " ..." + c.ennd)

        router = get_router(ip)
        if not router then
			wait(1)
            clear_screen
			wait(1)
            continue
        end if

        ns = metaxploit.net_use(ip, 0)
        if not ns then
			wait(1)
            clear_screen
			wait(1)
            continue
        end if

        ml = ns.dump_lib
        if not ml or ml.is_patched then
			wait(1)
            clear_screen
			wait(1)
            continue
        end if

        shell = null

        // db-known exploits for this exact lib+version first — same
        // shortcut ScanLib/grab/wstack already get — before falling
        // back to the full scan/decode below. Random probing hits the
        // same handful of common router libs constantly, so this skips
        // re-decoding candidates for ones already confirmed.
        for pair in KnownExploits(ml.lib_name, ml.version)
            if shell then break
            obj = ml.overflow(pair[0], pair[1])
            if typeof(obj) == "shell" or typeof(obj) == "computer" then
                shell = obj
                EdbAdd(ml.lib_name, ml.version, pair[0], pair[1], typeof(obj), GetUserCtx(obj))
            else
                EdbAdd(ml.lib_name, ml.version, pair[0], pair[1], typeof(obj), "")
                if typeof(obj) == "firewall" then print("test: firewall disable returned")
            end if
        end for

        if not shell then
            memList = metaxploit.scan(ml)
            if not memList then
			    wait(1)
                clear_screen
                continue
            end if

            for mem in memList
                if shell then break
                addrs = metaxploit.scan_address(ml, mem).split("Unsafe check: ")
                for res in addrs
                    if res == addrs[0] then continue
                    valStart = res.indexOf("<b>")
                    if valStart == null then continue
                    valEnd = res.indexOf("</b>", valStart)
                    val = res[valStart + 3 : valEnd]
                    if val == "" then continue

                    obj = ml.overflow(mem, val)
                    if typeof(obj) == "shell" or typeof(obj) == "computer" then
                        shell = obj
                        EdbAdd(ml.lib_name, ml.version, mem, val, typeof(obj), GetUserCtx(obj))
                        break
                    else
                        // record the miss too — same completeness as the
                        // direct-ip Grab loop now has
                        EdbAdd(ml.lib_name, ml.version, mem, val, typeof(obj), "")
                        // exploratory: haven't confirmed what typeof() returns
                        // for a firewall-disable side-effect exploit — flag it
                        // loudly if it ever shows up so we can see the actual type
                        if typeof(obj) == "firewall" then print("test: firewall disable returned")
                    end if
                end for
            end for
        end if

        if shell then
            hip = "???"
            if typeof(shell) == "shell" and shell.host_computer then
                hip = shell.host_computer.public_ip
            else if typeof(shell) == "computer" then
                hip = shell.public_ip
            end if
            chain.push(shell)
            print(c.green + " [+] Hop " + chain.len + ": " + hip + c.ennd)
        else
            clear_screen   // clear after failed hop
        end if
    end while

    if chain.len == 0 then
        print(c.red + "<b>proxy: Could not build any valid hop" + c.ennd)
        return
    end if

    gco.proxyChain = chain
    gco.proxyDepth = chain.len

    final = chain[-1]
    globals.object = final
    globals.remotePath = "/"

    print(char(10) + c.cyan + "<b>Proxy chain ready (" + chain.len + " hops):" + c.ennd)
    for i in range(0, chain.len-1)
        hop = chain[i]
        hip = "???"
        if typeof(hop) == "shell" and hop.host_computer then
            hip = hop.host_computer.public_ip
        else if typeof(hop) == "computer" then
            hip = hop.public_ip
        end if
        print(c.grey + "   Hop " + (i+1) + ": " + c.gold + hip + c.ennd)
    end for

    // Root final hop
    print(char(10) + c.orange + "Rooting final hop with ChainSaw..." + c.ennd)
    if typeof(final) == "shell" then
        ChainSaw.load
        wait(1)

        rcomp = final.host_computer
        rcePath = "/home/guest"
        rceName = "cs_rce"

        rceCode = "chainsaw = get_custom_object.chainsaw" + char(10)
        rceCode = rceCode + "chainsaw.load_samples" + char(10)
        rceCode = rceCode + "chainsaw.load_pregens" + char(10)
        rceCode = rceCode + "chainsaw.load_chains" + char(10)
        rceCode = rceCode + "chainsaw.crack(false)"

        rcomp.touch(rcePath, rceName + ".src")
        rf = rcomp.File(rcePath + "/" + rceName + ".src")
        if rf then
            rf.set_content(rceCode)
            print(c.grey + "  Building on target..." + c.ennd)
            buildRes = final.build(rcePath + "/" + rceName + ".src", rcePath)
            if typeof(buildRes) == "string" and buildRes != "" then
                print(c.yellow + "  Build failed: " + buildRes + c.ennd)
            else
                print(c.grey + "  Launching ChainSaw..." + c.ennd)
                final.launch(rcePath + "/" + rceName)
                wait(4)

                g = get_custom_object
                if g.hasIndex("chainsaw") and g.chainsaw != null and g.chainsaw.shell != null then
                    globals.object = g.chainsaw.shell
                    globals.remotePath = "/"
                    print(c.lime + "<b>[+] FINAL HOP ROOTED via ChainSaw!" + c.ennd)
                    print(c.gold + "   Password: " + g.chainsaw.password + c.ennd)
                end if
            end if
        end if
    end if

    print(c.green + "<b>Proxy is now active on final hop" + c.ennd)
    end function
