WStack = function(localMode)
    if localMode then
        // ── LOCAL MODE ────────────────────────────────────────────────────────
        targetIp = publicTarget
        if typeof(object) == "shell" then targetIp = object.host_computer.public_ip
        if typeof(object) == "computer" then targetIp = object.public_ip
        print(c.orange + "WStack local mode — discovering all LAN devices..." + c.ennd)
        ml = metaxploit.load("/lib/libhttp.so")
        if not ml then
            print(c.yellow + "<b>wstack -l: libhttp.so not found in /lib" + c.ennd)
            return
        end if

        // recursive device discovery
        deviceList = []
        getDevices = function(router)
            if router == null then return
            ip = router.local_ip
            if deviceList.indexOf(ip) == null then deviceList.push(ip)
            devices = router.devices_lan_ip
            if not devices then return
            for device in devices
                if device == ip then continue
                if deviceList.indexOf(device) != null then continue
                subRouter = get_router(device)
                subSwitch = get_switch(device)
                if subRouter then
                    deviceList.push(device)
                    getDevices(subRouter)
                else if subSwitch then
                    deviceList.push(device)
                    getDevices(subSwitch)
                else
                    deviceList.push(device)
                end if
            end for
        end function

        router = get_router
        if is_valid_ip(targetIp) and not is_lan_ip(targetIp) then router = get_router(targetIp)
        if not router then
            print(c.yellow + "<b>wstack -l: could not get local router" + c.ennd)
            return
        end if
        getDevices(router)

        // fill IP gaps
        gapList = []
        for existingIp in deviceList
            parts = existingIp.split(".")
            if parts.len < 4 then continue
            subnet = parts[0] + "." + parts[1] + "." + parts[2] + "."
            lastOctet = parts[3].to_int
            i = 1
            while i < lastOctet
                candidate = subnet + i
                if deviceList.indexOf(candidate) == null and gapList.indexOf(candidate) == null then
                    gapList.push(candidate)
                end if
                i = i + 1
            end while
        end for
        for gapIp in gapList
            deviceList.push(gapIp)
        end for

        print(c.cyan + "  found " + deviceList.len + " device(s)" + c.ennd)
        pushed = 0
        totalCracked = 0
        for lanIp in deviceList
            print(c.orange + "  bouncing to " + lanIp + " ..." + c.ennd)
            obj = ml.overflow("0x1F000FB5", "length", lanIp)
            if typeof(obj) != "computer" then continue
            // push to stack
            objectStack.push(obj)
            pushed = pushed + 1
            print(c.green + "  [+] pushed " + lanIp + " → stack [" + objectStack.len + "]" + c.ennd)
            // harvest credentials
            homeDir = obj.File("/home")
            if homeDir then
                for user in homeDir.get_folders
                    if user.name == "guest" then continue
                    for target in ["Mail.txt", "Bank.txt"]
                        hf = obj.File("/home/" + user.name + "/Config/" + target)
                        if not hf then continue
                        content = hf.get_content
                        if not content or content == "" then continue
                        for line in content.split(char(10))
                            if line == "" then continue
                            parts = line.split(":")
                            if parts.len < 2 then continue
                            pw = CrackHash(parts[1])
                            if pw then
                                print(c.lime + "  " + parts[0] + c.ennd + c.grey + " : " + c.ennd + c.gold + "<b>" + pw + c.ennd + c.grey + "  [" + lanIp + "/" + target + "]" + c.ennd)
                                totalCracked = totalCracked + 1
                            end if
                        end for
                    end for
                end for
            end if
            pf = obj.File("/etc/passwd")
            if pf and pf.has_permission("r") then
                content = pf.get_content
                if content and content != "" then
                    for line in content.split(char(10))
                        if line == "" then continue
                        parts = line.split(":")
                        if parts.len < 2 then continue
                        pw = CrackHash(parts[1])
                        if pw then
                            print(c.lime + "  " + parts[0] + c.ennd + c.grey + " : " + c.ennd + c.gold + "<b>" + pw + c.ennd + c.grey + "  [" + lanIp + " SSH]" + c.ennd)
                            totalCracked = totalCracked + 1
                        end if
                    end for
                end if
            end if
        end for

        div
        print(c.cyan + "wstack -l complete — " + pushed + " pushed to stack, " + totalCracked + " hash(es) cracked" + c.ennd)
        print(c.grey + "  use stack/swap/pop to access" + c.ennd)
        return
    end if

    // ── REMOTE MODE ───────────────────────────────────────────────────────────
    if typeof(object) != "shell" then
        print(c.yellow + "<b>wstack: not holding remote shell  (use wstack -l for local mode)" + c.ennd)
        return
    end if
    rcomp = object.host_computer
    pubIp = rcomp.public_ip
    lanIp = rcomp.local_ip

    // enumerate LAN from target's perspective via write-build-run (recursive)
    print(c.orange + "Enumerating LAN from target..." + c.ennd)
    rcomp.touch("/home/guest", "enum_lan.src")
    elSrc = rcomp.File("/home/guest/enum_lan.src")
    if elSrc then
        q = char(34)
        n = char(10)
        src = "gco = get_custom_object" + n
        src = src + "deviceList = []" + n
        src = src + "getDevices = function(router)" + n
        src = src + "  if router == null then return" + n
        src = src + "  ip = router.local_ip" + n
        src = src + "  if deviceList.indexOf(ip) == null then deviceList.push(ip)" + n
        src = src + "  devices = router.devices_lan_ip" + n
        src = src + "  if not devices then return" + n
        src = src + "  for device in devices" + n
        src = src + "    if device == ip then continue" + n
        src = src + "    if deviceList.indexOf(device) != null then continue" + n
        src = src + "    subRouter = get_router(device)" + n
        src = src + "    subSwitch = get_switch(device)" + n
        src = src + "    if subRouter then" + n
        src = src + "      deviceList.push(device)" + n
        src = src + "      getDevices(subRouter)" + n
        src = src + "    else if subSwitch then" + n
        src = src + "      deviceList.push(device)" + n
        src = src + "      getDevices(subSwitch)" + n
        src = src + "    else" + n
        src = src + "      deviceList.push(device)" + n
        src = src + "    end if" + n
        src = src + "  end for" + n
        src = src + "end function" + n
        src = src + "router = get_router" + n
        src = src + "if not router then exit()" + n
        src = src + "getDevices(router)" + n
        src = src + "gapList = []" + n
        src = src + "for existingIp in deviceList" + n
        src = src + "  parts = existingIp.split(" + q + "." + q + ")" + n
        src = src + "  if parts.len < 4 then continue" + n
        src = src + "  subnet = parts[0] + " + q + "." + q + " + parts[1] + " + q + "." + q + " + parts[2] + " + q + "." + q + n
        src = src + "  lastOctet = parts[3].to_int" + n
        src = src + "  i = 1" + n
        src = src + "  while i < lastOctet" + n
        src = src + "    candidate = subnet + i" + n
        src = src + "    if deviceList.indexOf(candidate) == null and gapList.indexOf(candidate) == null then" + n
        src = src + "      gapList.push(candidate)" + n
        src = src + "    end if" + n
        src = src + "    i = i + 1" + n
        src = src + "  end while" + n
        src = src + "end for" + n
        src = src + "for gapIp in gapList" + n
        src = src + "  deviceList.push(gapIp)" + n
        src = src + "end for" + n
        src = src + "gco.wbLanIps = deviceList.join(" + q + "," + q + ")" + n
        elSrc.set_content(src)
        object.build("/home/guest/enum_lan.src", "/home/guest", false)
        elBin = rcomp.File("/home/guest/enum_lan")
        if elBin then
            gco.wbLanIps = null
            object.launch("/home/guest/enum_lan")
            elSrc.delete
            elBin.delete
        else
            elSrc.delete
        end if
    end if

    lanTargets = []
    if gco.hasIndex("wbLanIps") and gco.wbLanIps then
        for ip in gco.wbLanIps.split(",")
            if ip != lanIp and ip != "" then lanTargets.push(ip)
        end for
        print(c.cyan + "  target sees " + lanTargets.len + " device(s): " + lanTargets.join(", ") + c.ennd)
    end if

    // fallback
    if lanTargets.len == 0 then
        router = get_router(pubIp)
        if not router then router = get_router(lanIp)
        if router then
            devices = router.devices_lan_ip
            if devices then
                for ip in devices
                    if ip != lanIp then lanTargets.push(ip)
                end for
            end if
        end if
    end if

    if lanTargets.len == 0 then
        print(c.yellow + "<b>wstack: no other LAN devices" + c.ennd)
        return
    end if
    print(c.cyan + "  found " + lanTargets.len + " target(s): " + lanTargets.join(", ") + c.ennd)

    // upload tools
    print(c.orange + "Uploading tools..." + c.ennd)
    me = get_shell
    me.scp(currentPath + "/metaxploit.so", "/home/guest", object)
    me.scp(currentPath + "/wb", "/home/guest", object)

    binFile = rcomp.File("/home/guest/wb")
    if not binFile then
        print(c.yellow + "<b>wstack: wb upload failed" + c.ennd)
        return
    end if

    // write bounce+harvest script (wsx) — same as weaklib's wbx but also stores objects
    print(c.orange + "Writing harvest script to target..." + c.ennd)
    rcomp.touch("/home/guest", "wsx.src")
    srcFile = rcomp.File("/home/guest/wsx.src")
    if not srcFile then
        print(c.yellow + "<b>wstack: could not write to /home/guest" + c.ennd)
        return
    end if

    q = char(34)
    n = char(10)
    harvSrc = "gco = get_custom_object" + n
    harvSrc = harvSrc + "selfPath = program_path.split(char(47))[:-1].join(char(47))" + n
    harvSrc = harvSrc + "metaxploit = include_lib(selfPath + char(47) + " + q + "metaxploit.so" + q + ")" + n
    harvSrc = harvSrc + "if not metaxploit then metaxploit = include_lib(" + q + "/lib/metaxploit.so" + q + ")" + n
    harvSrc = harvSrc + "if not metaxploit then exit(" + q + "no meta" + q + ")" + n
    harvSrc = harvSrc + "ml = metaxploit.load(" + q + "/lib/libhttp.so" + q + ")" + n
    harvSrc = harvSrc + "if not ml then exit(" + q + "no libhttp" + q + ")" + n
    harvSrc = harvSrc + "results = []" + n
    harvSrc = harvSrc + "objs = []" + n
    harvSrc = harvSrc + "ips = gco.wsIPs.split(" + q + "," + q + ")" + n
    harvSrc = harvSrc + "for lanIp in ips" + n
    harvSrc = harvSrc + "  obj = ml.overflow(" + q + "0x1F000FB5" + q + ", " + q + "length" + q + ", lanIp)" + n
    harvSrc = harvSrc + "  if typeof(obj) != " + q + "computer" + q + " then continue" + n
    harvSrc = harvSrc + "  objs.push(obj)" + n
    harvSrc = harvSrc + "  homeDir = obj.File(" + q + "/home" + q + ")" + n
    harvSrc = harvSrc + "  if not homeDir then continue" + n
    harvSrc = harvSrc + "  users = homeDir.get_folders" + n
    harvSrc = harvSrc + "  if not users then continue" + n
    harvSrc = harvSrc + "  for user in users" + n
    harvSrc = harvSrc + "    if user.name == " + q + "guest" + q + " then continue" + n
    harvSrc = harvSrc + "    for t in [" + q + "Mail.txt" + q + ", " + q + "Bank.txt" + q + "]" + n
    harvSrc = harvSrc + "      hf = obj.File(" + q + "/home/" + q + " + user.name + " + q + "/Config/" + q + " + t)" + n
    harvSrc = harvSrc + "      if not hf then continue" + n
    harvSrc = harvSrc + "      content = hf.get_content" + n
    harvSrc = harvSrc + "      if not content or content == " + q + q + " then continue" + n
    harvSrc = harvSrc + "      for line in content.split(char(10))" + n
    harvSrc = harvSrc + "        if line != " + q + q + " then results.push(lanIp + char(1) + user.name + char(1) + t + char(1) + line)" + n
    harvSrc = harvSrc + "      end for" + n
    harvSrc = harvSrc + "    end for" + n
    harvSrc = harvSrc + "  end for" + n
    harvSrc = harvSrc + "  pf = obj.File(" + q + "/etc/passwd" + q + ")" + n
    harvSrc = harvSrc + "  if pf and pf.has_permission(" + q + "r" + q + ") then" + n
    harvSrc = harvSrc + "    pc = pf.get_content" + n
    harvSrc = harvSrc + "    if pc and pc != " + q + q + " then" + n
    harvSrc = harvSrc + "      for line in pc.split(char(10))" + n
    harvSrc = harvSrc + "        if line != " + q + q + " then results.push(lanIp + char(1) + " + q + "system" + q + " + char(1) + " + q + "passwd" + q + " + char(1) + line)" + n
    harvSrc = harvSrc + "      end for" + n
    harvSrc = harvSrc + "    end if" + n
    harvSrc = harvSrc + "  end if" + n
    harvSrc = harvSrc + "end for" + n
    harvSrc = harvSrc + "gco.wbResults = results.join(char(10))" + n
    harvSrc = harvSrc + "gco.wbCount = results.len" + n
    harvSrc = harvSrc + "gco.wsObjects = objs" + n
    harvSrc = harvSrc + "gco.wsCount = objs.len" + n

    srcFile.set_content(harvSrc)
    print(c.orange + "Building on target..." + c.ennd)
    object.build("/home/guest/wsx.src", "/home/guest", false)
    binFile2 = rcomp.File("/home/guest/wsx")
    if not binFile2 then
        print(c.yellow + "<b>wstack: build failed" + c.ennd)
        srcFile.delete
        binFile.delete
        mxf = rcomp.File("/home/guest/metaxploit.so")
        if mxf then mxf.delete
        return
    end if

    gco.wsIPs = lanTargets.join(",")
    gco.wbResults = null
    gco.wbCount = 0
    gco.wsObjects = null
    gco.wsCount = 0
    print(c.orange + "Running on target..." + c.ennd)
    object.launch("/home/guest/wsx")

    // cleanup
    srcFile.delete
    binFile2.delete
    binFile.delete
    mxf = rcomp.File("/home/guest/metaxploit.so")
    if mxf then mxf.delete

    // push objects to stack
    pushed = 0
    if gco.wsObjects and gco.wsCount > 0 then
        for obj in gco.wsObjects
            if typeof(obj) != "computer" then continue
            objectStack.push(obj)
            pushed = pushed + 1
            print(c.green + "  [+] pushed " + obj.local_ip + " → stack [" + objectStack.len + "]" + c.ennd)
        end for
    end if

    // crack harvested hashes
    totalCracked = 0
    if gco.wbResults and gco.wbResults != "" then
        for rline in gco.wbResults.split(char(10))
            if rline == "" then continue
            rparts = rline.split(char(1))
            if rparts.len < 4 then continue
            bounceIp = rparts[0]
            userName = rparts[1]
            fileName = rparts[2]
            hashLine = rparts[3]
            hparts = hashLine.split(":")
            if hparts.len < 2 then continue
            pw = CrackHash(hparts[1])
            if pw then
                if fileName == "passwd" then
                    print(c.lime + "  " + hparts[0] + c.ennd + c.grey + " : " + c.ennd + c.gold + "<b>" + pw + c.ennd + c.grey + "  [" + bounceIp + " SSH]" + c.ennd)
                else
                    print(c.lime + "  " + hparts[0] + c.ennd + c.grey + " : " + c.ennd + c.gold + "<b>" + pw + c.ennd + c.grey + "  [" + bounceIp + "/" + userName + "/" + fileName + "]" + c.ennd)
                end if
                totalCracked = totalCracked + 1
            end if
        end for
    end if

    div
    print(c.cyan + "wstack complete — " + pushed + " pushed to stack, " + totalCracked + "/" + gco.wbCount + " hashes cracked across " + lanTargets.len + " device(s)" + c.ennd)
    print(c.grey + "  use stack/swap/pop to access" + c.ennd)
end function

WeakLib = function(localMode)
    if typeof(object) != "shell" then
        print(c.yellow + "<b>weaklib: not holding remote shell" + c.ennd)
        return
    end if

    if localMode then
        // local mode — load libhttp.so directly, no remote shell needed
        targetIp = publicTarget
        if typeof(object) == "shell" then targetIp = object.host_computer.public_ip
        if typeof(object) == "computer" then targetIp = object.public_ip
        if not is_valid_ip(targetIp) then
            print(c.yellow + "<b>weaklib -l: no target — set a public target first or grab a shell" + c.ennd)
            return
        end if
        print(c.orange + "WeakLib local mode — discovering all LAN devices..." + c.ennd)
        ml = metaxploit.load("/lib/libhttp.so")
        if not ml then
            print(c.yellow + "<b>weaklib -l: libhttp.so not found in /lib" + c.ennd)
            return
        end if
        targetIp = publicTarget
        if typeof(object) == "shell" then targetIp = object.host_computer.public_ip
        if typeof(object) == "computer" then targetIp = object.public_ip

        // recursive device discovery
        deviceList = []
        getDevicesLocal = function(router)
            if router == null then return
            ip = router.local_ip
            if deviceList.indexOf(ip) == null then deviceList.push(ip)
            devices = router.devices_lan_ip
            if not devices then return
            for device in devices
                if device == ip then continue
                if deviceList.indexOf(device) != null then continue
                subRouter = get_router(device)
                subSwitch = get_switch(device)
                if subRouter then
                    deviceList.push(device)
                    getDevicesLocal(subRouter)
                else if subSwitch then
                    deviceList.push(device)
                    getDevicesLocal(subSwitch)
                else
                    deviceList.push(device)
                end if
            end for
        end function

        router = get_router
        if is_valid_ip(targetIp) and not is_lan_ip(targetIp) then router = get_router(targetIp)
        if not router then
            print(c.yellow + "<b>weaklib -l: could not reach router" + c.ennd)
            return
        end if
        getDevicesLocal(router)

        // fill gaps
        gapList = []
        for existingIp in deviceList
            parts = existingIp.split(".")
            if parts.len < 4 then continue
            subnet = parts[0] + "." + parts[1] + "." + parts[2] + "."
            lastOctet = parts[3].to_int
            i = 1
            while i < lastOctet
                candidate = subnet + i
                if deviceList.indexOf(candidate) == null and gapList.indexOf(candidate) == null then
                    gapList.push(candidate)
                end if
                i = i + 1
            end while
        end for
        for gapIp in gapList
            deviceList.push(gapIp)
        end for

        print(c.cyan + "  found " + deviceList.len + " device(s)" + c.ennd)
        totalCracked = 0
        for lanTarget in deviceList
            print(c.orange + "  bouncing to " + lanTarget + " ..." + c.ennd)
            obj = ml.overflow("0x1F000FB5", "length", lanTarget)
            if typeof(obj) != "computer" then continue
            // harvest
            homeDir = obj.File("/home")
            if homeDir then
                for user in homeDir.get_folders
                    if user.name == "guest" then continue
                    for target in ["Mail.txt", "Bank.txt"]
                        hf = obj.File("/home/" + user.name + "/Config/" + target)
                        if not hf then continue
                        content = hf.get_content
                        if not content or content == "" then continue
                        for line in content.split(char(10))
                            if line == "" then continue
                            parts = line.split(":")
                            if parts.len < 2 then continue
                            pw = CrackHash(parts[1])
                            if pw then
                                print(c.lime + "  " + parts[0] + c.ennd + c.grey + " : " + c.ennd + c.gold + "<b>" + pw + c.ennd + c.grey + "  [" + lanTarget + "/" + target + "]" + c.ennd)
                                totalCracked = totalCracked + 1
                            end if
                        end for
                    end for
                end for
            end if
            pf = obj.File("/etc/passwd")
            if pf and pf.has_permission("r") then
                content = pf.get_content
                if content and content != "" then
                    for line in content.split(char(10))
                        if line == "" then continue
                        parts = line.split(":")
                        if parts.len < 2 then continue
                        pw = CrackHash(parts[1])
                        if pw then
                            print(c.lime + "  " + parts[0] + c.ennd + c.grey + " : " + c.ennd + c.gold + "<b>" + pw + c.ennd + c.grey + "  [" + lanTarget + " SSH]" + c.ennd)
                            totalCracked = totalCracked + 1
                        end if
                    end for
                end if
            end if
        end for
        div
        print(c.cyan + "weaklib -l complete — cracked " + totalCracked + " hash(es)" + c.ennd)
        return
    end if
    rcomp = object.host_computer
    pubIp = rcomp.public_ip
    lanIp = rcomp.local_ip

    // enumerate LAN from TARGET's perspective via write-build-run with recursive discovery
    print(c.orange + "Enumerating LAN from target..." + c.ennd)
    rcomp.touch("/home/guest", "enum_lan.src")
    elSrc = rcomp.File("/home/guest/enum_lan.src")
    if elSrc then
        q = char(34)
        n = char(10)
        src = "gco = get_custom_object" + n
        src = src + "deviceList = []" + n
        src = src + "getDevices = function(router)" + n
        src = src + "  if router == null then return" + n
        src = src + "  ip = router.local_ip" + n
        src = src + "  if deviceList.indexOf(ip) == null then deviceList.push(ip)" + n
        src = src + "  devices = router.devices_lan_ip" + n
        src = src + "  if not devices then return" + n
        src = src + "  for device in devices" + n
        src = src + "    if device == ip then continue" + n
        src = src + "    if deviceList.indexOf(device) != null then continue" + n
        src = src + "    subRouter = get_router(device)" + n
        src = src + "    subSwitch = get_switch(device)" + n
        src = src + "    if subRouter then" + n
        src = src + "      deviceList.push(device)" + n
        src = src + "      getDevices(subRouter)" + n
        src = src + "    else if subSwitch then" + n
        src = src + "      deviceList.push(device)" + n
        src = src + "      getDevices(subSwitch)" + n
        src = src + "    else" + n
        src = src + "      deviceList.push(device)" + n
        src = src + "    end if" + n
        src = src + "  end for" + n
        src = src + "end function" + n
        src = src + "router = get_router" + n
        src = src + "if not router then exit()" + n
        src = src + "getDevices(router)" + n
        src = src + "gco.wbLanIps = deviceList.join(" + q + "," + q + ")" + n
        elSrc.set_content(src)
        object.build("/home/guest/enum_lan.src", "/home/guest", false)
        elBin = rcomp.File("/home/guest/enum_lan")
        if elBin then
            gco.wbLanIps = null
            object.launch("/home/guest/enum_lan")
            elSrc.delete
            elBin.delete
        else
            elSrc.delete
        end if
    end if

    lanTargets = []
    if gco.hasIndex("wbLanIps") and gco.wbLanIps then
        for ip in gco.wbLanIps.split(",")
            if ip != lanIp and ip != "" then lanTargets.push(ip)
        end for
        print(c.cyan + "  target sees " + lanTargets.len + " device(s): " + lanTargets.join(", ") + c.ennd)
    end if

    // fallback to our own router view if nothing found
    if lanTargets.len == 0 then
        router = get_router(pubIp)
        if not router then router = get_router(lanIp)
        if router then
            devices = router.devices_lan_ip
            if devices then
                for ip in devices
                    if ip != lanIp then lanTargets.push(ip)
                end for
            end if
        end if
    end if

    if lanTargets.len == 0 then
        print(c.yellow + "<b>weaklib: no other LAN devices" + c.ennd)
        return
    end if
    print(c.cyan + "  found " + lanTargets.len + " target(s): " + lanTargets.join(", ") + c.ennd)

    // upload metaxploit.so to /home/guest for wbx to use
    print(c.orange + "Uploading tools..." + c.ennd)
    me = get_shell
    me.scp(currentPath + "/metaxploit.so", "/home/guest", object)
    me.scp(currentPath + "/wb", "/home/guest", object)

    binFile = rcomp.File("/home/guest/wb")
    if not binFile then
        print(c.yellow + "<b>weaklib: wb upload failed" + c.ennd)
        return
    end if

    // write harvest script to router using write-build-run
    print(c.orange + "Writing harvest script to target..." + c.ennd)
    rcomp.touch("/home/guest", "wbx.src")
    srcFile = rcomp.File("/home/guest/wbx.src")
    if not srcFile then
        print(c.yellow + "<b>weaklib: could not write to /home/guest" + c.ennd)
        return
    end if

    q = char(34)
    n = char(10)
    harvSrc = "gco = get_custom_object" + n
    harvSrc = harvSrc + "selfPath = program_path.split(char(47))[:-1].join(char(47))" + n
    harvSrc = harvSrc + "metaxploit = include_lib(selfPath + char(47) + " + q + "metaxploit.so" + q + ")" + n
    harvSrc = harvSrc + "if not metaxploit then metaxploit = include_lib(" + q + "/lib/metaxploit.so" + q + ")" + n
    harvSrc = harvSrc + "if not metaxploit then exit(" + q + "no meta" + q + ")" + n
    harvSrc = harvSrc + "ml = metaxploit.load(" + q + "/lib/libhttp.so" + q + ")" + n
    harvSrc = harvSrc + "if not ml then exit(" + q + "no libhttp" + q + ")" + n
    harvSrc = harvSrc + "results = []" + n
    harvSrc = harvSrc + "ips = gco.wbIPs.split(" + q + "," + q + ")" + n
    harvSrc = harvSrc + "for lanIp in ips" + n
    harvSrc = harvSrc + "  obj = ml.overflow(" + q + "0x1F000FB5" + q + ", " + q + "length" + q + ", lanIp)" + n
    harvSrc = harvSrc + "  if typeof(obj) != " + q + "computer" + q + " then continue" + n
    harvSrc = harvSrc + "  homeDir = obj.File(" + q + "/home" + q + ")" + n
    harvSrc = harvSrc + "  if not homeDir then continue" + n
    harvSrc = harvSrc + "  users = homeDir.get_folders" + n
    harvSrc = harvSrc + "  if not users then continue" + n
    harvSrc = harvSrc + "  for user in users" + n
    harvSrc = harvSrc + "    if user.name == " + q + "guest" + q + " then continue" + n
    harvSrc = harvSrc + "    for t in [" + q + "Mail.txt" + q + ", " + q + "Bank.txt" + q + "]" + n
    harvSrc = harvSrc + "      hf = obj.File(" + q + "/home/" + q + " + user.name + " + q + "/Config/" + q + " + t)" + n
    harvSrc = harvSrc + "      if not hf then continue" + n
    harvSrc = harvSrc + "      content = hf.get_content" + n
    harvSrc = harvSrc + "      if not content or content == " + q + q + " then continue" + n
    harvSrc = harvSrc + "      for line in content.split(char(10))" + n
    harvSrc = harvSrc + "        if line != " + q + q + " then results.push(lanIp + char(1) + user.name + char(1) + t + char(1) + line)" + n
    harvSrc = harvSrc + "      end for" + n
    harvSrc = harvSrc + "    end for" + n
    harvSrc = harvSrc + "  end for" + n
    harvSrc = harvSrc + "  pf = obj.File(" + q + "/etc/passwd" + q + ")" + n
    harvSrc = harvSrc + "  if pf and pf.has_permission(" + q + "r" + q + ") then" + n
    harvSrc = harvSrc + "    pc = pf.get_content" + n
    harvSrc = harvSrc + "    if pc and pc != " + q + q + " then" + n
    harvSrc = harvSrc + "      for line in pc.split(char(10))" + n
    harvSrc = harvSrc + "        if line != " + q + q + " then results.push(lanIp + char(1) + " + q + "system" + q + " + char(1) + " + q + "passwd" + q + " + char(1) + line)" + n
    harvSrc = harvSrc + "      end for" + n
    harvSrc = harvSrc + "    end if" + n
    harvSrc = harvSrc + "  end if" + n
    harvSrc = harvSrc + "  obj.touch(" + q + "/home/guest" + q + ", " + q + "system.log" + q + ")" + n
    harvSrc = harvSrc + "  tmp = obj.File(" + q + "/home/guest/system.log" + q + ")" + n
    harvSrc = harvSrc + "  if tmp then" + n
    harvSrc = harvSrc + "    tmp.move(" + q + "/var" + q + ", " + q + "system.log" + q + ")" + n
    harvSrc = harvSrc + "    lf = obj.File(" + q + "/var/system.log" + q + ")" + n
    harvSrc = harvSrc + "    if lf and not lf.is_binary then lf.set_owner(" + q + "root" + q + ")" + n
    harvSrc = harvSrc + "  end if" + n
    harvSrc = harvSrc + "end for" + n
    harvSrc = harvSrc + "gco.wbResults = results.join(char(10))" + n
    harvSrc = harvSrc + "gco.wbCount = results.len" + n

    srcFile.set_content(harvSrc)
    print(c.orange + "Building on target..." + c.ennd)
    object.build("/home/guest/wbx.src", "/home/guest", false)
    binFile2 = rcomp.File("/home/guest/wbx")
    if not binFile2 then
        print(c.yellow + "<b>weaklib: build failed on target" + c.ennd)
        srcFile.delete
        binFile.delete
        mxf = rcomp.File("/home/guest/metaxploit.so")
        if mxf then mxf.delete
        return
    end if

    gco.wbIPs = lanTargets.join(",")
    gco.wbResults = null
    gco.wbCount = 0
    print(c.orange + "Running harvest on target..." + c.ennd)
    object.launch("/home/guest/wbx")

    // cleanup
    srcFile.delete
    binFile2.delete
    binFile.delete
    mxf = rcomp.File("/home/guest/metaxploit.so")
    if mxf then mxf.delete

    print(c.grey + "  wb found " + gco.wbCount + " credential line(s)" + c.ennd)

    if not gco.wbResults or gco.wbResults == "" then
        print(c.yellow + "<b>weaklib: no credentials found" + c.ennd)
        return
    end if

    // parse and decipher
    totalCracked = 0
    rlines = gco.wbResults.split(char(10))
    for rline in rlines
        if rline == "" then continue
        rparts = rline.split(char(1))
        if rparts.len < 4 then continue
        bounceIp = rparts[0]
        userName = rparts[1]
        fileName = rparts[2]
        hashLine = rparts[3]
        hparts = hashLine.split(":")
        if hparts.len < 2 then continue
        pw = CrackHash(hparts[1])
        if pw then
            if fileName == "passwd" then
                // SSH credential
                print(c.lime + "  " + hparts[0] + c.ennd + c.grey + " : " + c.ennd + c.gold + "<b>" + pw + c.ennd + c.grey + "  [" + bounceIp + " SSH]" + c.ennd)
            else
                print(c.lime + "  " + hparts[0] + c.ennd + c.grey + " : " + c.ennd + c.gold + "<b>" + pw + c.ennd + c.grey + "  [" + bounceIp + "/" + userName + "/" + fileName + "]" + c.ennd)
            end if
            totalCracked = totalCracked + 1
        end if
    end for

    div
    print(c.cyan + "weaklib complete — cracked " + totalCracked + "/" + gco.wbCount + " hashes across " + lanTargets.len + " device(s)" + c.ennd)

    // enumerate each bounced computer's own router for deeper LAN discovery
    print(c.orange + char(10) + "Enumerating deep LAN..." + c.ennd)
    deepFound = 0
    for bounceIp in lanTargets
        ml = metaxploit.load("/lib/libhttp.so")
        if not ml then continue
        obj = ml.overflow("0x1F000FB5", "length", bounceIp)
        if typeof(obj) != "computer" then continue

        // try both public and local IP to find all routers this computer can see
        routersToCheck = []
        r1 = get_router(obj.public_ip)
        r2 = get_router(obj.local_ip)
        if r1 then routersToCheck.push(r1)
        if r2 and r2 != r1 then routersToCheck.push(r2)

        for subRouter in routersToCheck
            subDevices = subRouter.devices_lan_ip
            if not subDevices then continue
            for subIp in subDevices
                if subIp != obj.local_ip and subIp != bounceIp then
                    print(c.grey + "  " + subIp + c.ennd + c.grey + " (via " + bounceIp + " router:" + subRouter.local_ip + " pub:" + obj.public_ip + ")" + c.ennd)
                    deepFound = deepFound + 1
                end if
            end for
        end for
    end for
    if deepFound > 0 then
        print(c.gold + "  " + deepFound + " deep LAN target(s) discovered — use scan/grab to exploit" + c.ennd)
    else
        print(c.grey + "  no additional LAN targets found" + c.ennd)
    end if
end function
// autoharvest.src  |  phantom module  |  fully automated attack loop
// proxy -> scan -> grab -> autoroot -> harvest -> cover -> repeat

AutoHarvest = function(hops, maxTargets)
    if typeof(hops) != "number" or hops < 1 then hops = 1
    if typeof(maxTargets) != "number" or maxTargets < 1 then maxTargets = 5

    print(char(10) + c.cyan + "<b>AUTOHARVEST" + c.ennd)
    print(c.grey + "  hops: " + hops + "  max targets: " + maxTargets + c.ennd)
    print(c.grey + "----------------------------------------------------------------" + c.ennd)

    totalCracked = 0
    totalTargets = 0
    attempts     = 0
    maxAttempts  = maxTargets * 30

    // make sure rt files exist
    rtDir = myComp.File(currentPath + "/rt")
    if not rtDir then
        print(c.orange + "No rt folder — running rtgen first..." + c.ennd)
        RTGen()
    end if

    while totalTargets < maxTargets and attempts < maxAttempts
        attempts = attempts + 1
        print(char(10) + c.orange + "── target " + (totalTargets + 1) + "/" + maxTargets + " ──────────────────────────────────────" + c.ennd)

        // ── step 1: build proxy chain ──────────────────────────
        print(c.grey + "  [1/5] building " + hops + " hop proxy chain..." + c.ennd)
        chain = []
        chainAttempts = 0
        while chain.len < hops and chainAttempts < hops * 20
            chainAttempts = chainAttempts + 1
            a = floor(rnd * 256)
            b = floor(rnd * 256)
            d = floor(rnd * 256)
            e = floor(rnd * 256)
            ip = a + "." + b + "." + d + "." + e
            if not is_valid_ip(ip) then continue
            if is_lan_ip(ip) then continue
            ns = metaxploit.net_use(ip, 0)
            if not ns then continue
            ml = ns.dump_lib
            if not ml then continue
            if ml.is_patched then continue
            mems = metaxploit.scan(ml)
            if not mems then continue
            shell = null
            for mem in mems
                if shell then break
                addrs = metaxploit.scan_address(ml, mem).split("Unsafe check: ")
                for addr in addrs
                    if shell then break
                    if addr == addrs[0] then continue
                    val = addr[addr.indexOf("<b>") + 3 : addr.indexOf("</b>")]
                    obj = ml.overflow(mem, val)
                    if typeof(obj) == "shell" or typeof(obj) == "computer" then shell = obj
                end for
            end for
            if not shell then continue
            chain.push(shell)
        end while

        if chain.len == 0 then
            print(c.yellow + "  proxy: no hops found — skipping" + c.ennd)
            continue
        end if

        // set last hop as active object
        globals.object = chain[chain.len - 1]
        globals.remotePath = "/"
        if typeof(object) == "shell" then
            proxyIp = object.host_computer.public_ip
        else
            proxyIp = object.public_ip
        end if
        print(c.green + "  proxy ready: " + chain.len + " hop(s) via " + proxyIp + c.ennd)

        // ── step 2: find a target ──────────────────────────────
        print(c.grey + "  [2/5] scanning for target..." + c.ennd)
        targetShell = null
        targetIp    = ""
        scanAttempts = 0
        while not targetShell and scanAttempts < 30
            scanAttempts = scanAttempts + 1
            a = floor(rnd * 256)
            b = floor(rnd * 256)
            d = floor(rnd * 256)
            e = floor(rnd * 256)
            ip = a + "." + b + "." + d + "." + e
            if not is_valid_ip(ip) then continue
            if is_lan_ip(ip) then continue
            router = get_router(ip)
            if not router then continue
            ports = router.used_ports
            if not ports or ports.len == 0 then continue
            for p in ports
                if targetShell then break
                ns = metaxploit.net_use(ip, p.port_number)
                if not ns then continue
                ml = ns.dump_lib
                if not ml then continue
                if ml.is_patched then continue
                mems = metaxploit.scan(ml)
                if not mems then continue
                for mem in mems
                    if targetShell then break
                    addrs = metaxploit.scan_address(ml, mem).split("Unsafe check: ")
                    for addr in addrs
                        if targetShell then break
                        if addr == addrs[0] then continue
                        val = addr[addr.indexOf("<b>") + 3 : addr.indexOf("</b>")]
                        obj = ml.overflow(mem, val)
                        if typeof(obj) == "shell" then
                            targetShell = obj
                            targetIp = ip
                            EdbAdd(ml.lib_name, ml.version, mem, val)
                        end if
                    end for
                end for
            end for
        end while

        if not targetShell then
            print(c.yellow + "  no exploitable target found — skipping" + c.ennd)
            globals.object = null
            continue
        end if

        globals.object = targetShell
        globals.remotePath = "/"
        print(c.green + "  target: " + targetIp + c.ennd)

        // ── step 3: autoroot ───────────────────────────────────
        print(c.grey + "  [3/5] attempting autoroot..." + c.ennd)
        globals.object = targetShell
        globals.remotePath = "/"
        AutoRoot(null, null, null)
        rooted = typeof(object) == "shell"

        if not rooted then
            print(c.yellow + "  could not root " + targetIp + " — skipping" + c.ennd)
            globals.object = null
            continue
        end if
        print(c.green + "  rooted: " + targetIp + c.ennd)

        // ── step 4: harvest ────────────────────────────────────
        print(c.grey + "  [4/5] harvesting credentials..." + c.ennd)
        rcomp = globals.object.host_computer
        homeDir = rcomp.File("/home")
        harvested = 0
        if homeDir then
            users = homeDir.get_folders
            if users then
                for user in users
                    for target in ["Mail.txt", "Bank.txt"]
                        hf = rcomp.File("/home/" + user.name + "/Config/" + target)
                        if not hf then continue
                        if not hf.has_permission("r") then continue
                        content = hf.get_content
                        if not content or content == "" then continue
                        hlines = content.split(char(10))
                        for hline in hlines
                            if hline == "" then continue
                            hparts = hline.split(":")
                            if hparts.len < 2 then continue
                            pw = CrackHash(hparts[1])
                            if pw then
                                print(c.lime + "    " + hparts[0] + c.ennd + c.grey + " : " + c.ennd + c.gold + "<b>" + pw + c.ennd + c.grey + "  [" + user.name + "/" + target + "]" + c.ennd)
                                totalCracked = totalCracked + 1
                                harvested = harvested + 1
                            end if
                        end for
                    end for
                end for
            end if
        end if
        print(c.cyan + "  harvested " + harvested + " credential(s) from " + targetIp + c.ennd)

        // ── step 5: cover ──────────────────────────────────────
        print(c.grey + "  [5/5] covering tracks..." + c.ennd)
        tcomp = globals.object.host_computer
        test = tcomp.touch("/home/guest", "system.log")
        if test != false then
            lf2 = tcomp.File("/home/guest/system.log")
            if lf2 then
                res = lf2.move("/var", "system.log")
                if res != "permission denied" then
                    lf3 = tcomp.File("/var/system.log")
                    if lf3 and not lf3.is_binary then
                        lf3.set_owner("root")
                        lf3.set_group("root")
                        lf3.chmod("o-w")
                        lf3.chmod("g-w")
                        print(c.green + "  system.log corrupted" + c.ennd)
                    end if
                end if
            end if
        end if

        globals.object = null
        globals.remotePath = "/"
        totalTargets = totalTargets + 1
    end while

    print(char(10) + c.grey + "================================================================" + c.ennd)
    print(c.cyan + "<b>AUTOHARVEST COMPLETE" + c.ennd)
    print(c.gold + "  targets hit  : " + totalTargets + c.ennd)
    print(c.gold + "  creds cracked: " + totalCracked + c.ennd)
    print(c.grey + "================================================================" + c.ennd)
end function

// ── Siphon ───────────────────────────────────────────────────────
// network-wide credential harvest + operations
// runs from router shell context via write-build-run

Siphon = function(flag)
    if typeof(object) != "shell" then
        print(c.yellow + "<b>siphon: not holding remote shell" + c.ennd)
        return
    end if
    rcomp = object.host_computer

    // upload metaxploit to router
    me = get_shell
    me.scp(globals.currentPath + "/metaxploit.so", "/home/guest", object)

    // build siphon script to run ON the router
    q = char(34)
    n = char(10)

    src = "gco = get_custom_object" + n
    src = src + "selfPath = program_path.split(char(47))[:-1].join(char(47))" + n
    src = src + "metaxploit = include_lib(selfPath + char(47) + " + q + "metaxploit.so" + q + ")" + n
    src = src + "if not metaxploit then metaxploit = include_lib(" + q + "/lib/metaxploit.so" + q + ")" + n
    src = src + "if not metaxploit then exit()" + n
    src = src + "ml = metaxploit.load(" + q + "/lib/libhttp.so" + q + ")" + n
    src = src + "if not ml then exit()" + n
    // recursive device discovery
    src = src + "deviceList = []" + n
    src = src + "getDevices = function(router)" + n
    src = src + "  if router == null then return" + n
    src = src + "  ip = router.local_ip" + n
    src = src + "  if deviceList.indexOf(ip) == null then deviceList.push(ip)" + n
    src = src + "  devices = router.devices_lan_ip" + n
    src = src + "  if not devices then return" + n
    src = src + "  for device in devices" + n
    src = src + "    if device == ip then continue" + n
    src = src + "    if deviceList.indexOf(device) != null then continue" + n
    src = src + "    subRouter = get_router(device)" + n
    src = src + "    subSwitch = get_switch(device)" + n
    src = src + "    if subRouter then" + n
    src = src + "      deviceList.push(device)" + n
    src = src + "      getDevices(subRouter)" + n
    src = src + "    else if subSwitch then" + n
    src = src + "      deviceList.push(device)" + n
    src = src + "      getDevices(subSwitch)" + n
    src = src + "    else" + n
    src = src + "      deviceList.push(device)" + n
    src = src + "    end if" + n
    src = src + "  end for" + n
    src = src + "end function" + n
    src = src + "router = get_router" + n
    src = src + "if not router then exit()" + n
    src = src + "getDevices(router)" + n
    src = src + "results = []" + n
    src = src + "for lanIp in deviceList" + n
    src = src + "  obj = ml.overflow(" + q + "0x1F000FB5" + q + ", " + q + "length" + q + ", lanIp)" + n
    src = src + "  if typeof(obj) != " + q + "computer" + q + " then continue" + n

    if flag == "-l" then
        // corrupt logs
        src = src + "  obj.touch(" + q + "/home/guest" + q + ", " + q + "system.log" + q + ")" + n
        src = src + "  tmp = obj.File(" + q + "/home/guest/system.log" + q + ")" + n
        src = src + "  if tmp then tmp.move(" + q + "/var" + q + ", " + q + "system.log" + q + ")" + n
        src = src + "  results.push(lanIp + " + q + "|log_corrupted" + q + ")" + n
    else if flag == "-n" then
        // nuke — delete sensitive files
        src = src + "  for path in [" + q + "/home" + q + "]" + n
        src = src + "    hd = obj.File(path)" + n
        src = src + "    if not hd then continue" + n
        src = src + "    for user in hd.get_folders" + n
        src = src + "      for fname in [" + q + "Mail.txt" + q + ", " + q + "Bank.txt" + q + "]" + n
        src = src + "        f = obj.File(path + " + q + "/" + q + " + user.name + " + q + "/Config/" + q + " + fname)" + n
        src = src + "        if f then f.delete" + n
        src = src + "      end for" + n
        src = src + "    end for" + n
        src = src + "  end for" + n
        src = src + "  results.push(lanIp + " + q + "|nuked" + q + ")" + n
    else
        // harvest — mail, bank, passwd
        src = src + "  hd = obj.File(" + q + "/home" + q + ")" + n
        src = src + "  if hd then" + n
        src = src + "    for user in hd.get_folders" + n
        src = src + "      if user.name == " + q + "guest" + q + " then continue" + n
        src = src + "      for fname in [" + q + "Mail.txt" + q + ", " + q + "Bank.txt" + q + "]" + n
        src = src + "        hf = obj.File(" + q + "/home/" + q + " + user.name + " + q + "/Config/" + q + " + fname)" + n
        src = src + "        if not hf then continue" + n
        src = src + "        content = hf.get_content" + n
        src = src + "        if not content or content == " + q + q + " then continue" + n
        src = src + "        for line in content.split(char(10))" + n
        src = src + "          if line != " + q + q + " then results.push(lanIp + char(1) + fname + char(1) + line)" + n
        src = src + "        end for" + n
        src = src + "      end for" + n
        src = src + "    end for" + n
        src = src + "  end if" + n
        if flag == "-p" or flag == "-a" then
            src = src + "  pf = obj.File(" + q + "/etc/passwd" + q + ")" + n
            src = src + "  if pf and pf.has_permission(" + q + "r" + q + ") then" + n
            src = src + "    content = pf.get_content" + n
            src = src + "    if content then" + n
            src = src + "      for line in content.split(char(10))" + n
            src = src + "        if line != " + q + q + " then results.push(lanIp + char(1) + " + q + "passwd" + q + " + char(1) + line)" + n
            src = src + "      end for" + n
            src = src + "    end if" + n
            src = src + "  end if" + n
        end if
    end if

    src = src + "end for" + n
    src = src + "gco.siphonResults = results.join(char(10))" + n

    // write build run on router
    rcomp.touch("/home/guest", "siphon.src")
    sf = rcomp.File("/home/guest/siphon.src")
    if not sf then
        print(c.yellow + "<b>siphon: could not write script" + c.ennd)
        return
    end if
    sf.set_content(src)
    object.build("/home/guest/siphon.src", "/home/guest", false)
    bf = rcomp.File("/home/guest/siphon")
    if not bf then
        print(c.yellow + "<b>siphon: build failed" + c.ennd)
        sf.delete
        return
    end if

    print(c.orange + "Siphoning network..." + c.ennd)
    gco.siphonResults = null
    object.launch("/home/guest/siphon")
    sf.delete
    bf.delete
    mxf = rcomp.File("/home/guest/metaxploit.so")
    if mxf then mxf.delete

    if not gco.siphonResults or gco.siphonResults == "" then
        print(c.yellow + "<b>siphon: no results" + c.ennd)
        return
    end if

    // display results
    if flag == "-l" or flag == "-n" then
        for line in gco.siphonResults.split(char(10))
            if line == "" then continue
            parts = line.split("|")
            if parts.len < 2 then continue
            print(c.green + "  [+] " + parts[0] + "  " + parts[1] + c.ennd)
        end for
    else
        cracked = 0
        for line in gco.siphonResults.split(char(10))
            if line == "" then continue
            parts = line.split(char(1))
            if parts.len < 3 then continue
            lanIp = parts[0]
            fname = parts[1]
            entry = parts[2]
            hparts = entry.split(":")
            if hparts.len < 2 then continue
            pw = CrackHash(hparts[1])
            if pw then
                tag = "[" + lanIp + "/" + fname + "]"
                if fname == "passwd" then tag = "[" + lanIp + " SSH]"
                print(c.lime + "  " + hparts[0] + c.ennd + c.grey + " : " + c.ennd + c.gold + "<b>" + pw + c.ennd + c.grey + "  " + tag + c.ennd)
                cracked = cracked + 1
            end if
        end for
        div
        print(c.cyan + "siphon complete — cracked " + cracked + " hash(es)" + c.ennd)
    end if
end function
