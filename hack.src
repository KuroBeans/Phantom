// ================================================================
//  hack.src  |  phantom module  |  hacking pipeline consolidation
// ================================================================
// This module provides high-level hacking orchestration.
// Low-level functions (Scan, Grab, etc.) are in core.src
// Network functions (NetMap, HackLan, etc.) are in recon.src
// Privilege escalation and stealth functions are in ops.src
// Remote execution and lib operations are in remote.src

// ── ScanLib (wrapper) ─────────────────────────────────────────
// Scan a target's libraries without grabbing yet
WStack = function(localMode)
    if localMode then
        // ── LOCAL MODE ────────────────────────────────────────────────────────
        targetIp = publicTarget
        if typeof(object) == "shell" then targetIp = object.host_computer.public_ip
        if typeof(object) == "computer" then targetIp = object.public_ip
        print(c.orange + "WStack local mode — discovering all LAN devices..." + c.ennd)
        ml = metaxploit.load("/lib/libhttp.so")
        if not ml then
            print(c.yellow + "<b>wstack -l: libhttp.so not found in /lib" + c.ennd)
            return
        end if

        // recursive device discovery
        deviceList = []
        getDevices = function(router)
            if router == null then return
            ip = router.local_ip
            if deviceList.indexOf(ip) == null then deviceList.push(ip)
            devices = router.devices_lan_ip
            if not devices then return
            for device in devices
                if device == ip then continue
                if deviceList.indexOf(device) != null then continue
                subRouter = get_router(device)
                subSwitch = get_switch(device)
                if subRouter then
                    deviceList.push(device)
                    getDevices(subRouter)
                else if subSwitch then
                    deviceList.push(device)
                    getDevices(subSwitch)
                else
                    deviceList.push(device)
                end if
            end for
        end function

        router = get_router
        if is_valid_ip(targetIp) and not is_lan_ip(targetIp) then router = get_router(targetIp)
        if not router then
            print(c.yellow + "<b>wstack -l: could not get local router" + c.ennd)
            return
        end if
        getDevices(router)

        // fill IP gaps
        gapList = []
        for existingIp in deviceList
            parts = existingIp.split("\\.")
            if parts.len < 4 then continue
            subnet = parts[0] + "." + parts[1] + "." + parts[2] + "."
            lastOctet = parts[3].to_int
            i = 1
            while i < lastOctet
                candidate = subnet + i
                if deviceList.indexOf(candidate) == null and gapList.indexOf(candidate) == null then
                    gapList.push(candidate)
                end if
                i = i + 1
            end while
        end for
        for gapIp in gapList
            deviceList.push(gapIp)
        end for

        print(c.cyan + "  found " + deviceList.len + " device(s)" + c.ennd)
        pushed = 0
        for lanIp in deviceList
            print(c.orange + "  bouncing to " + lanIp + " ..." + c.ennd)
            obj = ml.overflow("0x1F000FB5", "length", lanIp)
            if typeof(obj) != "computer" then continue
            objectStack.push(obj)
            pushed = pushed + 1
            print(c.green + "  [+] pushed " + lanIp + " → stack [" + objectStack.len + "]" + c.ennd)
            homeDir = obj.File("/home")
            if homeDir then
                uNames = []
                for u in homeDir.get_folders
                    if u.name != "guest" then uNames.push(u.name)
                end for
                if uNames.len > 0 then print(c.grey + "        users: " + uNames.join(", ") + c.ennd)
            end if
        end for

        div
        print(c.cyan + "wstack -l complete — " + pushed + " computer(s) pushed to stack" + c.ennd)
        print(c.grey + "  use stack/swap/pop to access" + c.ennd)
        return
    end if

    // ── REMOTE MODE ───────────────────────────────────────────────────────────
    if typeof(object) != "shell" then
        print(c.yellow + "<b>wstack: not holding remote shell  (use wstack -l for local mode)" + c.ennd)
        return
    end if
    rcomp = object.host_computer
    pubIp = rcomp.public_ip
    lanIp = rcomp.local_ip

    // enumerate LAN from target's perspective via write-build-run (recursive)
    print(c.orange + "Enumerating LAN from target..." + c.ennd)
    rcomp.touch("/home/guest", "enum_lan.src")
    elSrc = rcomp.File("/home/guest/enum_lan.src")
    if elSrc then
        q = char(34)
        n = char(10)
        src = "gco = get_custom_object" + n
        src = src + "deviceList = []" + n
        src = src + "getDevices = function(router)" + n
        src = src + "  if router == null then return" + n
        src = src + "  ip = router.local_ip" + n
        src = src + "  if deviceList.indexOf(ip) == null then deviceList.push(ip)" + n
        src = src + "  devices = router.devices_lan_ip" + n
        src = src + "  if not devices then return" + n
        src = src + "  for device in devices" + n
        src = src + "    if device == ip then continue" + n
        src = src + "    if deviceList.indexOf(device) != null then continue" + n
        src = src + "    subRouter = get_router(device)" + n
        src = src + "    subSwitch = get_switch(device)" + n
        src = src + "    if subRouter then" + n
        src = src + "      deviceList.push(device)" + n
        src = src + "      getDevices(subRouter)" + n
        src = src + "    else if subSwitch then" + n
        src = src + "      deviceList.push(device)" + n
        src = src + "      getDevices(subSwitch)" + n
        src = src + "    else" + n
        src = src + "      deviceList.push(device)" + n
        src = src + "    end if" + n
        src = src + "  end for" + n
        src = src + "end function" + n
        src = src + "router = get_router" + n
        src = src + "if not router then exit()" + n
        src = src + "getDevices(router)" + n
        src = src + "gapList = []" + n
        src = src + "for existingIp in deviceList" + n
        src = src + "  parts = existingIp.split(" + q + "\\." + q + ")" + n
        src = src + "  if parts.len < 4 then continue" + n
        src = src + "  subnet = parts[0] + " + q + "." + q + " + parts[1] + " + q + "." + q + " + parts[2] + " + q + "." + q + n
        src = src + "  lastOctet = parts[3].to_int" + n
        src = src + "  i = 1" + n
        src = src + "  while i < lastOctet" + n
        src = src + "    candidate = subnet + i" + n
        src = src + "    if deviceList.indexOf(candidate) == null and gapList.indexOf(candidate) == null then" + n
        src = src + "      gapList.push(candidate)" + n
        src = src + "    end if" + n
        src = src + "    i = i + 1" + n
        src = src + "  end while" + n
        src = src + "end for" + n
        src = src + "for gapIp in gapList" + n
        src = src + "  deviceList.push(gapIp)" + n
        src = src + "end for" + n
        src = src + "gco.wbLanIps = deviceList.join(" + q + "," + q + ")" + n
        elSrc.set_content(src)
        object.build("/home/guest/enum_lan.src", "/home/guest", false)
        elBin = rcomp.File("/home/guest/enum_lan")
        if elBin then
            gco.wbLanIps = null
            object.launch("/home/guest/enum_lan")
            elSrc.delete
            elBin.delete
        else
            elSrc.delete
        end if
    end if

    lanTargets = []
    if gco.hasIndex("wbLanIps") and gco.wbLanIps then
        for ip in gco.wbLanIps.split(",")
            if ip != lanIp and ip != "" then lanTargets.push(ip)
        end for
        print(c.cyan + "  target sees " + lanTargets.len + " device(s): " + lanTargets.join(", ") + c.ennd)
    end if

    // fallback
    if lanTargets.len == 0 then
        router = get_router(pubIp)
        if not router then router = get_router(lanIp)
        if router then
            devices = router.devices_lan_ip
            if devices then
                for ip in devices
                    if ip != lanIp then lanTargets.push(ip)
                end for
            end if
        end if
    end if

    if lanTargets.len == 0 then
        print(c.yellow + "<b>wstack: no other LAN devices" + c.ennd)
        return
    end if
    print(c.cyan + "  found " + lanTargets.len + " target(s): " + lanTargets.join(", ") + c.ennd)

    // upload tools
    print(c.orange + "Uploading tools..." + c.ennd)
    me = get_shell
    me.scp(currentPath + "/metaxploit.so", "/home/guest", object)

    // write bounce script to target
    print(c.orange + "Writing bounce script to target..." + c.ennd)
    rcomp.touch("/home/guest", "wsx.src")
    srcFile = rcomp.File("/home/guest/wsx.src")
    if not srcFile then
        print(c.yellow + "<b>wstack: could not write to /home/guest" + c.ennd)
        return
    end if

    q = char(34)
    n = char(10)
    bounceSrc = "gco = get_custom_object" + n
    bounceSrc = bounceSrc + "selfPath = program_path.split(char(47))[:-1].join(char(47))" + n
    bounceSrc = bounceSrc + "metaxploit = include_lib(selfPath + char(47) + " + q + "metaxploit.so" + q + ")" + n
    bounceSrc = bounceSrc + "if not metaxploit then metaxploit = include_lib(" + q + "/lib/metaxploit.so" + q + ")" + n
    bounceSrc = bounceSrc + "if not metaxploit then exit(" + q + "no meta" + q + ")" + n
    bounceSrc = bounceSrc + "ml = metaxploit.load(" + q + "/lib/libhttp.so" + q + ")" + n
    bounceSrc = bounceSrc + "if not ml then exit(" + q + "no libhttp" + q + ")" + n
    bounceSrc = bounceSrc + "objs = []" + n
    bounceSrc = bounceSrc + "ips = gco.wsIPs.split(" + q + "," + q + ")" + n
    bounceSrc = bounceSrc + "for lanIp in ips" + n
    bounceSrc = bounceSrc + "  obj = ml.overflow(" + q + "0x1F000FB5" + q + ", " + q + "length" + q + ", lanIp)" + n
    bounceSrc = bounceSrc + "  if typeof(obj) == " + q + "computer" + q + " then objs.push(obj)" + n
    bounceSrc = bounceSrc + "end for" + n
    bounceSrc = bounceSrc + "gco.wsObjects = objs" + n
    bounceSrc = bounceSrc + "gco.wsCount = objs.len" + n

    srcFile.set_content(bounceSrc)
    print(c.orange + "Building on target..." + c.ennd)
    object.build("/home/guest/wsx.src", "/home/guest", false)
    binFile2 = rcomp.File("/home/guest/wsx")
    if not binFile2 then
        print(c.yellow + "<b>wstack: build failed" + c.ennd)
        srcFile.delete
        mxf = rcomp.File("/home/guest/metaxploit.so")
        if mxf then mxf.delete
        return
    end if

    gco.wsIPs = lanTargets.join(",")
    gco.wsObjects = null
    gco.wsCount = 0
    print(c.orange + "Running on target..." + c.ennd)
    object.launch("/home/guest/wsx")

    // cleanup
    srcFile.delete
    binFile2.delete
    mxf = rcomp.File("/home/guest/metaxploit.so")
    if mxf then mxf.delete

    // push objects to stack
    pushed = 0
    if gco.wsObjects and gco.wsCount > 0 then
        for obj in gco.wsObjects
            if typeof(obj) != "computer" then continue
            objectStack.push(obj)
            pushed = pushed + 1
            print(c.green + "  [+] pushed " + obj.local_ip + " → stack [" + objectStack.len + "]" + c.ennd)
            homeDir = obj.File("/home")
            if homeDir then
                uNames = []
                for u in homeDir.get_folders
                    if u.name != "guest" then uNames.push(u.name)
                end for
                if uNames.len > 0 then print(c.grey + "        users: " + uNames.join(", ") + c.ennd)
            end if
        end for
    end if

    div
    print(c.cyan + "wstack complete — " + pushed + " computer(s) pushed to stack across " + lanTargets.len + " device(s)" + c.ennd)
    print(c.grey + "  use stack/swap/pop to access" + c.ennd)
end function

ScanLib = function(ip, port)
    if not is_valid_ip(ip) then
        print(c.yellow + "<b>scanlib: invalid ip" + c.ennd)
        return
    end if
    portInt = port.to_int
    if typeof(portInt) != "number" then
        print(c.yellow + "<b>scanlib: invalid port" + c.ennd)
        return
    end if
    ns = metaxploit.net_use(ip, portInt)
    if not ns then
        print(c.yellow + "<b>scanlib: no net session on " + ip + ":" + port + c.ennd)
        globals.pipeFailed = true
        return
    end if
    metalib = ns.dump_lib
    if not metalib then
        print(c.yellow + "<b>scanlib: metalib not obtained" + c.ennd)
        globals.pipeFailed = true
        return
    end if
    print(c.cyan + "Library: " + metalib.lib_name + " " + metalib.version + c.ennd)
    if metalib.is_patched then
        print(c.grey + "  [patched - no vulnerabilities]" + c.ennd)
        return
    end if
    memList = metaxploit.scan(metalib)
    if not memList then
        print(c.grey + "  [no vulnerabilities found]" + c.ennd)
        return
    end if
    print(c.orange + "  vulnerabilities: " + memList.len + c.ennd)
    for mem in memList
        print(c.gold + "    " + mem + c.ennd)
    end for
end function

// ── QuickGrab (wrapper) ───────────────────────────────────────
// Scan and grab in one shot with auto-edb lookup
QuickGrab = function(ip, port)
    if not is_valid_ip(ip) then
        print(c.yellow + "<b>quickgrab: invalid ip" + c.ennd)
        globals.pipeFailed = true
        return
    end if
    portInt = port.to_int
    if typeof(portInt) != "number" then
        print(c.yellow + "<b>quickgrab: invalid port" + c.ennd)
        globals.pipeFailed = true
        return
    end if
    print(c.orange + "Quick grab " + ip + ":" + port + "..." + c.ennd)
    ns = metaxploit.net_use(ip, portInt)
    if not ns then
        print(c.yellow + "<b>quickgrab: no net session" + c.ennd)
        globals.pipeFailed = true
        return
    end if
    metalib = ns.dump_lib
    if not metalib then
        print(c.yellow + "<b>quickgrab: metalib not obtained" + c.ennd)
        globals.pipeFailed = true
        return
    end if
    // try edb first
    for e in globals.edb
        if e.hasIndex("lib") and e.hasIndex("mem") and e.hasIndex("val") then
            if e["lib"] == metalib.lib_name then
                print(c.grey + "  trying edb entry: " + e["mem"] + " " + e["val"] + c.ennd)
                obj = metalib.overflow(e["mem"], e["val"])
                if typeof(obj) == "shell" or typeof(obj) == "computer" then
                    globals.object = obj
                    if typeof(obj) == "shell" then
                        globals.remotePath = "/"
                        print(c.green + "<b>[+] shell grabbed via edb" + c.ennd)
                        GETPERMS(obj)
                    end if
                    return
                end if
            end if
        end if
    end for
    // fallback to scan
    print(c.grey + "  no edb match, running full scan..." + c.ennd)
    Scan(ip, port, myComp, null, null)
end function

// ── TargetInfo ──────────────────────────────────────────────────
// Get detailed info on a target without attacking
TargetInfo = function(ip)
    if not is_valid_ip(ip) then
        print(c.yellow + "<b>targetinfo: invalid ip" + c.ennd)
        return
    end if
    lan = is_lan_ip(ip)
    router = null
    if lan then
        router = get_router
    else
        router = get_router(ip)
    end if
    if not router then
        print(c.yellow + "<b>targetinfo: host not found" + c.ennd)
        return
    end if
    ports = null
    if lan then
        ports = router.device_ports(ip)
    else
        ports = router.used_ports
    end if
    if not ports then
        print(c.yellow + "<b>targetinfo: no ports returned" + c.ennd)
        return
    end if
    print(char(10) + c.cyan + "<b>" + ip + c.ennd)
    print(c.gold + "Router kernel: " + router.kernel_version + c.ennd)
    print(c.gold + "Firewall rules: " + router.firewall_rules + c.ennd)
    print(char(10) + c.orange + "Open ports:" + c.ennd)
    for p in ports
        svc = router.port_info(p)
        state = "open"
        if p.is_closed then state = "closed"
        print(c.white + "  " + p.port_number + "  " + state + "  " + svc + c.ennd)
    end for
end function

// ── LibAudit ────────────────────────────────────────────────────
// Quick audit of a specific lib — list all known exploits in edb
LibAudit = function(libName)
    if not libName or libName == "" then
        print(c.yellow + "<b>libaudit: missing lib name" + c.ennd)
        return
    end if
    matches = []
    for e in globals.edb
        if e.hasIndex("lib") and e["lib"] == libName then
            matches.push(e)
        end if
    end for
    if matches.len == 0 then
        print(c.grey + libName + ": no entries in edb" + c.ennd)
        return
    end if
    print(c.cyan + "<b>" + libName + " (" + matches.len + " exploit(s))" + c.ennd)
    for e in matches
        ver = ""
        if e.hasIndex("ver") and e["ver"] != "" then ver = " v" + e["ver"]
        print(c.gold + "  " + e["mem"] + "  " + e["val"] + ver + c.ennd)
    end for
end function

// ── AutorootStack (wrapper to ChainSaw version) ──────────────────
AutorootStack = function
    AutorootStackChainSaw()
end function

// ── AutorootStackChainSaw ───────────────────────────────────────
// Root all shells in stack using ChainSaw deploy
AutorootStackChainSaw = function
    if objectStack.len == 0 then
        print(c.yellow + "<b>autoroot --stack: stack is empty" + c.ennd)
        return
    end if
    print(char(10) + c.cyan + "<b>AUTOROOT STACK (ChainSaw)" + c.ennd)
    print(c.grey + "  targeting " + objectStack.len + " object(s)" + c.ennd)
    print(c.grey + "================================================================" + c.ennd)
    rooted = 0
    i = 1
    for obj in objectStack
        if typeof(obj) != "shell" then
            i = i + 1
            continue
        end if
        globals.object = obj
        globals.remotePath = "/"
        comp = obj.host_computer
        print(char(10) + c.orange + "[" + i + "/" + objectStack.len + "] " + comp.public_ip + c.ennd)
        
        // Deploy ChainSaw RCE to this target
        rcePath = "/home/guest"
        rceName = "chainsaw_rce"
        rceSrc = rcePath + "/" + rceName + ".src"
        
        n = char(10)
        rceLines = []
        rceLines.push("chainsaw = get_custom_object.chainsaw")
        rceLines.push("chainsaw.load_samples")
        rceLines.push("chainsaw.load_pregens")
        rceLines.push("chainsaw.load_chains")
        rceLines.push("chainsaw.crack(false)")
        rceString = rceLines.join(n)
        
        comp.touch(rcePath, rceName + ".src")
        rceFile = comp.File(rceSrc)
        if not rceFile then
            print(c.yellow + "  could not create RCE script" + c.ennd)
        else
            rceFile.set_content(rceString)
            print(c.grey + "  building chainsaw_rce..." + c.ennd)
            buildRes = obj.build(rceSrc, rcePath)
            if typeof(buildRes) == "string" and buildRes != "" then
                print(c.yellow + "  build failed: " + buildRes + c.ennd)
            else
                print(c.grey + "  launching ChainSaw..." + c.ennd)
                obj.launch(rcePath + "/" + rceName)
                wait(2)
                
                gcoCS = get_custom_object
                if gcoCS.hasIndex("chainsaw") and gcoCS.chainsaw.shell != null then
                    globals.object = gcoCS.chainsaw.shell
                    globals.remotePath = "/"
                    print(c.green + "  [+] rooted via ChainSaw" + c.ennd)
                    print(c.gold + "      password: " + gcoCS.chainsaw.password + c.ennd)
                    rooted = rooted + 1
                else
                    print(c.yellow + "  ChainSaw failed" + c.ennd)
                end if
            end if
        end if
        i = i + 1
    end for
    div
    print(c.cyan + "<b>autoroot --stack complete — " + rooted + "/" + objectStack.len + " rooted" + c.ennd)
end function

// ── ProxyWithChainSaw ───────────────────────────────────────────
// Enhanced Proxy that uses ChainSaw to crack root on the final hop
ProxyWithChainSaw = function(hops)
    if typeof(hops) != "number" or hops < 1 then hops = 1
    print(char(10) + c.cyan + "<b>PROXY CHAIN + CHAINSAW  building " + hops + " hop(s)..." + c.ennd)
    print(c.grey + "----------------------------------------------------------------" + c.ennd)

    chain = []
    attempts = 0
    maxAttempts = hops * 20

    while chain.len < hops and attempts < maxAttempts
        attempts = attempts + 1

        // generate random ip
        a = floor(rnd * 256)
        b = floor(rnd * 256)
        d = floor(rnd * 256)
        e = floor(rnd * 256)
        ip = a + "." + b + "." + d + "." + e

        if not is_valid_ip(ip) then continue
        if is_lan_ip(ip) then continue

        print(c.grey + "  [" + chain.len + "/" + hops + "] trying " + ip + " ..." + c.ennd, 1)

        // get router on port 0
        router = get_router(ip)
        if not router then continue

        ns = metaxploit.net_use(ip, 0)
        if not ns then continue

        ml = ns.dump_lib
        if not ml then continue
        if ml.is_patched then continue

        mems = metaxploit.scan(ml)
        if not mems then continue

        // try each exploit
        shell = null
        for mem in mems
            if shell then break
            addrs = metaxploit.scan_address(ml, mem).split("Unsafe check: ")
            for addr in addrs
                if shell then break
                if addr == addrs[0] then continue
                val = addr[addr.indexOf("<b>") + 3 : addr.indexOf("</b>")]
                obj = ml.overflow(mem, val)
                if typeof(obj) == "shell" then
                    shell = obj
                    EdbAdd(ml.lib_name, ml.version, mem, val)
                else if typeof(obj) == "computer" then
                    shell = obj
                    EdbAdd(ml.lib_name, ml.version, mem, val)
                end if
            end for
        end for

        if not shell then continue

        // got a shell — add to chain
        if typeof(shell) == "shell" then
            chainIp = shell.host_computer.public_ip
        else
            chainIp = shell.public_ip
        end if

        chain.push(shell)
        print(c.green + "  [" + chain.len + "/" + hops + "] hop " + chain.len + ": " + c.gold + chainIp + c.ennd)
    end while

    if chain.len == 0 then
        print(c.yellow + "<b>proxy: could not find any exploitable routers" + c.ennd)
        return
    end if

    if chain.len < hops then
        print(c.yellow + "proxy: only found " + chain.len + "/" + hops + " hops" + c.ennd)
    end if

    // store chain in gco
    gco.proxyChain = chain
    gco.proxyDepth = chain.len

    // set last hop as active object
    globals.object = chain[chain.len - 1]
    globals.remotePath = "/"

    // print chain summary
    print(char(10) + c.cyan + "proxy chain established:" + c.ennd)
    print(c.grey + "  you" + c.ennd)
    i = 0
    for hop in chain
        if typeof(hop) == "shell" then hopIp = hop.host_computer.public_ip
        if typeof(hop) == "computer" then hopIp = hop.public_ip
        print(c.grey + "   └─ " + c.ennd + c.gold + "hop " + (i + 1) + " : " + hopIp + c.ennd)
        i = i + 1
    end for
    print(c.grey + "   └─ " + c.ennd + c.orange + "target" + c.ennd)

    // ── CHAINSAW PHASE ───────────────────────────────────────────
    print(char(10) + c.orange + "Deploying ChainSaw RCE to target..." + c.ennd)
    
    if typeof(globals.object) != "shell" then
        print(c.yellow + "<b>proxy: lost remote shell" + c.ennd)
        print(c.green + "<b>proxy: active object set to hop " + chain.len + " (guest)" + c.ennd)
        gco.proxyReady = false
        return
    end if
    
    rcomp = globals.object.host_computer
    rcePath = "/home/guest"
    rceName = "chainsaw_rce"
    rceSrc = rcePath + "/" + rceName + ".src"
    
    // build RCE script that runs ChainSaw on target
    n = char(10)
    rceLines = []
    rceLines.push("chainsaw = get_custom_object.chainsaw")
    rceLines.push("chainsaw.load_samples")
    rceLines.push("chainsaw.load_pregens")
    rceLines.push("chainsaw.load_chains")
    rceLines.push("chainsaw.crack(false)")
    rceString = rceLines.join(n)
    
    rcomp.touch(rcePath, rceName + ".src")
    rceFile = rcomp.File(rceSrc)
    if not rceFile then
        print(c.yellow + "<b>proxy: could not create RCE script on target" + c.ennd)
        gco.proxyReady = false
    else
        rceFile.set_content(rceString)
        print(c.orange + "  building chainsaw_rce on target..." + c.ennd)
        buildRes = globals.object.build(rceSrc, rcePath)
        if typeof(buildRes) == "string" and buildRes != "" then
            print(c.yellow + "<b>proxy: remote build failed - " + buildRes + c.ennd)
            gco.proxyReady = false
        else
            print(c.lime + "  [+] built chainsaw_rce" + c.ennd)
            print(c.cyan + "  launching on target (cracking local root)..." + c.ennd)
            globals.object.launch(rcePath + "/" + rceName)
            wait(3)
            
            gcoCS = get_custom_object
            if gcoCS.hasIndex("chainsaw") and gcoCS.chainsaw.shell != null then
                globals.object = gcoCS.chainsaw.shell
                globals.remotePath = "/"
                print(c.lime + "<b>  [+] ROOT SHELL ACQUIRED via ChainSaw!" + c.ennd)
                print(c.gold + "  password: " + gcoCS.chainsaw.password + c.ennd)
                gco.proxyReady = true
            else
                print(c.yellow + "<b>proxy: ChainSaw crack failed" + c.ennd)
                print(c.grey + "  keeping guest shell on final hop" + c.ennd)
                gco.proxyReady = false
            end if
        end if
    end if

    print(char(10) + c.green + "<b>proxy: active object set to hop " + chain.len + c.ennd)
    print(c.grey + "  attacks and scans now route through the chain" + c.ennd)
end function
