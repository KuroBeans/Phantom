GETPERMS = function(obj)
	if typeof(obj) == "shell" then rhost = obj.host_computer
	if typeof(obj) == "computer" then rhost = obj
	log = rhost.File("/var/system.log")	
	var = rhost.File("/var")
	guest = rhost.File("/home/guest")
	passwd = rhost.File("/etc/passwd")
	etc = rhost.File("/etc")
	fileList = []
	if log then
		fileList.push(log)
	else
		print(color.yellow+"<b>/var/system.log not found")
	end if
	if var then fileList.push(var) 
	if passwd then fileList.push(passwd)
	if etc then fileList.push(etc)
	if guest then fileList.push(guest)
	writes = ""
	reads = ""
	granted = color.green+"<b>granted</b>"+color.cap
	denied = color.red+"<b>denied</b>"+color.cap
	for file in fileList
		if file.has_permission("w") then write = granted
		if not file.has_permission("w") then write = denied
		if file.has_permission("r") then read = granted
		if not file.has_permission("r") then read = denied
		writes = writes+color.white+"<b>"+file.path+"</b>"+color.cap+" "+write+char(10)
		reads = reads+color.white+"<b>"+file.path+"</b>"+color.cap+" "+read+char(10)
	end for
	print(color.yellow+"<b>write permissions"+char(10)+"--------------------------"+char(10)+format_columns(writes)+char(10) * 2+color.yellow+"<b>read permissions"+char(10)+"--------------------------"+char(10)+format_columns(reads))
end function
