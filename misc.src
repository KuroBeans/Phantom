// ================================================================
//  misc.src  |  phantom module  |  macro-state commands + leftovers
// ================================================================
// These commands directly read/write macroQueue, pipeQueue, or
// pipeFailed as part of the main loop's control flow (rather than
// just printing/querying), so they're grouped here instead of in
// a topic file. They mutate globals exactly like the dispatcher
// branches they're replacing did.

// ── sleep ─────────────────────────────────────────────────────────
CmdSleep = function(inp)
    if inp.len < 2 then
        print("<b>Usage: sleep <seconds>")
    else
        secs = inp[1].to_int
        if typeof(secs) == "number" and secs > 0 then
            wait(secs)
        else
            print(c.yellow + "<b>sleep: invalid seconds" + c.ennd)
        end if
    end if
end function
CommandTable["sleep"] = @CmdSleep

// ── pause ─────────────────────────────────────────────────────────
CmdPause = function(inp)
    msg = "Press Enter to continue..."
    if inp.len >= 2 then msg = inp[1:].join(" ")
    user_input(c.grey + msg + c.ennd, false, false)
end function
CommandTable["pause"] = @CmdPause

// ── _throw ────────────────────────────────────────────────────────
CmdThrow = function(inp)
    msg = ""
    if inp.len >= 2 then msg = inp[1:].join(" ")
    globals.throwMessage = msg
    globals.pipeFailed   = true
    print(c.yellow + "  _throw: " + msg + c.ennd)
end function
CommandTable["_throw"] = @CmdThrow

// ── _return ───────────────────────────────────────────────────────
CmdReturn = function(inp)
    val = ""
    if inp.len >= 2 then
        val = inp[1:].join(" ")
        // resolve @var
        if val.len > 1 and val[0:1] == "@" then
            vn = val[1:]
            if pipeVars.hasIndex(vn) then val = pipeVars[vn]
        end if
    end if
    globals.pipeResult = val
    // skip macroQueue to next __funcend__ sentinel
    k = 0
    while k < globals.macroQueue.len
        if globals.macroQueue[k] == "__funcend__" then
            globals.macroQueue = globals.macroQueue[k + 1:]
            k = globals.macroQueue.len
        end if
        k = k + 1
    end while
end function
CommandTable["_return"] = @CmdReturn

// ── harvest --stack ───────────────────────────────────────────────
CmdHarveststack = function(inp)
    if objectStack.len == 0 then
        print(c.yellow + "<b>harvest --stack: stack is empty" + c.ennd)
        return
    end if

    print(char(10) + c.cyan + "<b>HARVEST STACK  " + objectStack.len + " object(s)" + c.ennd)
    print(c.grey + "================================================================" + c.ennd)

    harvested = 0
    skipped   = 0
    savedObj  = globals.object

    idx = 1
    for obj in objectStack
        if typeof(obj) != "shell" and typeof(obj) != "computer" then
            print(c.grey + "  [" + idx + "] skipping — not a shell/computer" + c.ennd)
            skipped = skipped + 1
            idx = idx + 1
            continue
        end if

        comp = obj
        if typeof(obj) == "shell" then comp = obj.host_computer
        pf = comp.File("/etc/passwd")
        isRoot = pf != null and pf.has_permission("w")

        if not isRoot then
            print(c.yellow + "  [" + idx + "] " + comp.public_ip + " — guest only, skipping" + c.ennd)
            skipped = skipped + 1
            idx = idx + 1
            continue
        end if

        print(char(10) + c.orange + "  [" + idx + "] " + comp.public_ip + c.ennd)
        globals.object = obj
        Harvest()
        harvested = harvested + 1
        idx = idx + 1
    end for

    globals.object = savedObj
    print(char(10) + c.grey + "================================================================" + c.ennd)
    print(c.cyan + "harvest --stack complete" + c.ennd)
    print(c.grey + "  harvested: " + harvested + "  skipped: " + skipped + c.ennd)
end function
CommandTable["harveststack"] = @CmdHarveststack

// ── corlog --stack ────────────────────────────────────────────────
// Corrupts system.log on every root shell in the stack.
// Skips the y/n prompt — use with intention.
CmdCorlogstack = function(inp)
    if objectStack.len == 0 then
        print(c.yellow + "<b>corlog --stack: stack is empty" + c.ennd)
        return
    end if

    print(char(10) + c.cyan + "<b>CORLOG STACK  " + objectStack.len + " object(s)" + c.ennd)
    print(c.grey + "================================================================" + c.ennd)

    corrupted = 0
    skipped   = 0

    idx = 1
    for obj in objectStack
        comp = obj
        if typeof(obj) == "shell" then comp = obj.host_computer
        if typeof(comp) != "computer" then
            print(c.grey + "  [" + idx + "] skipping — not a shell/computer" + c.ennd)
            skipped = skipped + 1
            idx = idx + 1
            continue
        end if

        pf = comp.File("/etc/passwd")
        isRoot = pf != null and pf.has_permission("w")
        if not isRoot then
            print(c.yellow + "  [" + idx + "] " + comp.public_ip + " — guest only, skipping" + c.ennd)
            skipped = skipped + 1
            idx = idx + 1
            continue
        end if

        print(c.orange + "  [" + idx + "] " + comp.public_ip + " ..." + c.ennd)

        // inline corlog — no y/n prompt
        test = comp.touch("/home/guest", "system.log")
        if test == false then
            print(c.yellow + "    could not create temp file" + c.ennd)
            skipped = skipped + 1
            idx = idx + 1
            continue
        end if
        f = comp.File("/home/guest/system.log")
        if not f then
            print(c.yellow + "    temp file not found" + c.ennd)
            skipped = skipped + 1
            idx = idx + 1
            continue
        end if
        res = f.move("/var", "system.log")
        if res == "permission denied" then
            print(c.yellow + "    permission denied on /var" + c.ennd)
            skipped = skipped + 1
            idx = idx + 1
            continue
        end if
        lf = comp.File("/var/system.log")
        if not lf or lf.is_binary then
            print(c.yellow + "    failed to get /var/system.log" + c.ennd)
            skipped = skipped + 1
            idx = idx + 1
            continue
        end if
        lf.set_owner("root")
        lf.set_group("root")
        lf.chmod("o-w")
        lf.chmod("g-w")
        print(c.lime + "    [+] system.log corrupted" + c.ennd)
        corrupted = corrupted + 1
        idx = idx + 1
    end for

    print(c.grey + "================================================================" + c.ennd)
    print(c.cyan + "corlog --stack complete" + c.ennd)
    print(c.grey + "  corrupted: " + corrupted + "  skipped: " + skipped + c.ennd)
end function
CommandTable["corlogstack"] = @CmdCorlogstack

// ── plantstack ───────────────────────────────────────────────────
// Upload one or more weaklibs from /root/InsecureLibs to every
// root shell on the stack.
// Usage: plantstack [lib1] [lib2] ...
//        plantstack           → plants init.so + libhttp.so (defaults)
//        plantstack init.so   → plants only init.so
CmdPlantstack = function(inp)
    if objectStack.len == 0 then
        print(c.yellow + "<b>plantstack: stack is empty" + c.ennd)
        return
    end if

    srcDir = "/root/InsecureLibs"
    dest   = "/lib"

    // build lib list from args, or use defaults
    libs = []
    if inp.len >= 2 then
        for a in inp[1:]
            libs.push(a)
        end for
    else
        libs = ["init.so", "libhttp.so"]
    end if

    // verify libs exist locally first
    missing = []
    for lib in libs
        if not myComp.File(srcDir + "/" + lib) then missing.push(lib)
    end for
    if missing.len > 0 then
        print(c.yellow + "<b>plantstack: not found in " + srcDir + ": " + missing.join(", ") + c.ennd)
        if missing.len == libs.len then return
    end if

    print(char(10) + c.cyan + "<b>PLANTSTACK" + c.ennd)
    print(c.grey + "  libs:   " + libs.join(", ") + c.ennd)
    print(c.grey + "  dest:   " + dest + c.ennd)
    print(c.grey + "  stack:  " + objectStack.len + " object(s)" + c.ennd)
    print(c.grey + "================================================================" + c.ennd)

    planted = 0
    skipped = 0
    idx = 1
    for obj in objectStack
        if typeof(obj) != "shell" then
            print(c.grey + "  [" + idx + "] skipping — not a shell (" + typeof(obj) + ")" + c.ennd)
            skipped = skipped + 1
            idx = idx + 1
            continue
        end if

        comp   = obj.host_computer
        pubIp  = comp.public_ip
        isRoot = false
        pf = comp.File("/etc/passwd")
        if pf then isRoot = pf.has_permission("w")

        if not isRoot then
            print(c.yellow + "  [" + idx + "] " + pubIp + " — guest only, skipping" + c.ennd)
            skipped = skipped + 1
            idx = idx + 1
            continue
        end if

        print(c.orange + "  [" + idx + "] " + pubIp + c.ennd)

        libsOk = 0
        for lib in libs
            srcPath = srcDir + "/" + lib
            if not myComp.File(srcPath) then
                print(c.grey + "    " + lib + " — not found locally, skipping" + c.ennd)
                continue
            end if
            result = myShell.scp(srcPath, dest, obj)
            if typeof(result) == "string" and result != "" then
                print(c.yellow + "    " + lib + " — failed: " + result + c.ennd)
            else
                print(c.lime + "    [+] " + lib + c.ennd)
                libsOk = libsOk + 1
            end if
        end for

        if libsOk > 0 then planted = planted + 1
        idx = idx + 1
    end for

    print(c.grey + "================================================================" + c.ennd)
    print(c.cyan + "plantstack complete" + c.ennd)
    print(c.grey + "  planted: " + planted + "  skipped: " + skipped + "  total: " + objectStack.len + c.ennd)
end function
CommandTable["plantstack"] = @CmdPlantstack

// ── plant ────────────────────────────────────────────────────────
CmdPlant = function(inp)
    if typeof(object) != "shell" then
        globals.pipeFailed = true
        print(c.yellow + "<b>plant: need a remote shell — object is " + typeof(object) + c.ennd)
    else
        srcDir = "/root/InsecureLibs"
        libName = inp[0]
        dest = "/lib"
        if inp.len >= 2 then libName = inp[1]
        if inp.len >= 3 then dest = inp[2]
        srcPath = srcDir + "/" + libName
        if not myComp.File(srcPath) then
            print(c.yellow + "<b>plant: " + srcPath + " not found" + c.ennd)
            return
        end if
        print(c.orange + "Planting " + libName + " to " + dest + " on target..." + c.ennd)
        result = myShell.scp(srcPath, dest, object)
        if typeof(result) == "string" and result != "" then
            globals.pipeFailed = true
            print(c.yellow + "<b>plant: " + result + c.ennd)
        else
            print(c.lime + "  [+] planted " + libName + " at " + dest + "/" + libName + c.ennd)
        end if
        // also plant metaxploit.so from /root
        mxSrc = "/root/metaxploit.so"
        if myComp.File(mxSrc) then
            mxResult = myShell.scp(mxSrc, dest, object)
            if typeof(mxResult) == "string" and mxResult != "" then
                print(c.yellow + "<b>plant: metaxploit.so - " + mxResult + c.ennd)
            else
                print(c.lime + "  [+] planted metaxploit.so at " + dest + "/metaxploit.so" + c.ennd)
            end if
        end if
    end if
end function
CommandTable["plant"] = @CmdPlant

// ── chainsaw ─────────────────────────────────────────────────────
CmdChainsaw = function(inp)
    if inp.len < 2 then
        print("<b>Usage: chainsaw [run|load|deploy|help] [options]")
        globals.pipeFailed = true
        return
    end if

    subcommand = inp[1]

    if subcommand == "help" then
        print("ChainSaw - Markov Chain Password Cracker by NitroCynic")
        print("")
        print("Commands:")
        print("  run     - Crack password locally or over network; success sets lObject (local) or object (remote)")
        print("  load    - Load into GCO for in-script RCE chains")
        print("  deploy  - Upload + launch on held remote shell to crack ROOT locally on target")
        print("")
        print("Parameters:")
        print("  --user=USER    User to crack (default: root)")
        print("  --ip=IP        Remote IP (if blank, cracks local shell)")
        print("  --port=PORT    Remote port (default: 22)")

    else if subcommand == "run" then
        cs_params = ["run"]
        if inp.len > 2 then
            for i in range(2, inp.len - 1)
                cs_params.push(inp[i])
            end for
        end if

        ChainSaw.parse_params(cs_params)
        ChainSaw.init
        result = ChainSaw.crack(true)

        if result then
            print(c.lime + "Success! Password: " + c.gold + ChainSaw.password + c.ennd)
            // ChainSaw.connect goes local (get_shell(user, password)) when
            // no --ip was given, remote (connect_service) otherwise — route
            // the shell the same way Escalate does for local privesc:
            // lObject for local, object/remotePath for a held remote target.
            if ChainSaw.ip == "" then
                globals.lObject = result
                print(c.lime + "  local shell acquired" + c.ennd)
            else
                globals.object = result
                globals.remotePath = "/"
                print(c.lime + "  remote shell acquired: " + ChainSaw.ip + c.ennd)
            end if
            globals.pipeFailed = false
        else
            print(c.red + "Failed to crack password" + c.ennd)
            globals.pipeFailed = true
        end if

    else if subcommand == "load" then
        cs_params = ["load"]
        if inp.len > 2 then
            for i in range(2, inp.len - 1)
                cs_params.push(inp[i])
            end for
        end if
        ChainSaw.parse_params(cs_params)
        ChainSaw.load

        print(c.lime + "ChainSaw loaded into GCO" + c.ennd)
        globals.pipeFailed = false

    else if subcommand == "deploy" then
        if typeof(object) != "shell" then
            globals.pipeFailed = true
            print(c.yellow + "<b>chainsaw deploy: need a held remote shell — object is " + typeof(object) + c.ennd)
        else
            ChainSaw.load

            rcePath = "/home/guest"
            rceName = "chainsaw_rce"
            rceSrc  = rcePath + "/" + rceName + ".src"

            rceLines = []
            rceLines.push("chainsaw = get_custom_object.chainsaw")
            rceLines.push("chainsaw.init()")
            rceLines.push("chainsaw.crack()")
            rceString = rceLines.join(char(10))

            object.host_computer.touch(rcePath, rceName + ".src")
            rceFile = object.host_computer.File(rceSrc)
            if not rceFile then
                globals.pipeFailed = true
                print(c.yellow + "<b>chainsaw deploy: could not create " + rceSrc + " on target" + c.ennd)
            else
                rceFile.set_content(rceString)
                print(c.orange + "Building chainsaw_rce on target..." + c.ennd)
                buildRes = object.build(rceSrc, rcePath)
                if typeof(buildRes) == "string" and buildRes != "" then
                    globals.pipeFailed = true
                    print(c.yellow + "<b>chainsaw deploy: remote build failed - " + buildRes + c.ennd)
                else
                    print(c.lime + "  [+] built " + rceName + c.ennd)
                    print(c.cyan + "Launching on target (cracking local root)..." + c.ennd)
                    object.launch(rcePath + "/" + rceName)

                    gcoCS = get_custom_object
                    if gcoCS.hasIndex("chainsaw") and gcoCS.chainsaw.shell != null then
                        globals.object = gcoCS.chainsaw.shell
                        globals.remotePath = "/"
                        print(c.lime + "<b>  [+] root shell acquired!" + c.ennd)
                        print(c.gold + "  password: " + gcoCS.chainsaw.password + c.ennd)
                        globals.pipeFailed = false
                    else
                        globals.pipeFailed = true
                        print(c.yellow + "<b>chainsaw deploy: launched, but no shell came back yet" + c.ennd)
                        print(c.grey + "  watch above for live print output, or run 'chainsaw deploy' again" + c.ennd)
                    end if
                end if
            end if
        end if

    else
        print(c.yellow + "Unknown chainsaw subcommand: " + subcommand + c.ennd)
        globals.pipeFailed = true
    end if
end function
CommandTable["chainsaw"] = @CmdChainsaw

// ── siphon ───────────────────────────────────────────────────────
// NOTE: original dispatcher called Siphon(inp[1]) / Siphon(null) but
// no Siphon() definition has been seen in any file sent so far — it
// must live in a module not yet shared. Preserving the call as-is;
// flag if it errors as undefined.
CmdSiphon = function(inp)
    if inp.len == 2 then
        Siphon(inp[1])
    else
        Siphon(null)
    end if
end function
CommandTable["siphon"] = @CmdSiphon

// ── call / macall ─────────────────────────────────────────────────
CmdCall = function(inp)
    if inp.len < 2 then
        print("<b>Usage: call <macro> [arg1 arg2...]")
        print(c.grey + "  e.g.  call hunt 80" + c.ennd)
        print(c.grey + "  e.g.  call get_ips | clip @result" + c.ennd)
    else
        name = inp[1]
        args = inp[2:]
        result = MacroCall(name, args)
        if result != null then
            globals.pipeResult = result
            print(c.teal + "  → " + result + c.ennd)
        else
            globals.pipeFailed = true
        end if
    end if
end function
CommandTable["call"] = @CmdCall
CommandTable["macall"] = @CmdCall

// ── mac ──────────────────────────────────────────────────────────
CmdMac = function(inp)
    macDir = "/root/ai/mac"
    if inp.len == 1 or inp[1] == "list" then
        d = myComp.File(macDir)
        if not d then
            print(c.yellow + "  no macros found — create .txt files in " + macDir + c.ennd)
        else
            files = d.get_files
            if files.len == 0 then
                print(c.grey + "  no macros in " + macDir + c.ennd)
            else
                print(c.cyan + "<b>macros in " + macDir + ":" + c.ennd)
                for f in files
                    print(c.gold + "  " + f.name + c.ennd)
                end for
            end if
        end if
    else if inp[1] == "show" then
        if inp.len < 3 then
            print(c.yellow + "<b>usage: mac show <name>" + c.ennd)
        else
            name = inp[2]
            f = myComp.File(macDir + "/" + name + ".txt")
            if not f then f = myComp.File(macDir + "/" + name)
            if not f then
                print(c.yellow + "<b>mac: " + name + " not found in " + macDir + c.ennd)
            else
                print(c.cyan + "<b>" + f.name + ":" + c.ennd)
                lines = f.get_content.split(char(10))
                i = 1
                for line in lines
                    if line != "" then
                        col = c.grey
                        if line[0:2] == "//" then col = c.teal
                        print(col + "  " + i + "  " + line + c.ennd)
                    end if
                    i = i + 1
                end for
            end if
        end if
    else
        // run macro
        name = inp[1]
        extraArgs = inp[2:]
        globals.macroArgList = []
        argCount = 0
        for arg in extraArgs
            globals.macroArgList.push(arg)
            argCount = argCount + 1
        end for
        f = myComp.File(macDir + "/" + name + ".txt")
        if not f then f = myComp.File(macDir + "/" + name)
        if not f then
            print(c.yellow + "<b>mac: '" + name + "' not found" + c.ennd)
            print(c.grey + "  create " + macDir + "/" + name + ".txt in the code editor" + c.ennd)
        else
            lines = f.get_content.split(char(10))
            globals.macroQueue = CompileMacroLines(lines, macroArgList, true)
            if macroQueue.len == 0 then
                print(c.yellow + "<b>mac: '" + name + "' is empty" + c.ennd)
            else
                globals.macroName = name
                if macroArgList.len > 0 then
                    print(c.grey + "  args: " + macroArgList.len + c.ennd)
                    i = 0
                    while i < macroArgList.len
                        print(c.grey + "    $" + (i+1) + " = " + macroArgList[i] + c.ennd)
                        i = i + 1
                    end while
                end if
                print(c.cyan + "<b>running macro '" + name + "' (" + macroQueue.len + " line(s))" + c.ennd)
            end if
        end if
    end if
end function
CommandTable["mac"] = @CmdMac

// ── exec ─────────────────────────────────────────────────────────
CmdExec = function(inp)
    if inp.len < 2 then
        print("<b>Usage: exec [count] <command|macroname|block>")
        print(c.grey + "  exec 10 grab @t 80 -push" + c.ennd)
        print(c.grey + "  exec 5 hunt 80" + c.ennd)
        print(c.grey + "  exec 3 randip | clip @a ; grab @a 80 -push" + c.ennd)
    else
        count = inp[1].to_int
        if count != null and count > 0 then
            cmdStr = inp[2:].join(" ")
        else
            count = 1
            cmdStr = inp[1:].join(" ")
        end if
        // reconstruct full pipe chain
        if pipeQueue.len > 0 then
            cmdStr = cmdStr + " | " + pipeQueue.join(" | ")
            globals.pipeQueue = []
        end if
        if cmdStr == "" then
            print(c.yellow + "<b>exec: missing command" + c.ennd)
        else
            macDir = "/root/ai/mac"
            firstWord = cmdStr.split(" ")[0]
            macFile = myComp.File(macDir + "/" + firstWord + ".txt")
            if not macFile then macFile = myComp.File(macDir + "/" + firstWord)
            if macFile then
                // ── macro file mode ──────────────────────────
                globals.macroName = "exec"
                execArgList = cmdStr.split(" ")[1:]
                rawLines = macFile.get_content.split(char(10))
                processedLines = CompileMacroLines(rawLines, execArgList, false)
                globals.macroQueue = []
                i = 0
                while i < count
                    for ln in processedLines
                        globals.macroQueue.push(ln)
                    end for
                    i = i + 1
                end while
                print(c.cyan + "<b>exec: macro '" + firstWord + "' x" + count + " (" + macroQueue.len + " lines)" + c.ennd)
            else if cmdStr.indexOf(";") != null then
                // ── inline block mode — ; separates lines ────
                globals.macroName = "exec"
                rawParts = cmdStr.split(";")
                trimmedLines = []
                for line in rawParts
                    while line.len > 0 and line[0] == " "
                        line = line[1:]
                    end while
                    while line.len > 0 and line[-1] == " "
                        line = line[:-1]
                    end while
                    trimmedLines.push(line)
                end for
                processedLines = CompileMacroLines(trimmedLines, [], false)
                globals.macroQueue = []
                i = 0
                while i < count
                    for ln in processedLines
                        globals.macroQueue.push(ln)
                    end for
                    i = i + 1
                end while
                print(c.cyan + "<b>exec: block x" + count + " (" + macroQueue.len + " lines)" + c.ennd)
            else
                // ── single command mode ──────────────────────
                globals.macroName = "exec"
                globals.macroQueue = []
                i = 0
                while i < count
                    globals.macroQueue.push(cmdStr)
                    i = i + 1
                end while
                print(c.cyan + "<b>exec: '" + cmdStr + "' x" + count + c.ennd)
            end if
        end if
    end if
end function
CommandTable["exec"] = @CmdExec

// ── foreach ──────────────────────────────────────────────────────
CmdForeach = function(inp)
    if inp.len < 2 then
        globals.pipeFailed = true
        print(c.yellow + "<b>usage: foreach @list | cmd @each ..." + c.ennd)
    else if pipeQueue.len == 0 then
        globals.pipeFailed = true
        print(c.yellow + "<b>foreach: no commands — use: foreach @list | cmd1 | cmd2" + c.ennd)
    else
        listVal = inp[1]
        if listVal[0:1] == "@" then
            globals.pipeFailed = true
            print(c.yellow + "<b>foreach: @" + listVal[1:] + " not set — use lanenum @" + listVal[1:] + " or clip @" + listVal[1:] + " first" + c.ennd)
        else
            items = listVal.split(",")
            if items.len == 0 or (items.len == 1 and items[0] == "") then
                globals.pipeFailed = true
                print(c.yellow + "<b>foreach: list is empty" + c.ennd)
            else
                globals.foreachBody = pipeQueue[0]
                globals.pipeQueue = []
                globals.foreachItems = items[1:]
                pipeVars["each"] = items[0]
                globals.pipeVars["each"] = items[0]
                globals.pipeQueue.push(foreachBody)
                print(c.cyan + "<b>foreach: " + items.len + " item(s) — starting with " + items[0] + c.ennd)
            end if
        end if
    end if
end function
CommandTable["foreach"] = @CmdForeach

// ── break ────────────────────────────────────────────────────────
CmdBreak = function(inp)
    loopIdx = null
    k = 0
    while k < macroQueue.len
        if macroQueue[k].len >= 9 and macroQueue[k][:9] == "__while__" then
            loopIdx = k
            k = macroQueue.len
        end if
        k = k + 1
    end while
    if loopIdx != null then
        globals.macroQueue = macroQueue[loopIdx + 1:]
        globals.pipeFailed = false
        print(c.grey + "  break: loop exited" + c.ennd)
    else
        print(c.grey + "  break: not inside a loop" + c.ennd)
    end if
end function
CommandTable["break"] = @CmdBreak

// ── continue ─────────────────────────────────────────────────────
CmdContinue = function(inp)
    loopIdx = null
    k = 0
    while k < macroQueue.len
        if macroQueue[k].len >= 9 and macroQueue[k][:9] == "__while__" then
            loopIdx = k
            k = macroQueue.len
        end if
        k = k + 1
    end while
    if loopIdx != null then
        skipped = loopIdx
        globals.macroQueue = macroQueue[loopIdx:]
        globals.pipeFailed = false
        if skipped > 0 then print(c.grey + "  continue: skipped " + skipped + " line(s)" + c.ennd)
    else if pipeQueue.len > 0 then
        globals.pipeQueue = []
        globals.pipeFailed = false
    else
        print(c.grey + "  continue: not inside a loop" + c.ennd)
    end if
end function
CommandTable["continue"] = @CmdContinue

// ── rlan ─────────────────────────────────────────────────────────
CmdRlan = function(inp)
    if not object then
        print(c.yellow + "<b>rlan: no remote object" + c.ennd)
        globals.pipeFailed = true
    else
        comp = object
        if typeof(object) == "shell" then comp = object.host_computer
        lanIp = comp.local_ip
        if lanIp != null then lanIp = "" + lanIp
        if lanIp == null or lanIp == "" or lanIp == "null" then
            print(c.yellow + "<b>rlan: no LAN IP available (public-facing machine?)" + c.ennd)
            globals.pipeFailed = true
        else
            print(c.cyan + "rlan: " + lanIp + c.ennd)
            globals.pipeResult = lanIp
            if inp.len >= 2 then
                k = inp[1]
                if k[0:1] == "@" then k = k[1:]
                gco = get_custom_object
                if not gco.hasIndex("clips") then gco.clips = {}
                gco.clips[k] = lanIp
                globals.pipeVars[k] = lanIp
                print(c.lime + "  @" + k + " = " + lanIp + c.ennd)
            end if
        end if
    end if
end function
CommandTable["rlan"] = @CmdRlan

// ── rpub ─────────────────────────────────────────────────────────
CmdRpub = function(inp)
    if not object then
        print(c.yellow + "<b>rpub: no remote object" + c.ennd)
        globals.pipeFailed = true
    else
        comp = object
        if typeof(object) == "shell" then comp = object.host_computer
        pubIp = comp.public_ip
        if pubIp == null or pubIp == "" then
            print(c.yellow + "<b>rpub: could not get public IP" + c.ennd)
            globals.pipeFailed = true
        else
            print(c.cyan + "rpub: " + pubIp + c.ennd)
            globals.pipeResult = pubIp
            if inp.len >= 2 then
                k = inp[1]
                if k[0:1] == "@" then k = k[1:]
                gco = get_custom_object
                if not gco.hasIndex("clips") then gco.clips = {}
                gco.clips[k] = pubIp
                globals.pipeVars[k] = pubIp
                print(c.lime + "  @" + k + " = " + pubIp + c.ennd)
            end if
        end if
    end if
end function
CommandTable["rpub"] = @CmdRpub

// ── ports ────────────────────────────────────────────────────────
CmdPorts = function(inp)
    if inp.len < 2 then
        print("<b>Usage: ports <ip> [port list]")
        print(c.grey + "  e.g.  ports @t" + c.ennd)
        print(c.grey + "  e.g.  ports @t 80 22 443" + c.ennd)
    else
        tgt = inp[1]
        if inp.len >= 3 then
            portList = inp[2:]
        else
            portList = ["22", "25", "80", "1542", "3306", "3307"]
        end if
        print(c.orange + "Scanning " + tgt + " on " + portList.len + " port(s)..." + c.ennd)
        openPorts = []
        for p in portList
            ns = metaxploit.net_use(tgt, p.to_int)
            if ns then
                print(c.lime + "  [+] " + p + " open" + c.ennd)
                openPorts.push(p)
            else
                print(c.grey + "  [-] " + p + " closed" + c.ennd)
            end if
        end for
        if openPorts.len == 0 then
            print(c.yellow + "<b>ports: no open ports found on " + tgt + c.ennd)
            globals.pipeFailed = true
        else
            print(c.cyan + "ports: " + openPorts.len + " open — " + openPorts.join(", ") + c.ennd)
            globals.pipeResult = tgt
            pipeVars["port"] = openPorts[0]
            globals.pipeVars["port"] = openPorts[0]
            if storeVar != null then
                gco = get_custom_object
                if not gco.hasIndex("clips") then gco.clips = {}
                gco.clips[storeVar] = tgt
                globals.pipeVars[storeVar] = tgt
                print(c.lime + "  @" + storeVar + " = " + tgt + c.ennd)
            end if
        end if
    end if
end function
CommandTable["ports"] = @CmdPorts

// ── p (police records) ────────────────────────────────────────────
CmdP = function(inp)
    if typeof(object) != "shell" then
        print(c.red + "p: must be holding remote shell" + c.ennd)
    else
        object.launch("/root/PoliceRecord.exe")
    end if
end function
CommandTable["p"] = @CmdP

// ── pre (session setup) ───────────────────────────────────────────
CmdPre = function(inp)
    me = get_shell
    me.launch("/usr/bin/Mail.exe")
    wait(2)
    me.launch("/usr/bin/Browser.exe")
    wait(2)
    me.launch("/usr/bin/FileExplorer.exe")
    wait(2)
    me.launch("/usr/bin/Terminal.exe")
    wait(2)
    me.launch("/usr/bin/Terminal.exe")
end function
CommandTable["pre"] = @CmdPre
CmdCode = function(inp)
me = get_shell
me.launch("/usr/bin/CodeEditor.exe")
end function
CommandTable["code"] = @CmdCode
// ── exit / quit ────────────────────────────────────────────────────
CmdExit = function(inp)
    exit
end function
CommandTable["exit"] = @CmdExit
CommandTable["quit"] = @CmdExit

// ── claim ──────────────────────────────────────────────────────────
// Picks up a shell left behind by ArLocal (autoroot -l / ar -l) in
// gco.claimShell — e.g. jump to a target, autoroot -l yourself there,
// then come back to your original phantom session and run claim to
// have that root shell land in globals.object here. gco is a
// persistent, player-scoped store (same reason slb.src/wsx.src already
// hand live shell/computer objects back across a launch boundary
// between two different machines), so this works across two
// independent phantom sessions, not just within one script's own
// launch/wait cycle.
CmdClaim = function(inp)
    gcoClaim = get_custom_object
    if gcoClaim.hasIndex("claimShell") and gcoClaim.claimShell then
        globals.object = gcoClaim.claimShell
        globals.remotePath = "/"
        gcoClaim.claimShell = null
        // leave can hand off a computer object too, not just a shell —
        // .host_computer only exists on shells, so branch instead of
        // assuming shell like the original ArLocal-only version did
        if typeof(object) == "shell" then
            print(c.lime + "<b>claimed shell: " + object.host_computer.get_name + "  pub:" + object.host_computer.public_ip + "  lan:" + object.host_computer.local_ip + c.ennd)
        else
            print(c.lime + "<b>claimed computer: " + object.get_name + "  pub:" + object.public_ip + "  lan:" + object.local_ip + c.ennd)
        end if
        globals.pipeFailed = false
        return
    end if

    // gco.claimLib only ever carries a lib NAME (a plain string), never
    // a live lib handle — payloads/slb.src's own header notes sharing
    // an actual metaxploitLib object across a launch boundary was tried
    // three times and failed every time (a reused handle's net_use
    // comes back null). So the receiving side always loads its own
    // fresh handle here, from whatever's on THIS machine's own /lib —
    // same as libscan.src does for a named lib.
    if gcoClaim.hasIndex("claimLib") and gcoClaim.claimLib and gcoClaim.claimLib != "" then
        libName = gcoClaim.claimLib
        gcoClaim.claimLib = null
        ml = metaxploit.load("/lib/" + libName)
        if not ml then ml = metaxploit.load(libName)
        if not ml then
            print(c.yellow + "<b>claim: lib not found here: " + libName + c.ennd)
            globals.pipeFailed = true
            return
        end if
        globals.activeLib = ml
        print(c.lime + "<b>claimed + loaded lib: " + ml.lib_name + " " + ml.version + c.ennd)
        print(c.grey + "  held in globals.activeLib — reference it directly, e.g. via exec/code" + c.ennd)
        globals.pipeFailed = false
        return
    end if

    // gco.claimMx carries a metaxploit.so PATH, not a live handle — same
    // reasoning as claimLib above. Different metaxploit.so copies (e.g.
    // pulled from a specific target) can decode things your own local
    // one can't, so uselib checks globals.activeMx before falling back
    // to the one global metaxploit loaded at startup.
    if gcoClaim.hasIndex("claimMx") and gcoClaim.claimMx and gcoClaim.claimMx != "" then
        mxPath = gcoClaim.claimMx
        gcoClaim.claimMx = null
        mx = include_lib(mxPath)
        if not mx then
            print(c.yellow + "<b>claim: metaxploit not found at " + mxPath + c.ennd)
            globals.pipeFailed = true
            return
        end if
        globals.activeMx = mx
        print(c.lime + "<b>claimed + loaded metaxploit: " + mxPath + c.ennd)
        print(c.grey + "  held in globals.activeMx — uselib will use it over the default metaxploit" + c.ennd)
        globals.pipeFailed = false
        return
    end if

    print(c.yellow + "<b>claim: nothing waiting to be claimed" + c.ennd)
    globals.pipeFailed = true
end function
CommandTable["claim"] = @CmdClaim

// ── leave ──────────────────────────────────────────────────────────
// The mirror of claim: leaves whatever shell/computer you're currently
// holding in gco.claimShell for pickup from ANOTHER phantom session —
// e.g. hold a shell here, leave it, jump to a target, then claim it
// from the nested instance running there (or the other way around).
// leave -lib <name> instead leaves just a lib NAME in gco.claimLib —
// see the claim-side comment on why a live lib handle can't make the
// same trip.
CmdLeave = function(inp)
    if inp.len >= 3 and inp[1] == "-lib" then
        gcoLeave = get_custom_object
        gcoLeave.claimLib = inp[2]
        print(c.lime + "<b>left lib '" + inp[2] + "' for pickup" + c.ennd)
        print(c.grey + "  run 'claim' from another phantom session to load it there" + c.ennd)
        globals.pipeFailed = false
        return
    end if
    if inp.len >= 2 and inp[1] == "-mx" then
        // no path given -> default to phantom's own metaxploit.so
        // (same path it loaded at startup) so "leave -mx" alone just
        // shares your own copy without having to type it out
        mxPath = currentPath + "/metaxploit.so"
        if inp.len >= 3 then mxPath = inp[2]
        gcoLeave = get_custom_object
        gcoLeave.claimMx = mxPath
        print(c.lime + "<b>left metaxploit path '" + mxPath + "' for pickup" + c.ennd)
        print(c.grey + "  run 'claim' from another phantom session to load it there" + c.ennd)
        globals.pipeFailed = false
        return
    end if

    if typeof(object) != "shell" and typeof(object) != "computer" then
        print(c.yellow + "<b>leave: not holding a shell or computer to leave" + c.ennd)
        print(c.grey + "  or: leave -lib <name>  /  leave -mx <path>  for those instead" + c.ennd)
        globals.pipeFailed = true
        return
    end if
    gcoLeave = get_custom_object
    gcoLeave.claimShell = object
    print(c.lime + "<b>left " + typeof(object) + " for pickup" + c.ennd)
    print(c.grey + "  run 'claim' from another phantom session to grab it" + c.ennd)
    globals.pipeFailed = false
end function
CommandTable["leave"] = @CmdLeave

// ── uselib ─────────────────────────────────────────────────────────
// First real consumer of globals.activeLib (set by claim). Tries
// db-known pairs first (KnownExploits, core.src), else scans/decodes
// fresh, same precedence ScanLib/grab already use elsewhere. Scans
// with globals.activeMx (claim -mx) if one's held, since a different
// metaxploit.so copy can decode things the default one can't — falls
// back to the one global metaxploit loaded at startup otherwise.
// uselib [opt:inject] [opt:-c] [opt:-s]
// -s: recon only — decode + record candidates to db.txt (unconfirmed,
// blank type/user, same as scanlan's direct-ip mode) without ever
// calling overflow(). Point of this: claim a lib mid-jump, come back
// out to your original session, and bank its candidates in db.txt
// without needing a live target to attack right now.
CmdUselib = function(inp)
    if not globals.activeLib then
        print(c.yellow + "<b>uselib: no active lib — claim one first" + c.ennd)
        globals.pipeFailed = true
        return
    end if
    ml = globals.activeLib
    mx = metaxploit
    if globals.activeMx then mx = globals.activeMx
    scanOnly = inp.indexOf("-s") != null
    acceptComputer = inp.indexOf("-c") != null
    inject = null
    for a in inp[1:]
        if a != "-c" and a != "-s" then inject = a
    end for

    pairs = KnownExploits(ml.lib_name, ml.version)
    freshScan = pairs.len == 0
    if freshScan then
        mems = mx.scan(ml)
        if mems then
            for mem in mems
                for addr in mx.scan_address(ml, mem).split("Unsafe check: ")
                    if addr.indexOf("<b>") == null then continue
                    v = addr[addr.indexOf("<b>")+3:addr.indexOf("</b>")]
                    if v != "" then pairs.push([mem, v])
                end for
            end for
        end if
    end if
    if pairs.len == 0 then
        print(c.yellow + "<b>uselib: no candidates for " + ml.lib_name + " " + ml.version + c.ennd)
        globals.pipeFailed = true
        return
    end if

    if scanOnly then
        print(c.cyan + "<b>uselib -s: " + pairs.len + " candidate(s) for " + ml.lib_name + " " + ml.version + c.ennd)
        for pair in pairs
            print(c.gold + "  " + pair[0] + "  " + pair[1] + c.ennd)
            // only the fresh-scan case needs recording — KnownExploits
            // pairs are already in db.txt by definition
            if freshScan then EdbAdd(ml.lib_name, ml.version, pair[0], pair[1], "", "")
        end for
        globals.pipeFailed = false
        return
    end if

    for pair in pairs
        if inject then obj = ml.overflow(pair[0], pair[1], inject) else obj = ml.overflow(pair[0], pair[1])
        t = typeof(obj)
        EdbAdd(ml.lib_name, ml.version, pair[0], pair[1], t, "")
        if t == "shell" or (t == "computer" and acceptComputer) then
            globals.object = obj
            globals.remotePath = "/"
            print(c.lime + "<b>uselib: " + t + " via " + pair[0] + " " + pair[1] + c.ennd)
            globals.pipeFailed = false
            return
        end if
    end for
    print(c.yellow + "<b>uselib: no working exploit (use -c to accept a computer)" + c.ennd)
    globals.pipeFailed = true
end function
CommandTable["uselib"] = @CmdUselib

// ── null / noop / pass ─────────────────────────────────────────────
CmdNoop = function(inp)
    // intentional no-op
end function
CommandTable["null"] = @CmdNoop
CommandTable["noop"] = @CmdNoop
CommandTable["pass"] = @CmdNoop



