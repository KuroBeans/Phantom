    tables["names"] = "james,john,robert,michael,william,david,richard,joseph,thomas,charles,christopher,daniel,matthew,anthony,mark,donald,steven,paul,andrew,kenneth,joshua,kevin,brian,george,timothy,ronald,edward,jason,jeffrey,ryan,jacob,gary,nicholas,eric,jonathan,stephen,larry,justin,scott,brandon,benjamin,samuel,raymond,gregory,frank,alexander,patrick,raymond,jack,dennis,jerry,tyler,aaron,jose,henry,adam,douglas,nathan,peter,zachary,kyle,noah,alan,ethan,wayne,joe,juan,roy,ralph,carlos,arthur,albert,stanley,leonard,glen,vincent,travis,jeff,lloyd,phillip,danny,victor,jeremy,bruce,gabriel,russell,fred,gilbert,bobby,clifton,corey,jessie,derek,ronnie,lonnie,barry,reginald,marcus,clifford,mario,marvin,leon,willie,otis,clifton,samuel,phillip"

    tables["l33t"] = "p4ssw0rd,4dm1n,r00t,s3cur3,h4cker,t3st,l0g1n,w3lc0me,m4st3r,s3cr3t,acc3ss,n3tw0rk,s3rv3r,f1r3wall,3xpl01t,h4x0r,0wn3d,pwn3d,r00t3d,sh3ll,b4ckd00r,tr0j4n,v1rus,w0rm,b0tnet,ph1sh,sp00f,sn1ff,br1ng,cr4ck,h4sh,s4lt,cyph3r,encr1pt,d3crypt,byp4ss,3sc4pe,1nj3ct,scr1pt,p4yl04d,3xpl01t,vuln,p4tch,z3r0d4y,m4lw4re,r4nsomw4re,k3ylog,sp1der,cr4wl,sc4n,pr0xy,s0cks,v1rtual,s4ndbox,d3bug,tr4ce,l0g,4ud1t,m0n1tor,4l3rt,r3port,d4shboard,m3tr1c"

    tables["seasons"] = "january,february,march,april,may,june,july,august,september,october,november,december,spring,summer,autumn,winter,monday,tuesday,wednesday,thursday,friday,saturday,sunday,morning,evening,midnight,sunrise,sunset,dawn,dusk,spring2024,summer2024,winter2024,fall2024,spring2023,summer2023,winter2023,fall2023,january2024,february2024,march2024,april2024,may2024,june2024,july2024,august2024,september2024,october2024,november2024,december2024"

    // build combined sample list from all tables
    allSamples = []
    for tableKey in tables.indexes
        for pw in tables[tableKey].split(",")
            if pw.len > order then allSamples.push(pw)
        end for
    end for

    // build markov chains from all samples
    chains = {}
    for sample in allSamples
        for i in range(0, sample.len - order - 1)
            key = sample[i : i + order]
            if not chains.hasIndex(key) then chains[key] = []
            nextChar = sample[i + order]
            if chains[key].indexOf(nextChar) == null then chains[key].push(nextChar)
        end for
    end for

    // collect start configs
    configMap = {}
    for sample in allSamples
        for startPos in range(0, sample.len - order)
            key = sample[startPos : startPos + order]
            configKey = key + "|" + sample.len
            if not configMap.hasIndex(configKey) then
                configMap[configKey] = [key, sample.len]
            end if
        end for
    end for

    passwordSet = {}

    allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    cleanPw = function(pw)
        for i in range(0, pw.len - 1)
            if allowed.indexOf(pw[i]) == null then return ""
        end for
        return pw
    end function

    // seed with all originals
    for tableKey in tables.indexes
        for pw in tables[tableKey].split(",")
            pl = cleanPw(pw.lower)
            if pl != "" then
                passwordSet[pl] = 1
                if pl.len > 0 then passwordSet[pl[:1].upper + pl[1:]] = 1
            end if
        end for
    end for

    // iterative markov branching
    for configKey in configMap.indexes
        config = configMap[configKey]
        startKey = config[0]
        targetLen = config[1]
        if targetLen < minLength then continue
        stack = [[startKey, targetLen]]
        while stack.len > 0
            item = stack.pop
            current = item[0]
            target = item[1]
            if current.len >= target then
                fp = cleanPw(current.lower)
                while fp.len > 0 and (fp[0] == "-")
                    fp = fp[1:]
                end while
                while fp.len > 0 and (fp[-1] == "-")
                    fp = fp[:-1]
                end while
                if fp.len >= minLength then
                    passwordSet[fp] = 1
                    if fp.len > 0 then passwordSet[fp[:1].upper + fp[1:]] = 1
                end if
                continue
            end if
            token = current[current.len - order:]
            if not chains.hasIndex(token) then
                fp = cleanPw(current.lower)
                if fp.len >= minLength then
                    passwordSet[fp] = 1
                    if fp.len > 0 then passwordSet[fp[:1].upper + fp[1:]] = 1
                end if
                continue
            end if
            if current.len >= minLength then
                fp = cleanPw(current.lower)
                if fp != "" then
                    passwordSet[fp] = 1
                    if fp.len > 0 then passwordSet[fp[:1].upper + fp[1:]] = 1
                end if
            end if
            for nextChar in chains[token]
                stack.push([current + nextChar, target])
            end for
        end while
    end for

    return passwordSet.indexes
end function

// -- Rainbow Table ------------------------------------------------
buildRainbowTable = function()
    gco.rt = {}
    print(c.green + "Generating passwords via Markov chain..." + c.ennd)
    passwords = MarkovGenerate()
    print(c.orange + "Hashing " + passwords.len + " passwords..." + c.ennd)
    for pw in passwords
        gco.rt[md5(pw)] = pw
    end for
    // import any .txt or .lst wordlist files from phantom folder
    localComp = myComp
    if not localComp then localComp = get_shell.host_computer
    dir = localComp.File(currentPath)
    loaded = 0
    if dir and dir.is_folder then
        files = dir.get_files
        for f in files
            nl = f.name.lower
            if nl.len >= 4 and (nl[-4:] == ".txt" or nl[-4:] == ".lst") then
                content = f.get_content
                if content then
                    lines = content.split(char(10))
                    for line in lines
                        pw = line.split(" ")[0]
                        if pw != "" then gco.rt[md5(pw)] = pw
                    end for
                    loaded = loaded + 1
                    print(c.grey + "  imported: " + f.name + c.ennd)
                end if
            end if
        end for
    end if
    print(c.green + "Rainbow table ready: " + gco.rt.len + " entries  (" + loaded + " wordlist(s) imported)" + c.ennd)
end function

// -- RTGen - write rainbow table to disk --------------------------
RTGen = function()
    // build full table including wordlists first
    buildRainbowTable()
    print(c.orange + "Writing " + gco.rt.len + " entries to disk..." + c.ennd)
    rtPath = currentPath + "/rt"
    rtDir = myComp.File(rtPath)
    if not rtDir then
        myComp.create_folder(currentPath, "rt")
        rtDir = myComp.File(rtPath)
    end if
    // clear old files first
    oldFiles = rtDir.get_files
    if oldFiles then
        for of in oldFiles
            of.delete
        end for
    end if
    keys = gco.rt.indexes
    total = keys.len
    count = 0
    output = ""
    i = 0
    while i < total
        hash = keys[i]
        output = output + gco.rt[hash] + ":" + hash + char(10)
        if output.len > 159000 or i == total - 1 then
            num = "00" + count
            filename = "rt." + num[-3:] + ".rt"
            myComp.touch(rtPath, filename)
            f = myComp.File(rtPath + "/" + filename)
            if f then
                f.set_content(output)
                count = count + 1
            end if
            output = ""
        end if
        i = i + 1
    end while
    print(c.green + "rtgen: wrote " + count + " file(s) to " + rtPath + c.ennd)
    print(c.green + "rtgen: " + gco.rt.len + " total entries" + c.ennd)
end function

CrackHash = function(hash)
    if not gco.hasIndex("rt") or gco.rt == null then buildRainbowTable
    if gco.rt.hasIndex(hash) then return gco.rt[hash]
    if gco.crypto then return gco.crypto.decipher(hash)
    return null
end function

// -- AutoRoot -----------------------------------------------------
AutoRoot = function(ip, user, pass)
    if typeof(object) != "shell" then
        if not ip then
            print(c.yellow + "<b>autoroot: not holding remote shell" + c.ennd)
            print(c.grey + "  usage: autoroot [ip] [user] [pass]" + c.ennd)
            return
        end if
        print(c.orange + "Connecting to " + ip + " ..." + c.ennd)
        s = myShell.connect_service(ip, 22, user, pass, "ssh")
        if typeof(s) != "shell" then
            print(c.yellow + "<b>autoroot: could not connect to " + ip + c.ennd)
            return
        end if
        globals.object = s
        globals.remotePath = "/"
        print(c.cyan + "shell obtained: " + ip + c.ennd)
    end if
    comp = object.host_computer

    // already root? skip
    if IsRoot(object) then
        print(c.lime + "autoroot: already have root on " + comp.public_ip + c.ennd)
        return
    end if

    // find writable path on target
    writePath = null
    for path in ["/home/guest", "/tmp", "/root"]
        testDir = comp.File(path)
        if testDir and testDir.has_permission("w") then
            writePath = path
            break
        end if
    end for
    if not writePath then
        print(c.yellow + "<b>autoroot: no writable path on target" + c.ennd)
        return
    end if

    // upload ar binary
    arBin = myComp.File(currentPath + "/ar")
    if not arBin then
        print(c.yellow + "<b>autoroot: ar binary not found in " + currentPath + c.ennd)
        print(c.grey + "  build ar.src locally: build ar.src " + currentPath + c.ennd)
        return
    end if
    print(c.orange + "Uploading ar to " + writePath + " ..." + c.ennd)
    myShell.scp(currentPath + "/ar", writePath, object)
    binFile = comp.File(writePath + "/ar")
    if not binFile then
        globals.pipeFailed = true
        print(c.yellow + "<b>autoroot: ar upload failed" + c.ennd)
        return
    end if

    // build clean password list from gco.rt
    if not gco.hasIndex("rt") or gco.rt == null then buildRainbowTable
    allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    passList = []
    for hash in gco.rt.indexes
        pw = gco.rt[hash]
        ok = true
        for i in range(0, pw.len - 1)
            if allowed.indexOf(pw[i]) == null then
                ok = false
                break
            end if
        end for
        if ok then passList.push(pw)
    end for

    print(c.orange + "Running " + passList.len + " passwords against target..." + c.ennd)
    batchSize = 20
    i = 0
    gco.rootShell = null
    while i < passList.len and not gco.rootShell
        batch = passList[i : i + batchSize]
        object.launch(writePath + "/ar", batch.join(" "))
        i = i + batchSize
    end while

    binFile.delete

    if gco.rootShell then
        globals.object = gco.rootShell
        globals.remotePath = "/"
        gco.rootShell = null
        print(c.green + "<b>autoroot: root shell obtained" + c.ennd)
        GETPERMS(globals.object)
    else
        globals.pipeFailed = true
        print(c.yellow + "<b>autoroot: failed" + c.ennd)
    end if
end function

// -- AutorootStack ------------------------------------------------
// Runs autoroot against every shell on the objectStack,
// replacing each entry with a root shell on success.
AutorootStack = function()
    if objectStack.len == 0 then
        print(c.yellow + "<b>autoroot --stack: stack is empty" + c.ennd)
        return
    end if

    shells = []
    indices = []
    i = 0
    while i < objectStack.len
        if typeof(objectStack[i]) == "shell" then
            shells.push(objectStack[i])
            indices.push(i)
        end if
        i = i + 1
    end while

    if shells.len == 0 then
        print(c.yellow + "<b>autoroot --stack: no shell objects on stack" + c.ennd)
        return
    end if

    savedObject = globals.object
    rootCount = 0
    failCount = 0
    print(c.cyan + "<b>autoroot --stack: escalating " + shells.len + " shell(s)..." + c.ennd)
    div

    i = 0
    for sh in shells
        rcomp = sh.host_computer
        print(c.orange + "<b>[" + (i+1) + "/" + shells.len + "] " + rcomp.public_ip + "  lan:" + rcomp.local_ip + c.ennd)
        if IsRoot(sh) then
            print(c.lime + "  already root — planting..." + c.ennd)
            rootCount = rootCount + 1
            srcPath = "/root/InsecureLibs/libhttp.so"
            if myComp.File(srcPath) then
                r1 = myShell.scp(srcPath, "/lib", sh)
                if typeof(r1) != "string" or r1 == "" then
                    print(c.lime + "  [+] planted libhttp.so" + c.ennd)
                end if
            end if
            mxSrc = "/root/metaxploit.so"
            if myComp.File(mxSrc) then
                r2 = myShell.scp(mxSrc, "/lib", sh)
                if typeof(r2) != "string" or r2 == "" then
                    print(c.lime + "  [+] planted metaxploit.so" + c.ennd)
                end if
            end if
            i = i + 1
            continue
        end if
        globals.object = sh
        globals.pipeFailed = false
        AutoRoot(null, null, null)
        if not globals.pipeFailed then
            objectStack[indices[i]] = globals.object
            rootCount = rootCount + 1
            // plant libhttp.so + metaxploit.so now we have root
            srcPath = "/root/InsecureLibs/libhttp.so"
            if myComp.File(srcPath) then
                r1 = myShell.scp(srcPath, "/lib", globals.object)
                if typeof(r1) != "string" or r1 == "" then
                    print(c.lime + "  [+] planted libhttp.so" + c.ennd)
                end if
            end if
            mxSrc = "/root/metaxploit.so"
            if myComp.File(mxSrc) then
                r2 = myShell.scp(mxSrc, "/lib", globals.object)
                if typeof(r2) != "string" or r2 == "" then
                    print(c.lime + "  [+] planted metaxploit.so" + c.ennd)
                end if
            end if
        else
            globals.pipeFailed = false
            failCount = failCount + 1
        end if
        div
        i = i + 1
    end for

    globals.object = savedObject
    globals.pipeFailed = false
    print(c.cyan + "<b>autoroot --stack complete" + c.ennd)
    print(c.grey + "  escalated: " + rootCount + "  failed: " + failCount + c.ennd)
end function

// ── RGrep ────────────────────────────────────────────────────────
// Search file contents recursively for a pattern
RGrep = function(pattern, path, obj)
    comp = null
    if typeof(obj) == "shell" then comp = obj.host_computer
    if typeof(obj) == "computer" then comp = obj
    if not comp then
        print(c.yellow + "<b>rgrep: no target" + c.ennd)
        return null
    end if
    if not path or path == "" then path = "/"
    root = comp.File(path)
    if not root then
        print(c.yellow + "<b>rgrep: path not found: " + path + c.ennd)
        return null
    end if
    matchedLines = []
    queue = []
    if root.is_folder then
        queue = root.get_files + root.get_folders
    else
        queue = [root]
    end if
    while queue.len > 0
        f = queue.pull
        if not f then continue
        if f.is_folder then
            queue = queue + f.get_files + f.get_folders
            continue
        end if
        if not f.has_permission("r") then continue
        content = f.get_content
        if not content or content == "" then continue
        lines = content.split(char(10))
        ln = 1
        for line in lines
            if line.indexOf(pattern) != null then
                print(c.gold + f.path + c.ennd + c.grey + ":" + ln + c.ennd + "  " + line)
                matchedLines.push(line)
            end if
            ln = ln + 1
        end for
    end while
    return matchedLines
end function

// ── RFind ────────────────────────────────────────────────────────
// Find files/folders by name pattern recursively
RFind = function(pattern, path, obj)
    comp = null
    if typeof(obj) == "shell" then comp = obj.host_computer
    if typeof(obj) == "computer" then comp = obj
    if not comp then
        print(c.yellow + "<b>rfind: no target" + c.ennd)
        return 0
    end if
    if not path or path == "" then path = "/"
    root = comp.File(path)
    if not root then
        print(c.yellow + "<b>rfind: path not found: " + path + c.ennd)
        return 0
    end if
    found = 0
    queue = [root]
    while queue.len > 0
        f = queue.pull
        if not f then continue
        if f.name.indexOf(pattern) != null then
            icon = ""
            if f.is_folder then icon = "/"
            print(c.gold + f.path + icon + c.ennd)
            found = found + 1
        end if
        if f.is_folder then
            queue = queue + f.get_files + f.get_folders
        end if
    end while
    return found
end function

// -- Nslookup -------------------------------------------------------
Nslookup = function(params)
    if params.len < 1 then
        print(c.red + "Invalid Address")
        return null
    end if
    result = nslookup(params[0])
    if result == null or result == "" then
        print(c.red + "Lookup failed for " + params[0])
        return null
    end if
    print(c.gold + result)
    return result
end function
